---
// Desktop sidebar+topbar shell for the manager/admin experience — a
// separate shell from AppLayout.astro (mobile-first header+bottom-nav,
// used by every staff-facing page) rather than one layout branching on
// role, since the two shells are structurally different, not just
// re-skinned. middleware.js already restricts every /admin* route to
// admin/manager, so Astro.locals.user here is always one of those.
import '../styles/global.css';
import Icon from '../components/Icon.astro';

interface Props {
  title?: string;
  active?: string;
}
const { title = '&Shawarma — Manage', active = '' } = Astro.props as Props;
const user = Astro.locals.user;

const navItems = [
  { href: '/admin', key: 'manage', label: 'Manage', icon: 'admin' },
  { href: '/admin/schedule', key: 'schedule', label: 'Schedule', icon: 'calendar' },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#dc2626" />
  <title>{title}</title>
</head>
<body>
  <div class="admin-shell">
    <aside class="admin-sidebar">
      <a href="/" class="admin-sidebar-brand">
        <img src="/logo.jpg" alt="&Shawarma" />
        &amp;Shawarma
      </a>
      <nav>
        {navItems.map((item) => (
          <a href={item.href} class={active === item.key ? 'active' : ''}>
            <Icon name={item.icon} size={18} />
            <span>{item.label}</span>
          </a>
        ))}
      </nav>
      <div class="admin-sidebar-footer">
        <div class="admin-sidebar-user">
          <div class="name">{user.display_name}</div>
          <div class="role">{user.role}</div>
        </div>
        <button id="logout-btn" class="btn-secondary" type="button" style="width:100%;justify-content:center;">
          <Icon name="logout" size={14} /> Logout
        </button>
      </div>
    </aside>

    <div class="admin-content">
      <header class="admin-topbar">
        <h1>{title.replace('&Shawarma — ', '')}</h1>
        <a href="/" class="btn-secondary" style="text-decoration:none;">Back to staff view</a>
      </header>
      <main class="admin-page">
        <slot />
      </main>
    </div>
  </div>

  <div class="toast" id="toast"></div>

  <script>
    document.getElementById('logout-btn')?.addEventListener('click', async () => {
      await fetch('/api/auth/logout', { method: 'POST' });
      window.location.href = '/login';
    });

    // Same globals AppLayout.astro exposes — admin.astro's existing
    // script uses these unchanged regardless of which layout renders it.
    window.shawarmaToast = function toast(message) {
      const el = document.getElementById('toast');
      if (!el) return;
      el.textContent = message;
      el.classList.add('show');
      window.clearTimeout(el._t);
      el._t = window.setTimeout(() => el.classList.remove('show'), 3000);
    };

    window.shawarmaApi = async function api(method, url, body) {
      const res = await fetch(url, {
        method,
        headers: body !== undefined ? { 'Content-Type': 'application/json' } : undefined,
        body: body !== undefined ? JSON.stringify(body) : undefined,
      });
      let data = null;
      try { data = await res.json(); } catch { /* no body */ }
      if (!res.ok) {
        return { ok: false, status: res.status, ...(data || {}), error: (data && data.error) || `Request failed (${res.status})` };
      }
      return { ok: true, status: res.status, ...(data || {}) };
    };
  </script>
</body>
</html>
