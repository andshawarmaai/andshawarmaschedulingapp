---
import '../styles/global.css';
import Icon from '../components/Icon.astro';

interface Props {
  title?: string;
  active?: string;
  // The logo image already spells out the name, so the header hides the
  // "&Shawarma" text label by default. Flip this to true on any page (or
  // change the default here) if you want the text label back.
  showBrandText?: boolean;
}
const { title = '&Shawarma — My Shifts', active = '', showBrandText = false } = Astro.props as Props;

// middleware.js already guarantees Astro.locals.user is set for every page
// that reaches this layout (it redirects to /login otherwise), so this is
// never null here.
const user = Astro.locals.user;
const isStaffOrAbove = user.role === 'admin' || user.role === 'manager';

const navItems = [
  { href: '/', key: 'home', label: 'Home', icon: 'home' },
  { href: '/schedule', key: 'schedule', label: 'Schedule', icon: 'calendar' },
  { href: '/shift-swap', key: 'swap', label: 'Swap', icon: 'swap' },
  { href: '/time-off', key: 'timeoff', label: 'Time Off', icon: 'timeoff' },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="theme-color" content="#dc2626" />
  <title>{title}</title>
</head>
<body>
  <header class="site-header">
    <div class="site-header-inner">
      <a href="/" class="brand">
        <img src="/logo.jpg" alt="&Shawarma" />
        {showBrandText && <span>&amp;Shawarma</span>}
      </a>
      <div class="header-actions">
        <span class="user-pill">{user.display_name}<br /><span class="role">{user.role}</span></span>
        <button id="logout-btn" class="btn-logout" type="button"><Icon name="logout" size={14} /> Logout</button>
      </div>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <nav class="bottom-nav">
    {navItems.map((item) => (
      <a href={item.href} class={active === item.key ? 'active' : ''}>
        <Icon name={item.icon} size={20} />
        <span>{item.label}</span>
      </a>
    ))}
    {isStaffOrAbove && (
      <a href="/admin" class={active === 'admin' ? 'active' : ''}>
        <Icon name="admin" size={20} />
        <span>Manage</span>
      </a>
    )}
  </nav>

  <div class="toast" id="toast"></div>

  <script>
    document.getElementById('logout-btn')?.addEventListener('click', async () => {
      await fetch('/api/auth/logout', { method: 'POST' });
      window.location.href = '/login';
    });

    // Shared toast + fetch helpers, exposed globally for page-level scripts.
    window.shawarmaToast = function toast(message) {
      const el = document.getElementById('toast');
      if (!el) return;
      el.textContent = message;
      el.classList.add('show');
      window.clearTimeout(el._t);
      el._t = window.setTimeout(() => el.classList.remove('show'), 3000);
    };

    window.shawarmaApi = async function api(method, url, body) {
      const res = await fetch(url, {
        method,
        headers: body !== undefined ? { 'Content-Type': 'application/json' } : undefined,
        body: body !== undefined ? JSON.stringify(body) : undefined,
      });
      let data = null;
      try { data = await res.json(); } catch { /* no body */ }
      if (!res.ok) {
        return { ok: false, status: res.status, error: (data && data.error) || `Request failed (${res.status})` };
      }
      return { ok: true, status: res.status, ...(data || {}) };
    };
  </script>
</body>
</html>
