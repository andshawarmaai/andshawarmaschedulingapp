---
// Floating chat panel that lets any signed-in user talk to the Hermes
// agent in natural language. Staff get the read-side view ("post my
// Friday shift for swap", "request time off", "when am I working?");
// managers/admins additionally get write-side actions ("schedule Jorge
// Friday 11-7", "approve pending requests"). Mounted globally via
// Layout.astro so it follows the user everywhere. Role gating of every
// actual write is enforced server-side by middleware.js  -  this panel
// just shows/hides affordances and the AI is told the user's role.
//
// Architecture: messages go to POST /api/agent/chat → persisted as
// status='pending'. The agent (Hermes tunnel OR cloud provider) picks
// the message up, acts via the same /api/* routes documented in
// AGENT-TRAINING.md, writes back a paired assistant row. The browser
// opens a single SSE stream at /api/agent/chat/stream and renders
// tokens as they arrive.
interface Props {
  userId: string;
  userRole: string;
  userDisplayName: string;
}
const { userId, userRole, userDisplayName } = Astro.props as Props;
---
<div id="agent-chat-root" class="agent-chat-collapsed">
  <button type="button" id="agent-chat-toggle" class="agent-chat-fab" aria-label="Open Chat Bot" title="Chat Bot">
    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
    <span class="agent-chat-fab-label">Chat Bot</span>
  </button>

  <div id="agent-chat-panel" class="agent-chat-panel" hidden>
    <header class="agent-chat-header">
      <div>
        <strong>Chat Bot</strong>
        <span class="agent-chat-status" id="agent-chat-status">connecting...</span>
      </div>
      <button type="button" id="agent-chat-close" class="agent-chat-close" aria-label="Close">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </header>

    <div id="agent-chat-history" class="agent-chat-history"></div>

    <form id="agent-chat-form" class="agent-chat-form" autocomplete="off">
      <div id="agent-chat-pending-attachments" class="agent-chat-pending"></div>
      <div class="agent-chat-input-row">
        <label for="agent-chat-file" class="agent-chat-attach" aria-label="Attach a photo or document to your message" title="Attach photo / PDF / document (optional)">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>
          <span class="agent-chat-attach-label">Attach</span>
        </label>
        <input type="file" id="agent-chat-file" class="agent-chat-file" accept="image/*,application/pdf,text/*,.doc,.docx,.txt" multiple capture="environment" hidden>
        <textarea id="agent-chat-input" placeholder="" rows="2"></textarea>
        <button type="submit" id="agent-chat-send" class="agent-chat-send">Send</button>
      </div>
    </form>

    <details class="agent-chat-help">
      <summary>What can I ask?</summary>
      <ul id="agent-chat-help-list">
        <li><b>When am I working?</b>  -  "what's my schedule this week?"</li>
        <li><b>Request time off</b>  -  "I need next Friday off"</li>
        <li><b>Submit availability</b>  -  "I'm free Mon-Wed next week 9-5"</li>
        <li><b>Post a shift for swap</b>  -  "put my Saturday shift up for swap"</li>
        <li><b>Volunteer for a swap</b>  -  "I'll take Bhanu's Sunday shift"</li>
      </ul>
      <p class="agent-chat-help-foot">Hermes acts as you  -  it can only do what your role allows, and approving requests stays human-only.</p>
    </details>
  </div>
</div>

<script is:inline define:vars={{ userId, userRole, userDisplayName }}>
(function () {
  const root = document.getElementById('agent-chat-root');
  if (!root) return;
  // Add role-specific help items so managers see schedule-builder actions,
  // staff sees their own request actions. Server enforces role on every
  // endpoint  -  this just makes the panel's suggestions match what the
  // user can actually do.
  const helpList = document.getElementById('agent-chat-help-list');
  if (helpList && (userRole === 'admin' || userRole === 'manager')) {
    const extras = [
      ['<li><b>Add/move/delete a shift</b>  -  "schedule Jorge Friday 11-7pm"</li>'],
      ['<li><b>Edit shift templates</b>  -  "make Mid AM require 4 people"</li>'],
      ['<li><b>Day caps</b>  -  "cap Friday lunch at 2 people"</li>'],
      ['<li><b>Bulk operations</b>  -  paste a CSV or describe a whole week</li>'],
    ];
    for (const [html] of extras) helpList.insertAdjacentHTML('beforeend', html);
  }
  const fab = document.getElementById('agent-chat-toggle');
  const panel = document.getElementById('agent-chat-panel');
  const closeBtn = document.getElementById('agent-chat-close');
  const history = document.getElementById('agent-chat-history');
  const form = document.getElementById('agent-chat-form');
  const input = document.getElementById('agent-chat-input');
  const sendBtn = document.getElementById('agent-chat-send');
  const status = document.getElementById('agent-chat-status');

  let isOpen = false;
  let sse = null;
  let currentAssistantId = null;
  const rendered = {}; // message id -> element
  const pendingAttachments = []; // [{ id, filename, mime_type, byte_size, url }]  -  uploaded but message not yet sent

  function open() {
    isOpen = true;
    root.classList.add('agent-chat-open');
    root.classList.remove('agent-chat-collapsed');
    panel.hidden = false;
    input.focus();
    ensureLoaded();
    connectSSE();
  }
  function close() {
    isOpen = false;
    root.classList.remove('agent-chat-open');
    root.classList.add('agent-chat-collapsed');
    panel.hidden = true;
  }
  fab.addEventListener('click', () => { isOpen ? close() : open(); });
  closeBtn.addEventListener('click', close);

  // ─── Attachments: file picker, drag-drop, upload-before-send ─────────────

  const fileInput = document.getElementById('agent-chat-file');
  const pendingEl = document.getElementById('agent-chat-pending-attachments');
  const historyEl = document.getElementById('agent-chat-history');

  // Clicking the visible "Attach" label triggers the hidden file input via
  // the for= attribute, so no JS click handler is needed here. (Leaving
  // the legacy attachBtn reference would error since the button is gone.)

  // Desktop: drag a file into the chat panel to attach. Mobile has no
  // drag events so this is just a bonus, but it's the standard expected
  // behavior on a desktop.
  ['dragenter', 'dragover'].forEach((evt) => {
    panel.addEventListener(evt, (e) => {
      e.preventDefault();
      e.stopPropagation();
      panel.classList.add('agent-chat-dragover');
    });
  });
  ['dragleave', 'drop'].forEach((evt) => {
    panel.addEventListener(evt, (e) => {
      e.preventDefault();
      e.stopPropagation();
      panel.classList.remove('agent-chat-dragover');
    });
  });
  panel.addEventListener('drop', (e) => {
    const files = e.dataTransfer && e.dataTransfer.files;
    if (files && files.length) uploadFiles(Array.from(files));
  });

  // File-picker path (mobile camera via capture="environment", desktop via
  // any file type from the accept list).
  fileInput.addEventListener('change', () => {
    if (fileInput.files && fileInput.files.length) {
      uploadFiles(Array.from(fileInput.files));
      fileInput.value = ''; // allow re-selecting the same file later
    }
  });

  async function uploadFiles(files) {
    for (const file of files) {
      const slot = renderPendingPlaceholder(file);
      try {
        const fd = new FormData();
        fd.append('file', file);
        const r = await fetch('/api/agent/chat/upload', {
          method: 'POST',
          credentials: 'same-origin',
          body: fd,
        });
        if (!r.ok) {
          const err = await r.json().catch(() => ({}));
          slot.replaceWith(pendingChip(file.name, (err.error || r.status), true));
          continue;
        }
        const data = await r.json();
        // Replace placeholder with a real chip
        const realChip = pendingChip(file.name, `${prettyBytes(file.size)}`, false, () => {
          // Remove from pending
          const i = pendingAttachments.findIndex((a) => a.id === data.attachment.id);
          if (i >= 0) pendingAttachments.splice(i, 1);
          realChip.remove();
        });
        slot.replaceWith(realChip);
        pendingAttachments.push(data.attachment);
      } catch (err) {
        slot.replaceWith(pendingChip(file.name, 'upload failed', true));
        console.error(err);
      }
    }
  }

  // ─── Inline SVG icons (no emoji  -  consistent rendering everywhere) ──────
  // All SVGs share viewBox=0 0 24 24, currentColor stroke, sized via CSS.
  // Scope: photos + PDFs + text documents only. Audio/video are not part
  // of the scheduling app's chat use case, so no icons for them.
  const SVG = {
    file: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>',
    image: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>',
    pdf: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><text x="7" y="18" font-size="6" fill="currentColor" stroke="none" font-weight="bold">PDF</text></svg>',
    doc: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="16" y2="17"/></svg>',
    text: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" y1="6" x2="20" y2="6"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="18" x2="14" y2="18"/></svg>',
    alert: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>',
    close: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>',
    check: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>',
  };

  // Map MIME type → SVG icon. Falls back to generic file icon.
  function fileIcon(mime) {
    if (!mime) return SVG.file;
    if (mime.startsWith('image/')) return SVG.image;
    if (mime === 'application/pdf') return SVG.pdf;
    if (mime.startsWith('text/')) return SVG.text;
    if (mime.includes('word') || mime.includes('document') || mime === 'application/msword') return SVG.doc;
    return SVG.file;
  }

  function pendingChip(name, sub, isError = false, onRemove = null) {
    const el = document.createElement('div');
    el.className = 'agent-chat-pending-chip' + (isError ? ' agent-chat-pending-chip-err' : '');
    el.innerHTML = `<span class="agent-chat-pending-icon">${isError ? SVG.alert : SVG.file}</span><span class="agent-chat-pending-name">${escapeHtml(name)}</span><span class="agent-chat-pending-sub">${escapeHtml(sub)}</span>`;
    if (onRemove) {
      const x = document.createElement('button');
      x.type = 'button';
      x.setAttribute('aria-label', 'Remove attachment');
      x.innerHTML = SVG.close;
      x.className = 'agent-chat-pending-x';
      x.title = 'Remove';
      x.addEventListener('click', onRemove);
      el.appendChild(x);
    }
    return el;
  }

  function renderPendingPlaceholder(file) {
    const slot = document.createElement('div');
    slot.className = 'agent-chat-pending-chip agent-chat-pending-uploading';
    slot.innerHTML = `<span class="agent-chat-pending-icon">${SVG.file}</span><span class="agent-chat-pending-name">${escapeHtml(file.name)}</span><span class="agent-chat-pending-sub">uploading ${escapeHtml(prettyBytes(file.size))}...</span>`;
    pendingEl.appendChild(slot);
    return slot;
  }

  // ─── History load ────────────────────────────────────────────────────────

  async function ensureLoaded() {
    try {
      const r = await fetch('/api/agent/chat', { credentials: 'same-origin' });
      if (!r.ok) throw new Error('Failed to load chat history');
      const data = await r.json();
      history.innerHTML = '';
      rendered.currentAssistantId = null;
      for (const m of (data.history || [])) render(m, data.attachments || {});
      // Render action pills under each assistant message
      for (const [msgId, acts] of Object.entries(data.actions || {})) {
        if (acts && acts.length) renderActions(msgId, acts);
      }
      scrollToBottom();
    } catch (e) {
      status.textContent = 'history load failed';
      console.error(e);
    }
  }

  function render(m, attachmentsByMessage) {
    if (rendered[m.id]) {
      // Update in-place (used for streaming tokens)
      if (m.role === 'assistant') {
        const body = rendered[m.id].querySelector('.agent-chat-text');
        if (body) body.textContent = m.content || '';
        const dot = rendered[m.id].querySelector('.agent-chat-dot');
        if (dot) dot.dataset.status = m.status;
      }
      return;
    }
    const wrap = document.createElement('div');
    wrap.className = 'agent-chat-msg agent-chat-msg-' + m.role;
    wrap.dataset.id = m.id;

    const who = document.createElement('div');
    who.className = 'agent-chat-who';
    who.textContent = m.role === 'user' ? 'You' : 'Hermes';
    if (m.role === 'assistant') {
      const dot = document.createElement('span');
      dot.className = 'agent-chat-dot';
      dot.dataset.status = m.status;
      who.appendChild(dot);
    }
    wrap.appendChild(who);

    // Attachments  -  render images as inline thumbnails, everything else
    // as a downloadable file chip. Pulled from the message-id-keyed map
    // returned by GET /api/agent/chat (one batch fetch).
    const atts = (attachmentsByMessage && attachmentsByMessage[m.id]) || [];
    if (atts.length) {
      const attEl = document.createElement('div');
      attEl.className = 'agent-chat-attachments';
      for (const a of atts) {
        if ((a.mime_type || '').startsWith('image/')) {
          const img = document.createElement('img');
          img.src = a.url;
          img.alt = a.filename;
          img.className = 'agent-chat-thumb';
          img.loading = 'lazy';
          // Click → open full size in new tab
          img.addEventListener('click', () => window.open(a.url, '_blank'));
          attEl.appendChild(img);
        } else {
          const chip = document.createElement('a');
          chip.href = a.url;
          chip.target = '_blank';
          chip.rel = 'noopener';
          chip.className = 'agent-chat-file-chip';
          chip.innerHTML = `<span class="agent-chat-file-icon">${fileIcon(a.mime_type)}</span><span>${escapeHtml(a.filename)}</span><span class="agent-chat-file-sub">${escapeHtml(prettyBytes(a.byte_size))}</span>`;
          attEl.appendChild(chip);
        }
      }
      wrap.appendChild(attEl);
    }

    if (m.content || m.status === 'pending') {
      const body = document.createElement('div');
      body.className = 'agent-chat-text';
      body.textContent = m.content || (m.status === 'pending' ? '...' : '');
      wrap.appendChild(body);
    }

    const actions = document.createElement('div');
    actions.className = 'agent-chat-actions';
    actions.dataset.forMessage = m.id;
    wrap.appendChild(actions);

    history.appendChild(wrap);
    rendered[m.id] = wrap;
  }

  function prettyBytes(n) {
    if (!Number.isFinite(n)) return '';
    if (n < 1024) return `${n} B`;
    if (n < 1024 * 1024) return `${(n / 1024).toFixed(1)} KB`;
    return `${(n / 1024 / 1024).toFixed(1)} MB`;
  }

  function escapeHtml(s) {
    return String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  }

  function renderActions(messageId, acts) {
    const slot = rendered[messageId] && rendered[messageId].querySelector('.agent-chat-actions');
    if (!slot) return;
    slot.innerHTML = '';
    for (const a of acts) {
      const pill = document.createElement('span');
      pill.className = 'agent-chat-pill';
      const ok = a.response_status && a.response_status >= 200 && a.response_status < 300;
      pill.classList.add(ok ? 'agent-chat-pill-ok' : 'agent-chat-pill-err');
      pill.innerHTML = `<span class="agent-chat-pill-icon">${ok ? SVG.check : SVG.alert}</span><span>${escapeHtml(a.summary)}</span>`;
      pill.title = a.method + ' ' + a.endpoint + '\n' + (a.response_status || '?') + '  -  ' + (a.summary || '');
      slot.appendChild(pill);
    }
  }

  // Only auto-scroll if the user is already near the bottom (within 80px).
  // If they've scrolled up to read history, leave their scroll position
  // alone — otherwise it jumps around while they're trying to read.
  function scrollToBottom() {
    const distanceFromBottom = history.scrollHeight - history.scrollTop - history.clientHeight;
    if (distanceFromBottom < 80) {
      history.scrollTop = history.scrollHeight;
    }
  }

  // Force-scroll regardless (used after the user clicks Send — we just
  // appended a message so they obviously want to follow it).
  function scrollToBottomForce() {
    history.scrollTop = history.scrollHeight;
  }

  // === THINKING INDICATOR ===
  // A small "Chat Bot is thinking…" bubble shown right after the user
  // hits Send, removed as soon as the assistant's bubble appears (via
  // SSE 'new' or 'status'). Shows a moving gradient sweep across the
  // text (matches the Hermes desktop arc-border style: multi-stop
  // linear-gradient on background-clip:text with background-position
  // animated 0%→100% via @keyframes gradient-sweep) so the user can
  // see the bot is actively working, not stuck. Also flips the bottom
  // status pill to "thinking…" — otherwise it sits at "connected"
  // forever after the first reply and there's no signal that a new
  // turn has started (the previous bug per user report). The label is
  // explicit ("Warming up…" for the first ~2s, then "Thinking…" once the
  // round-trip is in flight) plus an elapsed-second counter, so the user
  // can see the bot is working even when MiniMax-M3 takes 10-15s.
  let thinkingEl = null;
  let thinkingTimer = null;
  let thinkingStartedAt = 0;
  function showThinking(initial = 'Warming up…') {
    if (thinkingEl) return;
    thinkingStartedAt = Date.now();
    thinkingEl = document.createElement('div');
    thinkingEl.className = 'agent-chat-msg agent-chat-msg-assistant agent-chat-thinking';
    thinkingEl.id = 'agent-chat-thinking';
    const who = document.createElement('div');
    who.className = 'agent-chat-who';
    who.textContent = 'Chat Bot';
    const body = document.createElement('div');
    body.className = 'agent-chat-text agent-chat-thinking-text';
    body.textContent = initial;
    const elapsed = document.createElement('div');
    elapsed.className = 'agent-chat-thinking-elapsed';
    elapsed.textContent = '';
    thinkingEl.appendChild(who);
    thinkingEl.appendChild(body);
    thinkingEl.appendChild(elapsed);
    history.appendChild(thinkingEl);
    // Flip the bottom status pill so the connection state reflects
    // current work, not the last completed turn.
    status.textContent = initial.toLowerCase();
    scrollToBottomForce();
    // Update the elapsed counter every 250ms so the user sees real
    // progress. Stage progression (with gradient sweep on each label):
    //   0–2s   "Warming up…"  → initial connection / SSE setup
    //   2–6s   "Thinking…"    → bot is reasoning
    //   6s+    "Working…"     → bot is past reasoning, actions are firing
    //   15s+   "Still working…" → long action queue (12+ deletes)
    thinkingTimer = setInterval(() => {
      if (!thinkingEl) return;
      const sec = (Date.now() - thinkingStartedAt) / 1000;
      const cur = body.textContent;
      let next = cur;
      if (sec >= 15 && cur === 'Working…') next = 'Still working…';
      else if (sec >= 6 && cur === 'Thinking…') next = 'Working…';
      else if (sec >= 2 && cur === 'Warming up…') next = 'Thinking…';
      if (next !== cur) {
        body.textContent = next;
        status.textContent = next.toLowerCase();
      }
      elapsed.textContent = `${sec.toFixed(1)}s`;
    }, 250);
  }
  // updateThinkingLabel lets the orchestrator push a specific stage label
  // when the assistant message lands but actions are still firing (e.g.
  // for the multi-action 'delete all 12 shifts' case the orchestrator
  // keeps the assistant bubble status='streaming' until every DELETE
  // round-trip returns). Hooked from the SSE 'status' event below.
  function updateThinkingLabel(label) {
    if (!thinkingEl) return;
    const body = thinkingEl.querySelector('.agent-chat-thinking-text');
    if (body && body.textContent !== label) {
      body.textContent = label;
      status.textContent = label.toLowerCase();
    }
  }
  function hideThinking() {
    if (thinkingTimer) { clearInterval(thinkingTimer); thinkingTimer = null; }
    if (thinkingEl && thinkingEl.parentNode) thinkingEl.parentNode.removeChild(thinkingEl);
    thinkingEl = null;
  }

  function connectSSE() {
    if (sse) try { sse.close(); } catch (_) {}
    status.textContent = 'connecting...';
    sse = new EventSource('/api/agent/chat/stream', { withCredentials: true });
        sse.addEventListener('hello', () => { status.textContent = 'connected'; });
    sse.addEventListener('new', async (e) => {
      // The 'new' event arrives when the SSE detects a fresh assistant
      // message in the DB. Fetch the full message and render its
      // bubble — without this, the 'status' and 'token' updates
      // have no element to write to and the reply never appears.
      hideThinking();
      const data = JSON.parse(e.data);
      if (rendered[data.id]) return;
      const r = await fetch('/api/agent/chat', { credentials: 'same-origin' });
      if (!r.ok) return;
      const history = (await r.json()).history || [];
      const m = history.find((x) => x.id === data.id);
      if (m) render(m, {});
    });
    sse.addEventListener('status', (e) => {
      const data = JSON.parse(e.data);
      const el = rendered[data.id];
      if (el) {
        const dot = el.querySelector('.agent-chat-dot');
        if (dot) dot.dataset.status = data.status;
      }
      if (data.status === 'streaming') status.textContent = 'typing...';
      if (data.status === 'complete') status.textContent = 'connected';
      if (data.status === 'error') status.textContent = 'error';
    });
    sse.addEventListener('token', (e) => {
      const data = JSON.parse(e.data);
      const el = rendered[data.id];
      if (!el) return;
      const body = el.querySelector('.agent-chat-text');
      if (body) body.textContent = data.content || '';
      scrollToBottom();
    });
    sse.addEventListener('done', (e) => {
      const data = JSON.parse(e.data);
      if (data.actions && data.actions.length) renderActions(data.id, data.actions);
      scrollToBottom();
    });
    sse.addEventListener('error', () => { status.textContent = 'reconnecting...'; });
    sse.onerror = () => {
      // Browser auto-reconnects EventSource on close
    };
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const text = input.value.trim();
    const hasAttachments = pendingAttachments.length > 0;
    if (!text && !hasAttachments) return;
    sendBtn.disabled = true;
    try {
      // Send as multipart when there are attachments (so we can include
      // attachment_ids as form fields cleanly); otherwise plain JSON like
      // before. The server accepts both.
      let r;
      if (hasAttachments) {
        const fd = new FormData();
        fd.append('content', text);
        for (const a of pendingAttachments) fd.append('attachment_ids', a.id);
        r = await fetch('/api/agent/chat', {
          method: 'POST',
          credentials: 'same-origin',
          body: fd,
        });
      } else {
        r = await fetch('/api/agent/chat', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ content: text }),
        });
      }
      if (!r.ok) {
        const err = await r.json().catch(() => ({}));
        alert('Failed to send: ' + (err.error || r.status));
        return;
      }
      const data = await r.json();
      input.value = '';
      pendingAttachments.length = 0;
      pendingEl.innerHTML = '';
      // Render the user message immediately; SSE will pick up the assistant reply
      render(data.message, { [data.message.id]: [] });
      // Show the "Chat Bot is thinking…" indicator immediately so the
      // user knows the assistant is working while the SSE stream waits
      // for the reply. Removed as soon as the assistant bubble appears.
      showThinking('Warming up…');
      // Force-scroll after the user hits Send — they just sent a message,
      // they obviously want to follow it down.
      scrollToBottomForce();
      // Optimistically render any pending attachments under this message
      // until the SSE-driven history refresh replaces it with the
      // server-side list.
      const msgEl = rendered[data.message.id];
      if (msgEl) {
        const attEl = document.createElement('div');
        attEl.className = 'agent-chat-attachments';
        for (const a of (pendingAttachments || [])) {
          if ((a.mime_type || '').startsWith('image/')) {
            const img = document.createElement('img');
            img.src = a.url;
            img.alt = a.filename;
            img.className = 'agent-chat-thumb';
            attEl.appendChild(img);
          } else {
            const chip = document.createElement('a');
            chip.href = a.url;
            chip.target = '_blank';
            chip.rel = 'noopener';
            chip.className = 'agent-chat-file-chip';
            chip.innerHTML = `<span>${fileIcon(a.mime_type)}</span><span>${escapeHtml(a.filename)}</span>`;
            attEl.appendChild(chip);
          }
        }
        if (attEl.children.length) {
          const who = msgEl.querySelector('.agent-chat-who');
          if (who) msgEl.insertBefore(attEl, who.nextSibling);
        }
      }
      scrollToBottom();
    } finally {
      sendBtn.disabled = false;
      input.focus();
      // If the request failed before the SSE 'new' fired (network error,
      // 500 response, etc.), the thinking indicator would otherwise stay
      // forever. The submit handler's catch block already shows an alert;
      // here we just make sure the spinner is gone.
      hideThinking();
    }
  });

  // Submit on Enter, newline on Shift+Enter
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      form.requestSubmit();
    }
  });
})();
</script>

