---
// Light/dark mode toggle. A single horizontal switch — left half is
// light, right half is dark — so it stays the same width regardless of
// which side is active. Stores the choice in localStorage so it
// survives reloads, writes `data-theme="dark"` on <html>, and ALSO
// swaps the inline --color-* variables between the admin-configured
// light and dark palettes (read from `data-theme-light-vars` /
// `data-theme-dark-vars` written by Layout.astro on every page).
---
<button type="button" class="theme-switch" role="switch" aria-label="Light or dark mode" data-theme-state="light">
  <span class="theme-switch-track" aria-hidden="true">
    <span class="theme-switch-icon theme-switch-icon-sun">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
    </span>
    <span class="theme-switch-icon theme-switch-icon-moon">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
    </span>
    <span class="theme-switch-thumb">
      <span class="theme-switch-thumb-icon theme-switch-thumb-icon-sun">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
      </span>
      <span class="theme-switch-thumb-icon theme-switch-thumb-icon-moon">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      </span>
    </span>
  </span>
</button>

<script is:inline>
  // Apply theme as early as possible — set both the data-theme attribute
  // AND swap the inline CSS variables so dark mode uses the admin-
  // configured dark palette, not the CSS file's hardcoded fallback.
  (function () {
    try {
      var stored = localStorage.getItem('shawarma_theme');
      var sysDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
      var theme = stored || (sysDark ? 'dark' : 'light');
      var html = document.documentElement;
      html.setAttribute('data-theme', theme);
      var darkVars = html.getAttribute('data-theme-dark-vars');
      if (theme === 'dark' && darkVars) html.setAttribute('style', darkVars);
    } catch (_) { /* localStorage blocked — fall back to light */ }
  })();
</script>

<script>
  function paintTheme(theme) {
    var html = document.documentElement;
    html.setAttribute('data-theme', theme);
    var lightVars = html.getAttribute('data-theme-light-vars');
    var darkVars = html.getAttribute('data-theme-dark-vars');
    if (theme === 'dark' && darkVars) {
      html.setAttribute('style', darkVars);
    } else if (lightVars) {
      html.setAttribute('style', lightVars);
    }
    document.querySelectorAll('.theme-switch').forEach((sw) => {
      sw.setAttribute('data-theme-state', theme);
      sw.setAttribute('aria-checked', theme === 'dark' ? 'true' : 'false');
    });
  }
  paintTheme(document.documentElement.getAttribute('data-theme') || 'light');
  document.querySelectorAll('.theme-switch').forEach((sw) => {
    sw.addEventListener('click', () => {
      var current = sw.getAttribute('data-theme-state') || 'light';
      var next = current === 'light' ? 'dark' : 'light';
      try { localStorage.setItem('shawarma_theme', next); } catch (_) {}
      paintTheme(next);
    });
  });
</script>
