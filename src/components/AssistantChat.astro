---
// Floating schedule assistant (same design as Chef Nerd AI's): traffic-light
// window you can drag anywhere, collapse or expand; replies from the
// restaurant's own Hermes (relay, no tunnel) or its cloud AI key; changes it
// makes show as small confirmations; files it makes are downloadable.
// Engine: src/lib/assistant.js. API: /api/agent/chat.
interface Props { name?: string | null; avatar?: string | null }
const { name, avatar } = Astro.props;
const title = name || 'Schedule Assistant';
const avatarSrc = avatar || '/logo.jpg';
---
<div class="asst" data-title={title}>
  <template id="asst-avatar-tpl">
    <span class="asst-avatar" aria-hidden="true"><img src={avatarSrc} alt="" /></span>
  </template>

  <button type="button" class="asst-fab" aria-expanded="false" aria-controls="asst-panel">
    <span class="asst-avatar asst-avatar-sm" aria-hidden="true"><img src={avatarSrc} alt="" /></span>
    <span>{title}</span>
  </button>

  <section id="asst-panel" class="asst-panel" hidden aria-label={title}>
    <header class="asst-head" title="Drag to move">
      <div class="asst-lights">
        <button type="button" class="asst-light asst-light-close" data-action="close" aria-label="Close"><svg viewBox="0 0 12 12" aria-hidden="true"><path d="M3.5 3.5l5 5M8.5 3.5l-5 5"/></svg></button>
        <button type="button" class="asst-light asst-light-min" data-action="collapse" aria-label="Collapse"><svg viewBox="0 0 12 12" aria-hidden="true"><path d="M3 6h6"/></svg></button>
        <button type="button" class="asst-light asst-light-max" data-action="expand" aria-label="Expand"><svg viewBox="0 0 12 12" aria-hidden="true"><path d="M3.5 8.5l5-5M5 3.5h3.5V7"/></svg></button>
      </div>
      <span class="asst-avatar" aria-hidden="true"><img src={avatarSrc} alt="" /></span>
      <div class="asst-head-text">
        <strong>{title}</strong>
        <span class="asst-sub" id="asst-sub"><span class="asst-dot"></span><span class="asst-status">Online</span></span>
      </div>
      <button type="button" class="asst-clear" title="Clear this conversation">Clear</button>
    </header>

    <div class="asst-log" aria-live="polite"></div>

    <form class="asst-form">
      <div class="asst-files" hidden></div>
      <div class="asst-composer">
        <label class="asst-icon-btn" title="Attach files">
          <input type="file" name="files" multiple hidden />
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l8.57-8.57A4 4 0 1 1 18 8.84l-8.59 8.57a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>
          <span class="asst-sr">Attach files</span>
        </label>
        <textarea name="message" rows="1" placeholder={`Message ${title}`}></textarea>
        <button type="submit" class="asst-send" aria-label="Send">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
        </button>
      </div>
      <p class="asst-hint">Enter to send · Shift + Enter for a new line</p>
    </form>
  </section>
</div>

<style is:global>
  /* Global (not Astro-scoped): messages are created by script. Every
     selector is prefixed with .asst so nothing leaks into the app. */
  .asst {
    --asst-font: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    --asst-user-bg: #f1f1f3;
    --asst-user-ink: #1f1f23;
    --asst-metal-base: #55585f;
    --asst-metal-shine: #c9ccd2;
    --asst-danger: var(--color-danger, #dc2626);
    font-family: var(--asst-font);
  }
  [data-theme="dark"] .asst { --asst-user-bg: #26262a; --asst-user-ink: #f2f2f4; --asst-metal-base: #8d9097; --asst-metal-shine: #ffffff; }

  .asst .asst-avatar { width: 30px; height: 30px; flex: none; border-radius: 50%; overflow: hidden; background: #fff; border: 1px solid var(--color-border); display: inline-flex; align-items: center; justify-content: center; }
  .asst .asst-avatar img { width: 100%; height: 100%; object-fit: cover; }
  .asst .asst-avatar-sm { width: 26px; height: 26px; }

  .asst .asst-fab { position: fixed; right: 1.25rem; bottom: 1.25rem; z-index: 60; display: flex; align-items: center; gap: 0.55rem; padding: 0.4rem 1rem 0.4rem 0.4rem; border-radius: 999px; border: 1px solid var(--color-border); background: var(--color-bg); color: var(--color-ink); font: 600 0.9rem/1 var(--asst-font); cursor: pointer; box-shadow: 0 8px 24px rgba(0, 0, 0, 0.14); }
  .asst .asst-fab[hidden] { display: none; }

  .asst .asst-panel { position: fixed; right: 1.25rem; bottom: 1.25rem; z-index: 61; width: min(420px, calc(100vw - 2rem)); height: min(620px, calc(100vh - 2rem)); display: flex; flex-direction: column; background: var(--color-bg); color: var(--color-ink); border: 1px solid var(--color-border); border-radius: 18px; box-shadow: 0 18px 48px rgba(0, 0, 0, 0.22); overflow: hidden; transition: width 0.18s ease, height 0.18s ease; }
  .asst .asst-panel[hidden] { display: none; }
  .asst .asst-panel.expanded { width: min(760px, calc(100vw - 2rem)); height: min(86vh, calc(100vh - 2rem)); }
  .asst .asst-panel.collapsed { height: auto; }
  .asst .asst-panel.collapsed .asst-log, .asst .asst-panel.collapsed .asst-form { display: none; }
  .asst .asst-panel.dragging { transition: none; user-select: none; }

  .asst .asst-head { display: flex; align-items: center; gap: 0.7rem; padding: 0.8rem 1rem; border-bottom: 1px solid var(--color-border-soft, var(--color-border)); cursor: grab; user-select: none; touch-action: none; }
  .asst .asst-panel.collapsed .asst-head { border-bottom: none; }
  .asst .asst-panel.dragging .asst-head { cursor: grabbing; }
  .asst .asst-head .asst-avatar { width: 34px; height: 34px; }
  .asst .asst-head-text { display: flex; flex-direction: column; flex: 1; min-width: 0; }
  .asst .asst-head-text strong { font-size: 0.975rem; letter-spacing: -0.01em; }
  .asst .asst-sub { font-size: 0.78rem; color: var(--color-muted); }
  .asst .asst-clear { background: none; border: none; color: var(--color-muted); font: 0.78rem var(--asst-font); cursor: pointer; padding: 0.25rem 0.4rem; border-radius: 6px; }
  .asst .asst-clear:hover { background: var(--color-bg-soft); color: var(--color-ink); }

  .asst .asst-lights { display: flex; gap: 0.45rem; margin-right: 0.2rem; }
  .asst .asst-light { width: 13px; height: 13px; border-radius: 50%; border: 0.5px solid rgba(0, 0, 0, 0.18); padding: 0; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; }
  .asst .asst-light svg { width: 8px; height: 8px; fill: none; stroke: rgba(0, 0, 0, 0.55); stroke-width: 1.6; stroke-linecap: round; opacity: 0; }
  .asst .asst-lights:hover .asst-light svg, .asst .asst-light:focus-visible svg { opacity: 1; }
  .asst .asst-light-close { background: #ff5f57; }
  .asst .asst-light-min { background: #febc2e; }
  .asst .asst-light-max { background: #28c840; }

  .asst .asst-log { flex: 1; overflow-y: auto; padding: 1.1rem 1rem; display: flex; flex-direction: column; gap: 1.1rem; font-size: 0.9375rem; line-height: 1.6; }
  .asst .asst-empty { color: var(--color-muted); font-size: 0.9rem; text-align: center; margin: auto 1.5rem; line-height: 1.55; }

  .asst .asst-msg.assistant { display: grid; grid-template-columns: 30px 1fr; column-gap: 0.65rem; align-items: start; }
  .asst .asst-msg.assistant .asst-avatar { grid-row: 1 / span 4; }
  .asst .asst-msg.assistant > :not(.asst-avatar) { grid-column: 2; }
  .asst .asst-name { font-size: 0.8rem; font-weight: 650; line-height: 30px; }
  .asst .asst-text { white-space: pre-wrap; word-wrap: break-word; }
  .asst .asst-msg.assistant .asst-text { margin-top: -0.15rem; }
  .asst .asst-msg.user { align-self: flex-end; max-width: 85%; display: flex; flex-direction: column; align-items: flex-end; gap: 0.25rem; }
  .asst .asst-msg.user .asst-name { line-height: 1.2; color: var(--color-muted); }
  .asst .asst-msg.user .asst-text { background: var(--asst-user-bg); color: var(--asst-user-ink); padding: 0.6rem 0.95rem; border-radius: 18px; }
  .asst .asst-rich { white-space: normal; }
  .asst .asst-rich p { margin: 0 0 0.55rem; }
  .asst .asst-rich p:last-child, .asst .asst-rich ul:last-child { margin-bottom: 0; }
  .asst .asst-rich ul { margin: 0 0 0.55rem; padding-left: 1.15rem; }

  .asst .asst-chips { display: flex; flex-wrap: wrap; gap: 0.3rem; margin-top: 0.35rem; }
  .asst .asst-msg.user .asst-chips { justify-content: flex-end; }
  .asst .asst-chip { font-size: 0.75rem; padding: 0.2rem 0.6rem; border-radius: 999px; border: 1px solid var(--color-border); background: var(--color-bg); color: var(--color-ink-light, var(--color-muted)); text-decoration: none; }
  .asst .asst-chip.ok { border-color: var(--color-success); color: var(--color-success); }
  .asst .asst-chip.bad { border-color: var(--asst-danger); color: var(--asst-danger); }
  .asst .asst-download { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.8125rem; padding: 0.4rem 0.7rem; border-radius: 10px; border: 1px solid var(--color-border); background: var(--color-bg-soft); color: var(--color-ink); text-decoration: none; }

  .asst .asst-thinking { display: inline-block; font-weight: 650; font-size: 0.95rem; background: linear-gradient(100deg, var(--asst-metal-base) 0%, var(--asst-metal-base) 38%, var(--asst-metal-shine) 50%, var(--asst-metal-base) 62%, var(--asst-metal-base) 100%); background-size: 250% 100%; -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; color: transparent; animation: asst-shine 1.6s linear infinite; }
  .asst .asst-thinking-meta { font-size: 0.75rem; color: var(--color-muted); font-variant-numeric: tabular-nums; margin-top: 0.1rem; }
  @keyframes asst-shine { from { background-position: 125% 0; } to { background-position: -25% 0; } }
  @media (prefers-reduced-motion: reduce) { .asst .asst-thinking { animation: none; background: none; -webkit-text-fill-color: currentColor; color: var(--asst-metal-base); } }

  .asst .asst-form { padding: 0.6rem 0.8rem 0.7rem; }
  .asst .asst-form.drag .asst-composer { outline: 2px dashed var(--color-primary); outline-offset: 2px; }
  .asst .asst-composer { display: flex; align-items: flex-end; gap: 0.35rem; padding: 0.35rem 0.4rem 0.35rem 0.35rem; border: 1px solid var(--color-border); border-radius: 22px; background: var(--color-bg); }
  .asst .asst-composer:focus-within { border-color: var(--color-muted); }
  .asst .asst-composer textarea { flex: 1; resize: none; border: none; outline: none; background: transparent; color: var(--color-ink); font: 0.9375rem/1.5 var(--asst-font); padding: 0.45rem 0.25rem; max-height: 140px; }
  .asst .asst-icon-btn { display: inline-flex; align-items: center; justify-content: center; width: 34px; height: 34px; border-radius: 50%; color: var(--color-muted); cursor: pointer; flex: none; }
  .asst .asst-icon-btn:hover { background: var(--color-bg-soft); color: var(--color-ink); }
  .asst .asst-send { width: 34px; height: 34px; flex: none; border-radius: 50%; border: none; background: var(--color-ink); color: var(--color-bg); cursor: pointer; display: inline-flex; align-items: center; justify-content: center; }
  .asst .asst-send:disabled { opacity: 0.35; cursor: default; }
  .asst .asst-files { font-size: 0.8rem; color: var(--color-muted); padding: 0 0.5rem 0.4rem; }
  .asst .asst-hint { font-size: 0.7rem; color: var(--color-muted); text-align: center; margin: 0.4rem 0 0; }
  .asst .asst-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  /* Left/right conversation: the agent's bubble on the left beside its logo,
     the person's bubble on the right. Text inside bubbles is left-aligned. */
  .asst .asst-msg.assistant { max-width: 88%; align-self: flex-start; }
  .asst .asst-msg.assistant .asst-text { background: var(--color-bg-soft); border: 1px solid var(--color-border-soft, var(--color-border)); padding: 0.6rem 0.95rem; border-radius: 18px; border-top-left-radius: 6px; margin-top: 0; text-align: left; }
  .asst .asst-msg.assistant .asst-name { line-height: 1.2; margin-bottom: 0.25rem; }
  .asst .asst-msg.assistant .asst-avatar { align-self: start; margin-top: 1.1rem; }
  .asst .asst-msg.user .asst-text { border-top-right-radius: 6px; text-align: left; }
  .asst .asst-avatar img { object-fit: contain; padding: 2px; }
  .asst .asst-hint { text-align: left; padding: 0 0.9rem; margin: 0.35rem 0 0; font-size: 0.7rem; color: var(--color-muted); }
  .asst .asst-sub { display: inline-flex; align-items: center; gap: 0.35rem; }
  .asst .asst-dot { width: 7px; height: 7px; border-radius: 50%; background: #22c55e; box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.18); }
  .asst .asst-sub.away .asst-dot { background: #a1a1aa; box-shadow: none; }
</style>

<script>
  const root = document.querySelector<HTMLElement>('.asst');
  if (root) {
    const title = root.dataset.title!;
    const api = '/api/agent/chat';
    const fab = root.querySelector<HTMLButtonElement>('.asst-fab')!;
    const panel = root.querySelector<HTMLElement>('.asst-panel')!;
    const log = root.querySelector<HTMLElement>('.asst-log')!;
    const form = root.querySelector<HTMLFormElement>('.asst-form')!;
    const input = form.querySelector<HTMLInputElement>('input[type=file]')!;
    const fileList = form.querySelector<HTMLElement>('.asst-files')!;
    const textarea = form.querySelector<HTMLTextAreaElement>('textarea')!;
    const sendBtn = form.querySelector<HTMLButtonElement>('.asst-send')!;
    const sub = root.querySelector<HTMLElement>('#asst-sub')!;
    const avatarTpl = root.querySelector<HTMLTemplateElement>('#asst-avatar-tpl')!;
    let picked: File[] = [];
    let pollTimer: number | undefined;
    let tickTimer: number | undefined;
    let mode = 'hermes';

    const el = (tag: string, className: string, text?: string) => {
      const node = document.createElement(tag);
      if (className) node.className = className;
      if (text !== undefined) node.textContent = text;
      return node;
    };
    const avatar = () => avatarTpl.content.firstElementChild!.cloneNode(true) as HTMLElement;

    // '- ' lines become bullets and **text** becomes bold; text nodes only.
    function richText(body: string) {
      const box = el('div', 'asst-text asst-rich');
      let list: HTMLElement | null = null;
      for (const line of body.split('\n')) {
        const bullet = /^\s*[-*•]\s+(.*)$/.exec(line);
        const text = bullet ? bullet[1] : line;
        if (!bullet && !text.trim()) { list = null; continue; }
        const target = el(bullet ? 'li' : 'p', '');
        text.split(/(\*\*[^*]+\*\*)/).forEach((part) => {
          if (/^\*\*[^*]+\*\*$/.test(part)) target.append(el('strong', '', part.slice(2, -2)));
          else if (part) target.append(document.createTextNode(part));
        });
        if (bullet) { if (!list) { list = el('ul', ''); box.append(list); } list.append(target); }
        else { list = null; box.append(target); }
      }
      return box;
    }

    function messageEl(m: any) {
      const wrap = el('div', `asst-msg ${m.role}`);
      const fileLink = (a: any, i: number, cls: string) => {
        const link = el('a', cls) as HTMLAnchorElement;
        link.href = `${api}/files/${encodeURIComponent(m.id)}/${i}`;
        link.setAttribute('download', a.name);
        link.textContent = a.size ? `${a.name} · ${Math.max(1, Math.round(a.size / 1024))} KB` : a.name;
        return link;
      };
      if (m.role === 'assistant') {
        wrap.append(avatar(), el('div', 'asst-name', title));
        if (m.body) wrap.append(richText(m.body));
        const done = (m.actions || []).map((a: any) => el('span', `asst-chip ${a.ok ? 'ok' : 'bad'}`, a.summary));
        const files = (m.attachments || []).map((a: any, i: number) => (a.output ? fileLink(a, i, 'asst-download') : null)).filter(Boolean);
        if (done.length || files.length) { const row = el('div', 'asst-chips'); row.append(...done, ...files); wrap.append(row); }
      } else {
        wrap.append(el('div', 'asst-name', 'You'));
        if (m.body) wrap.append(el('div', 'asst-text', m.body));
        const files = (m.attachments || []).map((a: any, i: number) => (a.b64 === undefined ? fileLink(a, i, 'asst-chip') : el('span', 'asst-chip', a.name)));
        if (files.length) { const row = el('div', 'asst-chips'); row.append(...files); wrap.append(row); }
      }
      return wrap;
    }

    // Metallic "Thinking" with a moving sweep. After a minute in Hermes
    // mode, say plainly that Hermes may not be running.
    function thinkingEl(since: number) {
      const wrap = el('div', 'asst-msg assistant');
      const label = el('span', 'asst-thinking', 'Thinking');
      const meta = el('div', 'asst-thinking-meta', '');
      const body = el('div', 'asst-text');
      body.append(label, meta);
      wrap.append(avatar(), el('div', 'asst-name', title), body);
      const tick = () => {
        const sec = Math.max(0, (Date.now() - since) / 1000);
        const late = mode === 'hermes' && sec >= 60;
        label.textContent = sec < 25 ? 'Thinking' : late ? 'Away, replies soon' : 'Working';
        meta.textContent = late ? "I'll answer here as soon as I'm back online." : `${sec.toFixed(0)}s`;
      };
      tick();
      clearInterval(tickTimer);
      tickTimer = window.setInterval(tick, 1000);
      return wrap;
    }

    // Empty chat: the agent opens the conversation, on the left like any reply.
    function empty(text: string) {
      const wrap = el('div', 'asst-msg assistant');
      wrap.append(avatar(), el('div', 'asst-name', title), el('div', 'asst-text', text));
      log.replaceChildren(wrap);
    }

    async function load() {
      const res = await fetch(api, { credentials: 'same-origin' });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) { empty(data.error || 'Could not load the chat.'); return; }
      mode = data.mode || 'hermes';
      sub.classList.toggle('away', !data.online);
      sub.querySelector('.asst-status')!.textContent = data.online ? 'Online' : 'Away, replies soon';
      clearInterval(tickTimer);
      if (!data.messages.length) { empty(`Hi, I'm your ${title}. Ask me to add, move or swap shifts, check who's working, or handle time off.`); return; }
      log.replaceChildren();
      let waitingSince: number | null = null;
      for (const m of data.messages) {
        log.append(messageEl(m));
        if (m.role === 'user' && m.status === 'pending') waitingSince = new Date(m.created_at).getTime();
      }
      if (waitingSince !== null) log.append(thinkingEl(waitingSince));
      log.scrollTop = log.scrollHeight;
      clearTimeout(pollTimer);
      if (waitingSince !== null && !panel.hidden) pollTimer = window.setTimeout(load, 3000);
    }

    // ---- Window: open / close / collapse / expand / drag ----
    const POS_KEY = 'asst-window-pos';
    function placeAt(left: number, top: number) {
      const rect = panel.getBoundingClientRect();
      panel.style.left = `${Math.min(Math.max(0, left), Math.max(0, window.innerWidth - rect.width))}px`;
      panel.style.top = `${Math.min(Math.max(0, top), Math.max(0, window.innerHeight - 48))}px`;
      panel.style.right = 'auto';
      panel.style.bottom = 'auto';
    }
    function open() {
      panel.hidden = false;
      fab.hidden = true;
      fab.setAttribute('aria-expanded', 'true');
      try {
        const pos = JSON.parse(localStorage.getItem(POS_KEY) || 'null');
        if (pos && Number.isFinite(pos.left) && Number.isFinite(pos.top)) placeAt(pos.left, pos.top);
      } catch { /* storage unavailable */ }
      load();
      textarea.focus();
    }
    function close() {
      panel.hidden = true;
      panel.classList.remove('collapsed', 'expanded');
      fab.hidden = false;
      fab.setAttribute('aria-expanded', 'false');
      clearTimeout(pollTimer);
      clearInterval(tickTimer);
    }
    fab.addEventListener('click', open);
    root.querySelectorAll<HTMLButtonElement>('.asst-light').forEach((btn) => {
      btn.addEventListener('pointerdown', (e) => e.stopPropagation());
      btn.addEventListener('click', () => {
        const action = btn.dataset.action;
        if (action === 'close') { close(); return; }
        if (action === 'collapse') panel.classList.toggle('collapsed');
        if (action === 'expand') { panel.classList.remove('collapsed'); panel.classList.toggle('expanded'); }
        requestAnimationFrame(() => { if (panel.style.left) { const r = panel.getBoundingClientRect(); placeAt(r.left, r.top); } });
      });
    });
    const head = root.querySelector<HTMLElement>('.asst-head')!;
    head.addEventListener('pointerdown', (e) => {
      if (e.button !== 0 || (e.target as HTMLElement).closest('button')) return;
      const start = panel.getBoundingClientRect();
      const dx = e.clientX - start.left;
      const dy = e.clientY - start.top;
      panel.classList.add('dragging');
      head.setPointerCapture(e.pointerId);
      const move = (ev: PointerEvent) => placeAt(ev.clientX - dx, ev.clientY - dy);
      const up = () => {
        panel.classList.remove('dragging');
        head.removeEventListener('pointermove', move);
        head.removeEventListener('pointerup', up);
        const r = panel.getBoundingClientRect();
        try { localStorage.setItem(POS_KEY, JSON.stringify({ left: r.left, top: r.top })); } catch { /* ignore */ }
      };
      head.addEventListener('pointermove', move);
      head.addEventListener('pointerup', up);
    });
    window.addEventListener('resize', () => { if (!panel.hidden && panel.style.left) { const r = panel.getBoundingClientRect(); placeAt(r.left, r.top); } });
    root.querySelector('.asst-clear')!.addEventListener('click', async () => {
      if (!confirm('Clear this conversation?')) return;
      await fetch(api, { method: 'DELETE', credentials: 'same-origin' });
      load();
    });

    // ---- Composer ----
    function showFiles() {
      fileList.hidden = picked.length === 0;
      fileList.textContent = picked.map((f) => f.name).join(', ');
    }
    const toB64 = (file: File) => new Promise<string>((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = () => resolve(String(reader.result).split(',')[1] || '');
      reader.onerror = () => reject(reader.error);
      reader.readAsDataURL(file);
    });
    input.addEventListener('change', () => { picked = [...picked, ...Array.from(input.files || [])]; input.value = ''; showFiles(); });
    form.addEventListener('dragover', (e) => { e.preventDefault(); form.classList.add('drag'); });
    form.addEventListener('dragleave', () => form.classList.remove('drag'));
    form.addEventListener('drop', (e) => { e.preventDefault(); form.classList.remove('drag'); picked = [...picked, ...Array.from(e.dataTransfer?.files || [])]; showFiles(); });
    textarea.addEventListener('input', () => { textarea.style.height = 'auto'; textarea.style.height = `${Math.min(textarea.scrollHeight, 140)}px`; });
    textarea.addEventListener('keydown', (e) => { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); form.requestSubmit(); } });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const message = textarea.value.trim();
      if (!message && !picked.length) return;
      sendBtn.disabled = true;
      const files = picked;
      if (log.querySelector('.asst-empty')) log.replaceChildren();
      log.append(messageEl({ id: '', role: 'user', body: message, attachments: files.map((f) => ({ name: f.name, b64: '' })) }), thinkingEl(Date.now()));
      log.scrollTop = log.scrollHeight;
      picked = []; showFiles(); textarea.value = ''; textarea.style.height = 'auto';
      try {
        const payload = { message, files: await Promise.all(files.map(async (f) => ({ name: f.name, type: f.type || 'application/octet-stream', b64: await toB64(f) }))) };
        const res = await fetch(api, { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
        if (!res.ok) alert((await res.json().catch(() => ({}))).error || 'Could not send.');
      } catch (err) {
        alert((err as Error).message || 'Could not send.');
      }
      sendBtn.disabled = false;
      load();
    });
  }
</script>
