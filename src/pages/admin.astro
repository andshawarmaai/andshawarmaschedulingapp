// === Chat security log ===
    async function loadChatSecurityLog() {
      const el = document.getElementById('chat-security-log');
      if (!el) return;
      el.innerHTML = '<p style="color:var(--color-muted);margin:0.5rem;">Loading…</p>';
      try {
        const r = await fetch('/api/admin/agent-chat/security', { credentials: 'same-origin' });
        if (!r.ok) {
          el.innerHTML = `<p style="color:var(--color-muted);margin:0.5rem;">Failed to load (${r.status}).</p>`;
          return;
        }
        const data = await r.json();
        const events = data.events || [];
        if (events.length === 0) {
          el.innerHTML = '<p style="color:var(--color-muted);margin:0.5rem;">No security events yet — this log will fill up if anyone tries to abuse the chat.</p>';
          return;
        }
        const KIND_LABEL = {
          off_topic_refusal: 'off-topic',
          prompt_injection: 'injection attempt',
          credential_phish: 'credential phish',
          abuse: 'abuse',
        };
        el.innerHTML = events.map((e) => {
          const label = KIND_LABEL[e.kind] || e.kind;
          const when = new Date(e.created_at).toLocaleString();
          const msg = (e.message_excerpt || '').slice(0, 200) || '(empty)';
          const reply = (e.agent_reply || '').slice(0, 200);
          return `<div style="padding:0.5rem 0.25rem;border-bottom:1px solid var(--color-border);">
            <div style="display:flex;gap:0.5rem;align-items:center;flex-wrap:wrap;">
              <span class="badge badge-denied">${escapeHtml(label)}</span>
              <strong>${escapeHtml(e.user_display_name || e.user_id)}</strong>
              <span style="color:var(--color-muted);font-size:0.85rem;">${escapeHtml(when)}</span>
            </div>
            <div style="margin-top:0.25rem;color:var(--color-muted);font-size:0.85rem;"><strong>asked:</strong> ${escapeHtml(msg)}</div>
            ${reply ? `<div style="margin-top:0.25rem;color:var(--color-muted);font-size:0.85rem;"><strong>bot replied:</strong> ${escapeHtml(reply)}</div>` : ''}
          </div>`;
        }).join('');
      } catch (e) {
        el.innerHTML = `<p style="color:var(--color-muted);margin:0.5rem;">Failed to load: ${escapeHtml(String(e.message || e))}</p>`;
      }
    }
