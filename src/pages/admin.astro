    // ─── Theme & branding card ───────────────────────────────────────────────────────
    // One color picker per mode (light + dark). Each picker has a
    // dropdown that names which slot the picker currently controls
    // (brand, body text, page background, etc.) and a native
    // <input type="color"> swatch. The OS color picker IS the histogram
    // slider with R/G/B/HSL fields built in — admins can drag the
    // sat slider, dial in a hue, or type a hex directly.
    //
    // The logo section (preview + upload + clear + URL fallback) still
    // lives above the color card, untouched by this rewrite.
    const themeFields = [
      'primary', 'primary_dark', 'foh', 'boh', 'ink', 'ink_light',
      'bg', 'bg_soft', 'border', 'accent', 'accent_dark',
    ];
    const themeLogoUrl = document.getElementById('theme-logo-url');
    const themeLogoPreview = document.getElementById('theme-logo-preview');
    const themeLogoUpload = document.getElementById('theme-logo-upload');
    const themeLogoUploadBtn = document.getElementById('theme-logo-upload-btn');
    const themeLogoClearBtn = document.getElementById('theme-logo-clear-btn');
    const themeLogoStatus = document.getElementById('theme-logo-status');
    const themeStatus = document.getElementById('theme-status');
    const themeSave = document.getElementById('theme-save');
    const themeReset = document.getElementById('theme-reset');
    const themePickers = {
      light: { select: document.getElementById('theme-light-slot'), input: document.getElementById('theme-light-color'), hex: document.getElementById('theme-light-hex') },
      dark:  { select: document.getElementById('theme-dark-slot'),  input: document.getElementById('theme-dark-color'),  hex: document.getElementById('theme-dark-hex') },
    };
    let themeDefaults = null;
    let themeCurrent = null;
    let suppressPickerInputs = false;

    function setThemeStatus(msg, kind) {
      if (!themeStatus) return;
      themeStatus.textContent = msg;
      themeStatus.style.color = kind === 'error' ? '#dc2626' : kind === 'ok' ? '#16a34a' : '';
    }
    function setLogoStatus(msg, kind) {
      if (!themeLogoStatus) return;
      themeLogoStatus.textContent = msg;
      themeLogoStatus.style.color = kind === 'error' ? '#dc2626' : kind === 'ok' ? '#16a34a' : '';
    }

    function applyThemeToHtml(theme) {
      const html = document.documentElement;
      const lightVars = Object.entries(theme.light)
        .map(([k, v]) => `--color-${k.replace(/_/g, '-')}:${v}`).join(';');
      const darkVars = Object.entries(theme.dark)
        .map(([k, v]) => `--color-${k.replace(/_/g, '-')}:${v}`).join(';');
      html.setAttribute('data-theme-light-vars', lightVars);
      html.setAttribute('data-theme-dark-vars', darkVars);
      const current = html.getAttribute('data-theme') || 'light';
      html.setAttribute('style', current === 'dark' ? darkVars : lightVars);
      const logoSrc = theme.logo_data_url || theme.logo_url || '/logo.jpg';
      const logo = document.querySelector('.app-sidebar-brand img');
      if (logo) logo.src = logoSrc;
      if (themeLogoPreview) themeLogoPreview.src = logoSrc;
      if (themeLogoClearBtn) themeLogoClearBtn.hidden = !theme.logo_data_url;
    }

    // Repaint a single picker (the one currently showing the slot)
    // when the admin changes the dropdown OR the color value. Also
    // applies the change live to the page so the admin sees the
    // effect immediately without first hitting Save.
    function paintPicker(mode) {
      const p = themePickers[mode];
      if (!p || !p.input || !themeCurrent) return;
      const slot = p.select.value;
      const hex = themeCurrent[mode][slot];
      suppressPickerInputs = true;
      p.input.value = hex;
      suppressPickerInputs = false;
      if (p.hex) p.hex.textContent = hex.toUpperCase();
      // Live preview: temporarily inject this slot's value into the
      // matching CSS variable so the page reflects the picker as it
      // moves. On Save we commit the whole palette; on Reset we
      // restore the loaded palette.
      const html = document.documentElement;
      const cssVar = `--color-${slot.replace(/_/g, '-')}`;
      html.style.setProperty(cssVar, hex);
    }

    async function loadTheme() {
      const r = await fetch('/api/admin/theme-settings', { credentials: 'same-origin' });
      if (!r.ok) return;
      const body = await r.json();
      themeDefaults = body.defaults;
      themeCurrent = body.theme;
      if (themeLogoUrl) themeLogoUrl.value = body.theme.logo_url || '';
      paintPicker('light');
      paintPicker('dark');
    }

    function readForm() {
      // Build the save payload from the live preview state. Any slot
      // the admin touched has its current value already on the DOM; any
      // slot they HAVEN'T touched was never changed so we leave the
      // loaded themeCurrent value in place.
      const out = { light: { ...themeCurrent.light }, dark: { ...themeCurrent.dark } };
      for (const mode of ['light', 'dark']) {
        const p = themePickers[mode];
        if (p && p.input.value) out[mode][p.select.value] = p.input.value;
      }
      return {
        logo_url: themeLogoUrl && themeLogoUrl.value.trim() ? themeLogoUrl.value.trim() : null,
        ...out,
      };
    }

    // Wire up the pickers: changing the dropdown repaints; dragging
    // the color keeps the dropdown's slot and updates the matching
    // themeCurrent value + the live CSS var.
    for (const mode of ['light', 'dark']) {
      const p = themePickers[mode];
      if (!p) continue;
      p.select.addEventListener('change', () => paintPicker(mode));
      p.input.addEventListener('input', () => {
        if (suppressPickerInputs || !themeCurrent) return;
        const slot = p.select.value;
        const hex = p.input.value;
        themeCurrent[mode][slot] = hex;
        if (p.hex) p.hex.textContent = hex.toUpperCase();
        const cssVar = `--color-${slot.replace(/_/g, '-')}`;
        document.documentElement.style.setProperty(cssVar, hex);
      });
    }

    if (themeSave) {
      themeSave.addEventListener('click', async () => {
        setThemeStatus('Saving…');
        const payload = readForm();
        const r = await fetch('/api/admin/theme-settings', {
          method: 'PATCH',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (!r.ok) {
          const body = await r.json().catch(() => ({}));
          setThemeStatus(body.error || `Save failed (${r.status}).`, 'error');
          return;
        }
        const body = await r.json();
        themeCurrent = body.theme;
        applyThemeToHtml(themeCurrent);
        setThemeStatus('Saved — refresh any other open tabs to see the new colors there.', 'ok');
      });
    }

    if (themeReset) {
      themeReset.addEventListener('click', () => {
        if (themeLogoUrl) themeLogoUrl.value = '';
        if (themeDefaults) {
          themeCurrent = JSON.parse(JSON.stringify(themeDefaults));
          paintPicker('light');
          paintPicker('dark');
          applyThemeToHtml(themeCurrent);
        }
        setThemeStatus('Defaults loaded — click Save to apply.');
      });
    }

    // Logo upload — clicking the visible button opens the hidden file
    // picker; on change we POST multipart to /api/admin/theme-settings/logo
    // and apply the returned theme so the sidebar updates immediately.
    if (themeLogoUploadBtn && themeLogoUpload) {
      themeLogoUploadBtn.addEventListener('click', () => themeLogoUpload.click());
      themeLogoUpload.addEventListener('change', async () => {
        const file = themeLogoUpload.files && themeLogoUpload.files[0];
        if (!file) return;
        if (file.size > 512 * 1024) {
          setLogoStatus(`Too large (${Math.round(file.size / 1024)} KB). Max is 512 KB.`, 'error');
          themeLogoUpload.value = '';
          return;
        }
        setLogoStatus(`Uploading ${file.name} (${Math.round(file.size / 1024)} KB)…`);
        const fd = new FormData();
        fd.append('file', file);
        const r = await fetch('/api/admin/theme-settings/logo', {
          method: 'POST', credentials: 'same-origin', body: fd,
        });
        themeLogoUpload.value = '';
        if (!r.ok) {
          const body = await r.json().catch(() => ({}));
          setLogoStatus(body.error || `Upload failed (${r.status}).`, 'error');
          return;
        }
        const body = await r.json();
        themeCurrent = body.theme;
        applyThemeToHtml(themeCurrent);
        setLogoStatus(`Uploaded ${file.name} — previous logo replaced.`, 'ok');
      });
    }

    // Logo clear — wipes the uploaded data URL but leaves any external
    // logo_url intact so the sidebar falls back to it (or to /logo.jpg).
    if (themeLogoClearBtn) {
      themeLogoClearBtn.addEventListener('click', async () => {
        setLogoStatus('Removing…');
        const r = await fetch('/api/admin/theme-settings/logo', {
          method: 'DELETE', credentials: 'same-origin',
        });
        if (!r.ok) {
          const body = await r.json().catch(() => ({}));
          setLogoStatus(body.error || `Remove failed (${r.status}).`, 'error');
          return;
        }
        const body = await r.json();
        themeCurrent = body.theme;
        applyThemeToHtml(themeCurrent);
        setLogoStatus('Uploaded logo removed.', 'ok');
      });
    }

    loadTheme();
  </script>
</Layout>
