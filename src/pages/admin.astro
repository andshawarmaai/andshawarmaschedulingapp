    // ----- API keys -----

    function renderKeys() {
      const el = document.getElementById('keys-list');
      const keys = (data.apiKeys || []).filter((k) => !k.revoked);
      if (keys.length === 0) {
        el.innerHTML = '<p class="empty">No API keys yet.</p>';
        return;
      }
      el.innerHTML = keys.map((k) => `
        <div class="list-item">
          <div>
            <div class="who">${escapeHtml(k.label)}</div>
            <div class="meta">${escapeHtml(k.key_prefix)}••••••••••••••••••• · created ${formatDate(k.created_at.slice(0, 10), { short: true })}${k.last_used_at ? ' · last used ' + formatDate(k.last_used_at.slice(0, 10), { short: true }) : ' · never used'}</div>
          </div>
          <button class="btn-danger" data-revoke-key="${k.id}">Revoke</button>
        </div>
      `).join('');
      el.querySelectorAll('[data-revoke-key]').forEach((b) => {
        b.addEventListener('click', async () => {
          const k = keys.find((x) => x.id === b.getAttribute('data-revoke-key'));
          if (!k) return;
          if (!confirm(`Revoke "${k.label}"? Anything using this key will stop working immediately.`)) return;
          const r = await window.shawarmaApi('DELETE', `/api/admin/api-keys/${k.id}`);
          if (!r.ok) { window.shawarmaToast(r.error || 'Revoke failed'); return; }
          window.shawarmaToast('Key revoked');
          await refreshAndRender();
        });
      });
    }

    document.getElementById('add-key-btn').addEventListener('click', async () => {
      const label = prompt('Name this key (e.g. "Hermes" or "Telegram bot"):');
