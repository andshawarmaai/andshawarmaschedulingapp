---
// Every signed-in user's own profile — contact info + password. Deliberately
// separate from Manage -> Users (admin/manager-only, and capable of far
// more: role, disabled, tier). This page only ever touches the CALLER's own
// row, via /api/me (see that route's comment) — nothing here can reach or
// even see anyone else's account.
import Layout from '../layouts/Layout.astro';
import { getLang, t } from '../lib/i18n.js';
const lang = getLang(Astro);
---
<Layout title="&Shawarma — Settings" active="settings">
  <div class="card">
    <h2>{t(lang, 'settings.contactInfo')}</h2>
    <p class="card-sub">{t(lang, 'settings.contactInfoSub')}</p>
    <form id="contact-form">
      <div class="field"><label for="set-email">{t(lang, 'settings.email')}</label><input type="email" id="set-email" class="input" /></div>
      <div class="field"><label for="set-phone">{t(lang, 'settings.phone')}</label><input type="tel" id="set-phone" class="input" /></div>
      <button type="submit" class="btn-primary">{t(lang, 'common.save')}</button>
    </form>
  </div>

  <div class="card">
    <h2>{t(lang, 'settings.changePassword')}</h2>
    <p class="card-sub">{t(lang, 'settings.changePasswordSub')}</p>
    <form id="password-form">
      <div class="field"><label for="set-current-password">{t(lang, 'settings.currentPassword')}</label><input type="password" id="set-current-password" class="input" autocomplete="current-password" required /></div>
      <div class="field"><label for="set-new-password">{t(lang, 'settings.newPassword')}</label><input type="password" id="set-new-password" class="input" autocomplete="new-password" required /></div>
      <div class="field"><label for="set-confirm-password">{t(lang, 'settings.confirmPassword')}</label><input type="password" id="set-confirm-password" class="input" autocomplete="new-password" required /></div>
      <button type="submit" class="btn-primary">{t(lang, 'common.save')}</button>
    </form>
  </div>

  <script define:vars={{ lang }}>
    window.__lang = lang;
  </script>

  <div class="card" id="source-card" hidden>
    <h2>Chat Source</h2>
    <p class="card-sub">Where the Chat Bot gets its brain from. Pick one — only the matching dependency below needs to be set.</p>

    <div id="source-status" class="card-sub" style="margin-top:0.75rem;"></div>

    <form id="source-form" style="margin-top:1rem;">
      <div class="field">
        <label for="source-mode">Source</label>
        <select id="source-mode" class="input" required>
          <option value="hermes">Hermes (local) — free, needs your Mac on</option>
          <option value="cloud">Cloud API — paid, always works</option>
          <option value="hybrid">Hybrid — Hermes first, cloud fallback</option>
        </select>
      </div>
      <div style="display:flex;gap:0.5rem;">
        <button type="submit" class="btn-primary" id="source-save">Save</button>
      </div>
    </form>

    <p class="card-sub" style="margin-top:1rem;">Once saved, the floating Chat Bot button picks up the new source on the next message. Switch any time, no rebuild needed.</p>
  </div>

  <div class="card" id="tunnel-card" hidden>
    <h2>Hermes (local tunnel)</h2>
    <p class="card-sub">For the <b>Hermes</b> and <b>Hybrid</b> modes. Run <code>scripts/hermes-bridge.mjs</code> + <code>cloudflared tunnel</code> on your Mac, then paste the public URL here. <a href="#" id="tunnel-help">How do I set this up?</a></p>

    <div id="tunnel-status" class="card-sub" style="margin-top:0.75rem;"></div>

    <form id="tunnel-form" style="margin-top:1rem;">
      <div class="field">
        <label for="tunnel-url">Tunnel URL</label>
        <input type="url" id="tunnel-url" class="input" placeholder="https://something.trycloudflare.com" />
      </div>
      <div style="display:flex;gap:0.5rem;flex-wrap:wrap;">
        <button type="submit" class="btn-primary" id="tunnel-save">Save & Test</button>
        <button type="button" class="btn-secondary" id="tunnel-clear">Remove</button>
      </div>
    </form>
  </div>

  <div class="card" id="ai-card" hidden>
    <h2>Chat Bot</h2>
    <p class="card-sub">Connect an AI service so the chat panel on the Schedule Builder can answer questions and make changes for you. Pick a provider and paste your key — it's encrypted and stored in the database. <strong>Only admins/managers see this card.</strong></p>

    <div id="ai-status" class="card-sub" style="margin-top:0.75rem;"></div>

    <form id="ai-form" style="margin-top:1rem;">
      <div class="field">
        <label for="ai-provider">Provider</label>
        <select id="ai-provider" class="input" required>
          <option value="">Loading…</option>
        </select>
      </div>
      <div class="field">
        <label for="ai-model">Model (optional — leave blank for the provider default)</label>
        <input type="text" id="ai-model" class="input" placeholder="e.g. claude-sonnet-4-5" />
      </div>
      <div class="field">
        <label for="ai-key">API Key</label>
        <input type="password" id="ai-key" class="input" autocomplete="off" placeholder="sk-... or your provider's key format" required />
      </div>
      <div style="display:flex;gap:0.5rem;flex-wrap:wrap;">
        <button type="submit" class="btn-primary" id="ai-save">Save & Test</button>
        <button type="button" class="btn-secondary" id="ai-clear">Remove</button>
      </div>
    </form>

    <details style="margin-top:1rem;">
      <summary>How to get a key</summary>
      <ul style="margin-top:0.5rem;padding-left:1.25rem;">
        <li><strong>Anthropic:</strong> console.anthropic.com → Settings → API Keys</li>
        <li><strong>OpenAI:</strong> platform.openai.com → API keys</li>
        <li><strong>MiniMax:</strong> MiniMax console → API Keys</li>
      </ul>
      <p style="margin-top:0.5rem;">All three work the same way. The chat reads this on every message — change it any time, no redeploy.</p>
    </details>
  </div>

  <script>
    import { t } from '../lib/i18n.js';

    const lang = window.__lang;
    let data = null;

    async function loadState() {
      const res = await fetch('/api/state');
      data = await res.json();
      // data.me is decoded straight from the session token (set at login),
      // which never carries email/phone — data.users is the live DB read,
      // so look ourselves up there instead or the form would always show
      // blank regardless of whether a save actually worked.
      const me = data.users.find((u) => u.id === data.me.id) || {};
      document.getElementById('set-email').value = me.email || '';
      document.getElementById('set-phone').value = me.phone || '';
    }

    document.getElementById('contact-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const payload = {
        email: document.getElementById('set-email').value.trim() || null,
        phone: document.getElementById('set-phone').value.trim() || null,
      };
      const r = await window.shawarmaApi('PATCH', '/api/me', payload);
      if (!r.ok) { window.shawarmaToast(r.error || t(lang, 'common.failed')); return; }
      window.shawarmaToast(t(lang, 'settings.contactSaved'));
      await loadState();
    });

    document.getElementById('password-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const current_password = document.getElementById('set-current-password').value;
      const new_password = document.getElementById('set-new-password').value;
      const confirm_password = document.getElementById('set-confirm-password').value;
      if (new_password !== confirm_password) {
        window.shawarmaToast(t(lang, 'settings.passwordMismatch'));
        return;
      }
      const r = await window.shawarmaApi('PATCH', '/api/me', { current_password, new_password });
      if (!r.ok) { window.shawarmaToast(r.error || t(lang, 'common.failed')); return; }
      window.shawarmaToast(t(lang, 'settings.passwordSaved'));
      document.getElementById('password-form').reset();
    });

    loadState();
  </script>

  <script>
    // Chat Source section — picks where the chat gets its brain from.
    // Hidden for non-admin/manager. Always shown to admin/manager so they
    // can switch between Hermes / Cloud / Hybrid without env vars.
    const sourceCard = document.getElementById('source-card');
    const sourceMode = document.getElementById('source-mode');
    const sourceStatus = document.getElementById('source-status');
    const sourceSave = document.getElementById('source-save');
    const sourceForm = document.getElementById('source-form');

    // Tunnel URL section — used by Hermes and Hybrid modes.
    const tunnelCard = document.getElementById('tunnel-card');
    const tunnelUrl = document.getElementById('tunnel-url');
    const tunnelStatus = document.getElementById('tunnel-status');
    const tunnelSave = document.getElementById('tunnel-save');
    const tunnelClear = document.getElementById('tunnel-clear');
    const tunnelForm = document.getElementById('tunnel-form');

    async function loadSourceConfig() {
      try {
        const r = await fetch('/api/admin/settings/chat-source', { credentials: 'same-origin' });
        if (r.status === 403) { sourceCard.hidden = true; tunnelCard.hidden = true; return; }
        const cfg = await r.json();
        sourceCard.hidden = false;
        tunnelCard.hidden = false;
        if (cfg.mode) sourceMode.value = cfg.mode;
        sourceStatus.textContent = `Current source: ${cfg.mode || 'none'}.`;
      } catch (_) {
        sourceCard.hidden = false;
        sourceStatus.textContent = 'Failed to load source config.';
      }
    }

    async function loadTunnelConfig() {
      try {
        const r = await fetch('/api/admin/settings/tunnel', { credentials: 'same-origin' });
        if (r.status === 403) { tunnelCard.hidden = true; return; }
        const cfg = await r.json();
        tunnelCard.hidden = false;
        if (cfg.tunnel_url) tunnelUrl.value = cfg.tunnel_url;
        if (cfg.reachable) {
          tunnelStatus.textContent = `Connected to ${cfg.tunnel_url}. Tunnel is reachable.`;
        } else if (cfg.tunnel_url) {
          tunnelStatus.textContent = `Saved URL: ${cfg.tunnel_url}, but it's not responding right now. Mode: ${cfg.mode}.`;
        } else {
          tunnelStatus.textContent = 'No tunnel URL set. Add one to enable Hermes or Hybrid mode.';
        }
      } catch (_) {
        tunnelCard.hidden = false;
        tunnelStatus.textContent = 'Failed to load tunnel config.';
      }
    }

    sourceForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!sourceMode.value) { window.shawarmaToast('Pick a source.'); return; }
      sourceSave.disabled = true;
      try {
        const r = await fetch('/api/admin/settings/chat-source', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ mode: sourceMode.value }),
        });
        if (!r.ok) { window.shawarmaToast('Save failed.'); return; }
        window.shawarmaToast('Source updated.');
        await loadSourceConfig();
      } finally {
        sourceSave.disabled = false;
      }
    });

    tunnelForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!tunnelUrl.value.trim()) { window.shawarmaToast('Paste a tunnel URL.'); return; }
      tunnelSave.disabled = true;
      tunnelSave.textContent = 'Testing…';
      try {
        const r = await fetch('/api/admin/settings/tunnel', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ tunnel_url: tunnelUrl.value.trim() }),
        });
        const result = await r.json();
        if (!r.ok) { window.shawarmaToast(result.error || 'Save failed.'); return; }
        window.shawarmaToast('Tunnel connected.');
        await loadTunnelConfig();
      } finally {
        tunnelSave.disabled = false;
        tunnelSave.textContent = 'Save & Test';
      }
    });

    tunnelClear.addEventListener('click', async () => {
      if (!confirm('Remove the tunnel URL?')) return;
      const r = await fetch('/api/admin/settings/tunnel', { method: 'DELETE', credentials: 'same-origin' });
      if (!r.ok) { window.shawarmaToast('Failed.'); return; }
      window.shawarmaToast('Removed.');
      tunnelUrl.value = '';
      await loadTunnelConfig();
    });

    loadSourceConfig();
    loadTunnelConfig();
  </script>

  <script>
    // Chat Bot section — only visible to admin/manager. Loads current
    // config (provider + has_key, never the raw key) and lets the user
    // change provider or rotate the key. POST tests the key before storing.
    const aiCard = document.getElementById('ai-card');
    const aiProvider = document.getElementById('ai-provider');
    const aiModel = document.getElementById('ai-model');
    const aiKey = document.getElementById('ai-key');
    const aiStatus = document.getElementById('ai-status');
    const aiSave = document.getElementById('ai-save');
    const aiClear = document.getElementById('ai-clear');
    const aiForm = document.getElementById('ai-form');

    async function loadAiConfig() {
      try {
        const r = await fetch('/api/admin/settings/ai', { credentials: 'same-origin' });
        if (r.status === 403) { aiCard.hidden = true; return; }
        const cfg = await r.json();
        aiCard.hidden = false;
        // Populate provider dropdown
        aiProvider.innerHTML = '<option value="">— Select —</option>' +
          (cfg.providers || []).map((p) => `<option value="${p.id}">${p.label}</option>`).join('');
        if (cfg.provider) aiProvider.value = cfg.provider;
        if (cfg.model) aiModel.value = cfg.model;
        // Status text
        if (cfg.has_key && cfg.provider) {
          aiStatus.textContent = `Connected to ${cfg.provider}${cfg.model ? ' · ' + cfg.model : ''}. The chat will use this provider on every message.`;
          aiStatus.style.color = '';
        } else {
          aiStatus.textContent = 'Not connected. The chat shows a stub reply until you add a key here.';
          aiStatus.style.color = 'var(--color-muted)';
        }
      } catch (e) {
        aiCard.hidden = false;
        aiStatus.textContent = 'Failed to load AI settings.';
      }
    }

    aiForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!aiProvider.value || !aiKey.value) {
        window.shawarmaToast('Pick a provider and paste your key.');
        return;
      }
      aiSave.disabled = true;
      aiSave.textContent = 'Testing…';
      try {
        const r = await fetch('/api/admin/settings/ai', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            provider: aiProvider.value,
            api_key: aiKey.value,
            model: aiModel.value.trim() || undefined,
          }),
        });
        const result = await r.json();
        if (!r.ok) { window.shawarmaToast(result.error || 'Save failed'); return; }
        window.shawarmaToast(`Connected. ${result.models ? result.models.length + ' models available.' : ''}`);
        aiKey.value = '';
        await loadAiConfig();
      } finally {
        aiSave.disabled = false;
        aiSave.textContent = 'Save & Test';
      }
    });

    aiClear.addEventListener('click', async () => {
      if (!confirm('Remove the AI key? The chat will fall back to stub mode.')) return;
      const r = await fetch('/api/admin/settings/ai', { method: 'DELETE', credentials: 'same-origin' });
      if (!r.ok) { window.shawarmaToast('Failed to remove.'); return; }
      window.shawarmaToast('Removed.');
      await loadAiConfig();
    });

    loadAiConfig();
  </script>
</Layout>
