---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { getLang, t } from '../lib/i18n.js';

const user = Astro.locals.user;
const lang = getLang(Astro);
---
<Layout title="&Shawarma" active="home">
  <div class="card">
    <h1>{t(lang, 'home.welcome', { name: user.display_name })}</h1>
    <p style="color:var(--color-muted);margin:0;">{t(lang, 'home.yourRole')} <span class={`badge badge-${user.role}`}>{t(lang, `role.${user.role}`)}</span></p>
  </div>

  {(user.role === 'admin' || user.role === 'manager') && (
    <a href="/admin" id="approvals-alert" class="card" style="display:none;border-color:#fbbf24;background:#fffbeb;text-decoration:none;color:inherit;">
      <h2><Icon name="bell" size={18} class="icon-inline" /> {t(lang, 'home.pendingApprovals')} <span id="approvals-count" class="badge badge-pending">0</span></h2>
      <p class="card-sub" style="margin:0;">{t(lang, 'home.pendingApprovalsSub')}</p>
    </a>
  )}

  <!-- GPS / location check-in removed (Sep 2026). The /api/checkin and
       /api/admin/location-geofence endpoints are now no-op stubs so any
       stale links still return a friendly disabled message instead of
       breaking. -->
  <div class="card" id="checkin-card" style="display:none;" hidden>
    <h2><Icon name="clock" size={18} class="icon-inline" /> {t(lang, 'checkin.title')}</h2>
    <p class="card-sub">{t(lang, 'checkin.sub')}</p>
    <p id="checkin-status" style="font-weight:600;margin:0 0 0.75rem;"></p>
    <button class="btn-primary" id="checkin-btn" type="button" style="width:100%;"></button>
  </div>

  <div class="card">
    <h2><Icon name="calendar" size={18} class="icon-inline" /> {t(lang, 'home.myUpcomingShifts')}</h2>
    <div id="shifts-list"><p class="empty">{t(lang, 'common.loading')}</p></div>
  </div>

  <div class="grid-2">
    <a href="/schedule" class="tile">
      <div class="tile-icon"><Icon name="calendar" size={28} /></div>
      <div class="tile-title">{t(lang, 'home.tileFullSchedule')}</div>
      <div class="tile-sub">{t(lang, 'home.tileFullScheduleSub')}</div>
    </a>
    <a href="/shift-swap" class="tile">
      <div class="tile-icon"><Icon name="swap" size={28} /></div>
      <div class="tile-title">{t(lang, 'home.tileSwap')}</div>
      <div class="tile-sub">{t(lang, 'home.tileSwapSub')}</div>
    </a>
    <a href="/time-off" class="tile">
      <div class="tile-icon"><Icon name="timeoff" size={28} /></div>
      <div class="tile-title">{t(lang, 'home.tileTimeOff')}</div>
      <div class="tile-sub">{t(lang, 'home.tileTimeOffSub')}</div>
    </a>
    {(user.role === 'admin' || user.role === 'manager') && (
      <a href="/admin" class="tile">
        <div class="tile-icon"><Icon name="admin" size={28} /></div>
        <div class="tile-title">{t(lang, 'home.tileManage')}</div>
        <div class="tile-sub">{t(lang, 'home.tileManageSub')}</div>
      </a>
    )}
  </div>

  <div class="card">
    <h2><Icon name="users" size={18} class="icon-inline" /> {t(lang, 'home.teamRoster')}</h2>
    <p class="card-sub">{t(lang, 'home.teamRosterSub')}</p>
    <div class="roster-grid" id="roster-grid"><p class="empty">{t(lang, 'common.loading')}</p></div>
  </div>

  <script define:vars={{ lang }}>
    window.__lang = lang;
  </script>
  <script>
    import { formatDate, formatTime12, todayISO, escapeHtml } from '../lib/client/format.js';
    import { t } from '../lib/i18n.js';
    const lang = window.__lang;

    async function init() {
      const res = await fetch('/api/state');
      if (!res.ok) {
        document.getElementById('shifts-list').innerHTML = `<p class="empty">${t(lang, 'home.couldNotLoad')}</p>`;
        return;
      }
      const data = await res.json();
      const today = todayISO();

      const alertCard = document.getElementById('approvals-alert');
      if (alertCard) {
        const pendingTimeOff = (data.timeOffAll || []).filter((t) => t.status === 'pending').length;
        const pendingClaims = (data.swapClaims || []).filter((c) => c.status === 'pending').length;
        const pendingShiftReqs = (data.shiftRequests || []).filter((r) => r.status === 'pending').length;
        const pendingPasswordResets = (data.passwordResetRequests || []).length;
        const total = pendingTimeOff + pendingClaims + pendingShiftReqs + pendingPasswordResets;
        if (total > 0) {
          document.getElementById('approvals-count').textContent = total;
          alertCard.style.display = 'block';
        }
      }

      const myShifts = data.shifts
        .filter((s) => s.user_id === data.me.id && s.date >= today)
        .sort((a, b) => (a.date + a.start_time).localeCompare(b.date + b.start_time))
        .slice(0, 5);

      const shiftsList = document.getElementById('shifts-list');
      shiftsList.innerHTML = myShifts.length === 0
        ? `<p class="empty">${t(lang, 'home.noUpcomingShifts')}</p>`
        : myShifts.map((s) => `
          <div class="list-item">
            <div>
              <div class="who">${formatDate(s.date, { short: true, lang })}</div>
              <div class="meta">${formatTime12(s.start_time)} – ${formatTime12(s.end_time)}</div>
            </div>
          </div>
        `).join('');

      const rosterGrid = document.getElementById('roster-grid');
      const roster = data.users.filter((u) => !u.disabled).sort((a, b) => a.display_name.localeCompare(b.display_name));
      rosterGrid.innerHTML = roster.map((u) => {
        const next = data.shifts
          .filter((s) => s.user_id === u.id && s.date >= today)
          .sort((a, b) => (a.date + a.start_time).localeCompare(b.date + b.start_time))[0];
        const nextHtml = next
          ? `<div class="roster-card-next">${formatDate(next.date, { short: true, lang })} · ${formatTime12(next.start_time)}</div>`
          : `<div class="roster-card-next off">${t(lang, 'home.noUpcomingShiftsShort')}</div>`;
        const contact = [
          u.phone ? `<a href="tel:${escapeHtml(u.phone)}">${escapeHtml(u.phone)}</a>` : '',
          u.email ? `<a href="mailto:${escapeHtml(u.email)}">${escapeHtml(u.email)}</a>` : '',
        ].filter(Boolean).join('');
        return `
          <div class="roster-card">
            <div class="roster-card-head">
              <span class="roster-card-name">${escapeHtml(u.display_name)}</span>
              <span class="badge badge-${u.role}">${t(lang, `role.${u.role}`)}</span>
            </div>
            ${nextHtml}
            ${contact ? `<div class="roster-card-contact">${contact}</div>` : ''}
          </div>
        `;
      }).join('');

      renderCheckIn(data);
    }

    // ----- Check In / Check Out -----
    // GPS / location check-in was removed in Sep 2026 — the card stays
    // in the DOM (hidden) so the i18n key bundle keeps shipping, but the
    // geolocation hook and API call are intentionally disabled.
    let myOpenCheckIn = null;
    function renderCheckIn(_data) {
      const card = document.getElementById('checkin-card');
      if (!card) return;
      card.style.display = 'none';
      card.hidden = true;
    }

    document.getElementById('checkin-btn').addEventListener('click', () => {
      // GPS / location check-in removed Sep 2026 — clicking this button
      // (which the card makes invisible anyway) just shows a toast.
      window.shawarmaToast('Location check-in is no longer used.');
      return;
      if (!navigator.geolocation) { window.shawarmaToast(t(lang, 'checkin.noGeolocation')); return; }
      const btn = document.getElementById('checkin-btn');
      const statusEl = document.getElementById('checkin-status');
      btn.disabled = true;
      const prevStatus = statusEl.textContent;
      statusEl.textContent = t(lang, 'checkin.reading');
      navigator.geolocation.getCurrentPosition(
        async (pos) => {
          const now = new Date();
          const payload = {
            action: myOpenCheckIn ? 'out' : 'in',
            lat: pos.coords.latitude,
            lng: pos.coords.longitude,
            date: todayISO(),
            time: `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`,
          };
          const r = await window.shawarmaApi('POST', '/api/checkin', payload);
          btn.disabled = false;
          if (!r.ok) { statusEl.textContent = prevStatus; window.shawarmaToast(r.error || 'Could not check in'); return; }
          window.shawarmaToast(payload.action === 'in' ? t(lang, 'checkin.success') : t(lang, 'checkin.successOut'));
          await init();
        },
        () => {
          btn.disabled = false;
          statusEl.textContent = prevStatus;
          window.shawarmaToast(t(lang, 'checkin.locationDenied'));
        },
      );
    });

    init();
  </script>
</Layout>
