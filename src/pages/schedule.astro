---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { getLang, t } from '../lib/i18n.js';
const user = Astro.locals.user;
const canEdit = user.role === 'admin' || user.role === 'manager';
const lang = getLang(Astro);
---
<Layout title="&Shawarma — Schedule" active="schedule">
  <div style="display:flex;justify-content:flex-end;margin-bottom:0.5rem;">
    <button class="btn-secondary no-print" id="print-btn" type="button"><Icon name="print" size={16} class="icon-inline" /> {t(lang, 'schedule.print')}</button>
  </div>
  <div class="calendar-nav">
    <button class="btn-secondary" id="prev-period">{t(lang, 'common.prev')}</button>
    <h2 id="period-label">{t(lang, 'common.loading')}</h2>
    <button class="btn-secondary" id="next-period">{t(lang, 'common.next')}</button>
  </div>
  <div class="calendar-nav" style="margin-top:-0.5rem;">
    <div class="view-toggle" id="view-toggle">
      <button data-view="month" class="active">{t(lang, 'common.month')}</button>
      <button data-view="day">{t(lang, 'common.day')}</button>
    </div>
  </div>

  <!-- Print/Save-as-PDF-only: a self-contained, page-sized sheet — a clean
       static month grid plus a plain shift list — never the interactive
       on-screen calendar (fixed widths, a compact cell truncates times and
       names, none of which means anything on paper). Hidden on screen (see
       .print-only in global.css), shown only inside the browser's native
       print dialog (which is also how "Save as PDF" works in every major
       browser — no extra library needed). `print-keep` marks this as the
       one thing that survives onto the printed page — everything else on
       the page is hidden by default in print, see main.app-page's rule. -->
  <div class="print-only print-keep" id="print-shift-list">
    <div class="print-sheet-header">
      <h1>{user.display_name} — {t(lang, 'schedule.print')}</h1>
      <p id="print-period"></p>
    </div>
    <table class="print-month-grid" id="print-month-grid"></table>
    <h2 class="print-list-heading">{t(lang, 'schedule.print')}</h2>
    <table class="print-shift-table">
      <thead><tr><th>{t(lang, 'schedule.date')}</th><th>{t(lang, 'schedule.startTime')}</th><th>{t(lang, 'schedule.endTime')}</th><th>{t(lang, 'common.notes')}</th></tr></thead>
      <tbody id="print-shift-rows"></tbody>
    </table>
    <p id="print-generated-at" class="print-generated-at"></p>
  </div>

  <div id="view-container" class="cal-scroll"><p class="empty">{t(lang, 'common.loading')}</p></div>

  {!canEdit && (
    <div class="card no-print">
      <h2>{t(lang, 'schedule.myAvailability')}</h2>
      <p class="card-sub">{t(lang, 'schedule.myAvailabilitySub')}</p>
      <div id="my-requests"><p class="empty">{t(lang, 'common.loading')}</p></div>
    </div>
  )}

  <div class="modal-backdrop" id="day-modal">
    <div class="modal">
      <div class="modal-header">
        <h2 id="modal-title">{t(lang, 'schedule.day')}</h2>
        <button class="modal-close" id="modal-close" aria-label="Close" type="button">&times;</button>
      </div>
      <div class="modal-body">
        <div id="modal-shifts"></div>
        <div id="modal-actions"></div>
      </div>
    </div>
  </div>

  <div class="modal-backdrop" id="editor-modal">
    <div class="modal">
      <div class="modal-header">
        <h2 id="editor-title">{t(lang, 'schedule.editorTitleNewShift')}</h2>
        <button class="modal-close" id="editor-close" aria-label="Close" type="button">&times;</button>
      </div>
      <div class="modal-body">
        <p id="editor-note" class="card-sub" style="margin-top:0;" hidden>{t(lang, 'schedule.editorNote')}</p>
        <div class="field" id="editor-staff-field">
          <label for="ed-user">{t(lang, 'schedule.staff')}</label>
          <select id="ed-user" class="input"></select>
        </div>
        <div class="field"><label for="ed-date">{t(lang, 'schedule.date')}</label><input type="date" id="ed-date" class="input" /></div>
        <label id="ed-all-day-field" style="display:flex;align-items:center;gap:0.5rem;cursor:pointer;font-weight:400;margin-bottom:0.875rem;" hidden>
          <input type="checkbox" id="ed-all-day" style="width:1rem;height:1rem;" />
          <span>{t(lang, 'schedule.availableAllDay')}</span>
        </label>
        <div class="field"><label for="ed-start">{t(lang, 'schedule.startTime')}</label><input type="time" id="ed-start" class="input" value="11:00" /></div>
        <div class="field"><label for="ed-end">{t(lang, 'schedule.endTime')}</label><input type="time" id="ed-end" class="input" value="19:00" /></div>
        <div class="field"><label for="ed-notes">{t(lang, 'common.notes')}</label><input type="text" id="ed-notes" class="input" placeholder={t(lang, 'common.optional')} /></div>
      </div>
      <div class="modal-footer">
        <button class="btn-danger" id="ed-delete" hidden>{t(lang, 'schedule.deleteBtn')}</button>
        <button class="btn-primary" id="ed-save">{t(lang, 'common.save')}</button>
      </div>
    </div>
  </div>

  <script define:vars={{ canEdit, myUserId: user.id, lang }}>
    window.__scheduleCtx = { canEdit, myUserId };
    window.__lang = lang;
  </script>
  <script>
    import { formatDate, formatTime12, todayISO, getMonthCells, isBlocked, escapeHtml, slotStatus } from '../lib/client/format.js';
    import { t } from '../lib/i18n.js';

    const ctx = window.__scheduleCtx;
    const lang = window.__lang;
    // A real SVG (matching Icon.astro's "check", used everywhere else in
    // the app) instead of a Unicode checkmark character, for the
    // acknowledge button built here in client JS — Icon.astro itself only
    // renders at build/server time, so script-generated markup needs its
    // own copy of the same path data.
    const CHECK_SVG = '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-2px;"><path d="M20 6 9 17l-5-5"/></svg>';
    let data = null;
    let view = 'month';
    const today = todayISO();
    const t0 = new Date(today + 'T00:00:00');
    let viewYear = t0.getFullYear();
    let viewMonth = t0.getMonth() + 1;
    let viewDay = t0.getDate();
    let editingShiftId = null;

    async function loadState() {
      const res = await fetch('/api/state');
      data = await res.json();
    }

    function userName(id) {
      const u = data.users.find((x) => x.id === id);
      return u ? u.display_name : t(lang, 'schedule.unassigned');
    }

    function shiftsForDate(iso) {
      return data.shifts.filter((s) => s.date === iso).sort((a, b) => a.start_time.localeCompare(b.start_time));
    }

    function slotBadge(iso, startTime) {
      const status = slotStatus(data.dayCaps, data.shifts, iso, startTime);
      if (!status) return '';
      return status.full
        ? ' <span class="badge badge-full">FULL</span>'
        : ` <span class="badge badge-count">${status.count}/${status.cap.max_shifts}</span>`;
    }

    // A shift with a pending update/delete request against it gets a badge
    // so staff can see their change is queued instead of wondering why
    // nothing happened yet.
    function pendingRequestForShift(shiftId) {
      return (data.shiftRequests || []).find((r) => r.shift_id === shiftId && r.status === 'pending');
    }

    function canRequestOn(shift) {
      return ctx.canEdit || shift.user_id === ctx.myUserId;
    }

    function render() {
      const container = document.getElementById('view-container');
      const label = document.getElementById('period-label');

      if (view === 'day') {
        const iso = `${viewYear}-${String(viewMonth).padStart(2, '0')}-${String(viewDay).padStart(2, '0')}`;
        label.textContent = formatDate(iso, { lang });
        const shifts = shiftsForDate(iso);
        const addBtn = `<button class="btn-primary" id="day-add" style="margin-top:0.5rem;">${ctx.canEdit ? t(lang, 'schedule.addShift') : t(lang, 'schedule.requestShift')}</button>`;
        container.innerHTML = (shifts.length === 0
          ? `<p class="empty">${t(lang, 'schedule.noShiftsOnDay')}</p>`
          : `<div class="day-view">${shifts.map(renderDayShift).join('')}</div>`) + addBtn;
        wireDayView(iso, shifts);
        return;
      }

      label.textContent = formatDate(`${viewYear}-${String(viewMonth).padStart(2, '0')}-01`, { monthYear: true, lang });
      const cells = getMonthCells(viewYear, viewMonth);
      const dayKeys = ['sun', 'mon', 'tue', 'wed', 'thu', 'fri', 'sat'];
      const head = dayKeys.map((d) => `<div class="calendar-head">${t(lang, `days.${d}`)}</div>`).join('');
      const body = cells.map((c) => {
        const dayShifts = shiftsForDate(c.iso);
        const timeOffHere = data.timeOffApproved.filter((b) => c.iso >= b.start_date && c.iso <= b.end_date);
        const lines = dayShifts.slice(0, 3).map((s) => {
          const blocked = isBlocked(data.timeOffApproved, c.iso, s.user_id);
          const firstName = userName(s.user_id).split(' ')[0];
          return `<span class="shift-line${blocked ? ' on-leave' : ''}"><strong>${escapeHtml(firstName)}</strong> ${formatTime12(s.start_time)}</span>`;
        }).join('');
        const more = dayShifts.length > 3 ? `<span class="shift-line">${t(lang, 'schedule.more', { n: dayShifts.length - 3 })}</span>` : '';
        // Outlook-style block: the bar only carries the name + reason on the
        // first day of a run; every day after that renders as a lighter
        // "continued" bar so a multi-day time-off reads as one span instead
        // of repeating the same label on every cell.
        let offBar = '';
        if (timeOffHere.length > 0) {
          const block = timeOffHere[0];
          const prev = new Date(c.iso + 'T00:00:00');
          prev.setDate(prev.getDate() - 1);
          const prevISO = prev.toISOString().slice(0, 10);
          const isStart = !isBlocked(data.timeOffApproved, prevISO, block.user_id);
          offBar = isStart
            ? `<div class="time-off-bar">${escapeHtml(userName(block.user_id))} — ${t(lang, 'schedule.off')}</div>`
            : `<div class="time-off-bar time-off-cont">${t(lang, 'schedule.continued')}</div>`;
        }
        const isToday = c.iso === today;
        return `<div class="calendar-day${c.other ? ' other-month' : ''}${isToday ? ' today' : ''}${timeOffHere.length ? ' has-timeoff' : ''}" data-iso="${c.iso}">
          <span class="day-num">${parseInt(c.iso.slice(8, 10), 10)}</span>
          ${offBar}${lines}${more}
        </div>`;
      }).join('');
      container.innerHTML = `<div class="calendar-grid">${head}${body}</div>`;
      container.querySelectorAll('.calendar-day').forEach((el) => {
        el.addEventListener('click', () => openDay(el.getAttribute('data-iso')));
      });
    }

    function renderDayShift(s) {
      const pending = pendingRequestForShift(s.id);
      const canAct = canRequestOn(s);
      const editBtn = canAct ? `<button class="btn-secondary" data-edit="${s.id}">${ctx.canEdit ? t(lang, 'schedule.edit') : t(lang, 'schedule.requestChange')}</button>` : '';
      const pendingBadge = pending ? ` <span class="badge badge-pending">${t(lang, `schedule.action.${pending.action}`)} ${t(lang, 'schedule.pendingSuffix')}</span>` : '';
      return `<div class="day-shift">
        <div class="day-shift-main">
          <div class="day-shift-name">${escapeHtml(userName(s.user_id))}${slotBadge(s.date, s.start_time)}${pendingBadge}</div>
          <div class="day-shift-time">${formatTime12(s.start_time)} – ${formatTime12(s.end_time)}</div>
          ${s.notes ? `<div class="day-shift-notes">${escapeHtml(s.notes)}</div>` : ''}
        </div>
        <div>${editBtn}</div>
      </div>`;
    }

    function wireDayView(iso, shifts) {
      const addBtn = document.getElementById('day-add');
      if (addBtn) addBtn.addEventListener('click', () => openEditor(iso, null));
      document.querySelectorAll('#view-container [data-edit]').forEach((b) => {
        b.addEventListener('click', () => openEditor(iso, b.getAttribute('data-edit')));
      });
    }

    function openDay(iso) {
      const shifts = shiftsForDate(iso);
      document.getElementById('modal-title').textContent = formatDate(iso, { lang });
      document.getElementById('modal-shifts').innerHTML = shifts.length === 0
        ? `<p class="empty">${t(lang, 'schedule.noShiftsScheduled')}</p>`
        : shifts.map(renderDayShift).join('');
      const addBtn = `<button class="btn-primary" id="modal-add-shift">${ctx.canEdit ? t(lang, 'schedule.addShift') : t(lang, 'schedule.requestShift')}</button>`;
      document.getElementById('modal-actions').innerHTML = addBtn;
      document.getElementById('modal-add-shift').addEventListener('click', () => openEditor(iso, null));
      document.querySelectorAll('#modal-shifts [data-edit]').forEach((b) => {
        b.addEventListener('click', () => openEditor(iso, b.getAttribute('data-edit')));
      });
      document.getElementById('day-modal').classList.add('show');
    }

    function applyAllDay(checked) {
      document.getElementById('ed-start').value = checked ? '00:00' : '11:00';
      document.getElementById('ed-end').value = checked ? '23:59' : '19:00';
      document.getElementById('ed-start').disabled = checked;
      document.getElementById('ed-end').disabled = checked;
    }
    document.getElementById('ed-all-day').addEventListener('change', (e) => applyAllDay(e.target.checked));

    function openEditor(iso, shiftId) {
      editingShiftId = shiftId;
      const shift = shiftId ? data.shifts.find((s) => s.id === shiftId) : null;
      if (shift && !canRequestOn(shift)) return;
      // "Available all day" only makes sense when a staff member is
      // showing new availability, not when editing/removing a shift
      // they're already scheduled for, or when an admin is directly
      // assigning someone a specific shift.
      const showAllDay = !ctx.canEdit && !shift;
      document.getElementById('editor-title').textContent = shift
        ? (ctx.canEdit ? t(lang, 'schedule.editorTitleEditShift') : t(lang, 'schedule.editorTitleRequestChange'))
        : (ctx.canEdit ? t(lang, 'schedule.editorTitleNewShift') : t(lang, 'schedule.editorTitleShowAvailability'));
      document.getElementById('editor-note').hidden = ctx.canEdit;
      document.getElementById('ed-all-day-field').hidden = !showAllDay;
      document.getElementById('ed-all-day').checked = false;
      const userSelect = document.getElementById('ed-user');
      userSelect.innerHTML = data.users.filter((u) => !u.disabled).map((u) =>
        `<option value="${u.id}" ${shift ? (shift.user_id === u.id ? 'selected' : '') : (u.id === ctx.myUserId ? 'selected' : '')}>${escapeHtml(u.display_name)}</option>`
      ).join('');
      if (!ctx.canEdit) userSelect.value = ctx.myUserId;
      document.getElementById('ed-date').value = shift ? shift.date : iso;
      applyAllDay(false);
      if (shift) {
        document.getElementById('ed-start').value = shift.start_time;
        document.getElementById('ed-end').value = shift.end_time;
      }
      document.getElementById('ed-notes').value = shift && shift.notes ? shift.notes : '';
      document.getElementById('ed-delete').hidden = !shift;
      document.getElementById('ed-delete').textContent = ctx.canEdit ? t(lang, 'schedule.deleteBtn') : t(lang, 'schedule.requestRemoval');
      document.getElementById('day-modal').classList.remove('show');
      document.getElementById('editor-modal').classList.add('show');
    }

    function closeEditor() {
      document.getElementById('editor-modal').classList.remove('show');
      editingShiftId = null;
    }

    // A grid cell is only ~1.4in wide on a landscape letter page split into
    // 7 columns — "9:00 AM–6:00 PM" doesn't fit, so the grid uses this
    // compact form ("9a-6p", "4:30p-2:30a") instead. The list below keeps
    // the normal 12-hour format since it has real room.
    function compactTime(t) {
      const [h, m] = t.split(':').map(Number);
      const period = h >= 12 ? 'p' : 'a';
      const hour = h % 12 || 12;
      return m === 0 ? `${hour}${period}` : `${hour}:${String(m).padStart(2, '0')}${period}`;
    }
    function compactTimeLabel(s) {
      if (s.start_time === '00:00' && s.end_time === '23:59') return t(lang, 'schedule.allDay');
      return `${compactTime(s.start_time)}-${compactTime(s.end_time)}`;
    }

    function renderPrintMonthGrid() {
      const el = document.getElementById('print-month-grid');
      if (!el) return;
      document.getElementById('print-period').textContent = formatDate(`${viewYear}-${String(viewMonth).padStart(2, '0')}-01`, { lang, monthYear: true });
      const cells = getMonthCells(viewYear, viewMonth);
      const mineByDate = new Map();
      for (const s of data.shifts) {
        if (s.user_id !== ctx.myUserId) continue;
        if (!mineByDate.has(s.date)) mineByDate.set(s.date, []);
        mineByDate.get(s.date).push(s);
      }
      const dayNames = [0, 1, 2, 3, 4, 5, 6].map((d) => new Date(2023, 0, 1 + d).toLocaleDateString(lang === 'es' ? 'es' : 'en-US', { weekday: 'short' }));
      const headRow = `<tr>${dayNames.map((d) => `<th>${escapeHtml(d)}</th>`).join('')}</tr>`;
      const bodyRows = [];
      for (let w = 0; w < cells.length / 7; w++) {
        const tds = cells.slice(w * 7, w * 7 + 7).map((c) => {
          const dayShifts = (mineByDate.get(c.iso) || []).slice().sort((a, b) => a.start_time.localeCompare(b.start_time));
          const lines = dayShifts.map((s) => `<span class="print-shift-line">${escapeHtml(compactTimeLabel(s))}</span>`).join('');
          const dayNum = parseInt(c.iso.slice(8, 10), 10);
          return `<td class="${c.other ? 'pd-other' : ''}"><span class="pd-num">${dayNum}</span>${lines}</td>`;
        }).join('');
        bodyRows.push(`<tr>${tds}</tr>`);
      }
      el.innerHTML = `<thead>${headRow}</thead><tbody>${bodyRows.join('')}</tbody>`;
    }

    function renderPrintList() {
      const rows = document.getElementById('print-shift-rows');
      if (!rows) return;
      renderPrintMonthGrid();
      const mine = data.shifts
        .filter((s) => s.user_id === ctx.myUserId && s.date >= today)
        .sort((a, b) => (a.date + a.start_time).localeCompare(b.date + b.start_time));
      document.getElementById('print-generated-at').textContent =
        t(lang, 'schedule.printGeneratedAt', { date: new Date().toLocaleDateString(lang === 'es' ? 'es' : 'en-US', { dateStyle: 'medium' }) });
      rows.innerHTML = mine.length === 0
        ? `<tr><td colspan="4">${t(lang, 'schedule.printNoShifts')}</td></tr>`
        : mine.map((s) => `<tr>
            <td>${formatDate(s.date, { lang })}</td>
            <td>${formatTime12(s.start_time)}</td>
            <td>${formatTime12(s.end_time)}</td>
            <td>${escapeHtml(s.notes || '')}</td>
          </tr>`).join('');
    }
    document.getElementById('print-btn').addEventListener('click', () => window.print());

    async function refreshAndRender() {
      await loadState();
      render();
      renderMyRequests();
      renderPrintList();
    }

    document.getElementById('ed-save').addEventListener('click', async () => {
      const payload = {
        user_id: document.getElementById('ed-user').value,
        date: document.getElementById('ed-date').value,
        start_time: document.getElementById('ed-start').value,
        end_time: document.getElementById('ed-end').value,
        notes: document.getElementById('ed-notes').value.trim() || null,
      };
      let r;
      if (ctx.canEdit) {
        r = editingShiftId
          ? await window.shawarmaApi('PATCH', `/api/shifts/${editingShiftId}`, payload)
          : await window.shawarmaApi('POST', '/api/shifts', payload);
      } else {
        r = await window.shawarmaApi('POST', '/api/shift-requests', {
          action: editingShiftId ? 'update' : 'create',
          shift_id: editingShiftId,
          ...payload,
        });
      }
      if (!r.ok) { window.shawarmaToast(r.error || t(lang, 'schedule.toastSaveFailed')); return; }
      window.shawarmaToast(ctx.canEdit
        ? (editingShiftId ? t(lang, 'schedule.toastShiftUpdated') : t(lang, 'schedule.toastShiftAdded'))
        : (editingShiftId ? t(lang, 'schedule.toastChangeRequested') : t(lang, 'schedule.toastAvailabilityShown')));
      closeEditor();
      await refreshAndRender();
    });

    document.getElementById('ed-delete').addEventListener('click', async () => {
      if (!editingShiftId) return;
      const confirmMsg = ctx.canEdit
        ? t(lang, 'schedule.confirmDeleteShift')
        : t(lang, 'schedule.confirmRequestRemoval');
      if (!confirm(confirmMsg)) return;
      const r = ctx.canEdit
        ? await window.shawarmaApi('DELETE', `/api/shifts/${editingShiftId}`)
        : await window.shawarmaApi('POST', '/api/shift-requests', { action: 'delete', shift_id: editingShiftId });
      if (!r.ok) { window.shawarmaToast(r.error || t(lang, 'common.failed')); return; }
      window.shawarmaToast(ctx.canEdit ? t(lang, 'schedule.toastShiftDeleted') : t(lang, 'schedule.toastRemovalRequested'));
      closeEditor();
      await refreshAndRender();
    });

    document.getElementById('editor-close').addEventListener('click', closeEditor);
    document.getElementById('modal-close').addEventListener('click', () => document.getElementById('day-modal').classList.remove('show'));
    document.getElementById('day-modal').addEventListener('click', (e) => {
      if (e.target.id === 'day-modal') e.target.classList.remove('show');
    });
    document.getElementById('editor-modal').addEventListener('click', (e) => {
      if (e.target.id === 'editor-modal') closeEditor();
    });

    document.querySelectorAll('#view-toggle button').forEach((b) => {
      b.addEventListener('click', () => {
        view = b.getAttribute('data-view');
        document.querySelectorAll('#view-toggle button').forEach((x) => x.classList.toggle('active', x === b));
        render();
      });
    });
    document.getElementById('prev-period').addEventListener('click', () => {
      if (view === 'day') {
        const d = new Date(viewYear, viewMonth - 1, viewDay); d.setDate(d.getDate() - 1);
        viewYear = d.getFullYear(); viewMonth = d.getMonth() + 1; viewDay = d.getDate();
      } else {
        viewMonth--; if (viewMonth < 1) { viewMonth = 12; viewYear--; }
      }
      render();
    });
    document.getElementById('next-period').addEventListener('click', () => {
      if (view === 'day') {
        const d = new Date(viewYear, viewMonth - 1, viewDay); d.setDate(d.getDate() + 1);
        viewYear = d.getFullYear(); viewMonth = d.getMonth() + 1; viewDay = d.getDate();
      } else {
        viewMonth++; if (viewMonth > 12) { viewMonth = 1; viewYear++; }
      }
      render();
    });

    if (ctx.canEdit) {
      document.getElementById('editor-staff-field').style.display = '';
    } else {
      document.getElementById('editor-staff-field').style.display = 'none';
    }

    function renderMyRequests() {
      const el = document.getElementById('my-requests');
      if (!el) return;
      const mine = (data.shiftRequests || [])
        .filter((r) => r.user_id === ctx.myUserId)
        .sort((a, b) => b.created_at.localeCompare(a.created_at));
      if (mine.length === 0) {
        el.innerHTML = `<p class="empty">${t(lang, 'schedule.nothingYet')}</p>`;
        return;
      }
      el.innerHTML = mine.map((r) => {
        const label = r.action === 'create' ? t(lang, 'schedule.labelAvailable') : r.action === 'delete' ? t(lang, 'schedule.labelRemoveShift') : t(lang, 'schedule.labelChangeShift');
        const isAllDay = r.start_time === '00:00' && r.end_time === '23:59';
        const timeText = isAllDay ? t(lang, 'schedule.allDay') : `${formatTime12(r.start_time)}–${formatTime12(r.end_time)}`;
        const detail = r.date ? `${formatDate(r.date, { short: true, lang })} · ${timeText}` : '';
        const denialHtml = r.status === 'denied' && r.denial_reason
          ? `<div class="meta" style="color:#991b1b;background:#fee2e2;padding:0.25rem 0.5rem;border-radius:0.25rem;margin-top:0.25rem;">${t(lang, 'common.adminSays')} ${escapeHtml(r.denial_reason)}</div>`
          : '';
        // Pending gets Cancel (withdraws it before anyone's decided);
        // denied gets an explicit acknowledge instead — the whole point is
        // making a person actively confirm they've seen why before it's
        // gone, rather than it just aging out silently, but it's still on
        // the person to actually click it (see the owner's ask: nothing
        // here blocks the rest of the page while an unacknowledged denial
        // sits there).
        const actionBtn = r.status === 'pending'
          ? `<button class="btn-danger" data-cancel-req="${r.id}">${t(lang, 'common.cancel')}</button>`
          : r.status === 'denied'
            ? `<button class="btn-secondary" data-ack-req="${r.id}">${CHECK_SVG} ${t(lang, 'schedule.acknowledge')}</button>`
            : '';
        return `<div class="list-item" style="align-items:flex-start;">
          <div>
            <div class="who">${label}</div>
            <div class="meta">${detail}</div>
            ${denialHtml}
          </div>
          <div style="display:flex;gap:0.375rem;align-items:center;">
            <span class="badge badge-${r.status}">${t(lang, `status.${r.status}`)}</span>
            ${actionBtn}
          </div>
        </div>`;
      }).join('');
      el.querySelectorAll('[data-cancel-req]').forEach((b) => {
        b.addEventListener('click', async () => {
          const r = await window.shawarmaApi('DELETE', `/api/shift-requests/${b.getAttribute('data-cancel-req')}`);
          if (!r.ok) { window.shawarmaToast(r.error || t(lang, 'common.failed')); return; }
          window.shawarmaToast(t(lang, 'schedule.toastRequestCancelled'));
          await refreshAndRender();
        });
      });
      el.querySelectorAll('[data-ack-req]').forEach((b) => {
        b.addEventListener('click', async () => {
          const r = await window.shawarmaApi('DELETE', `/api/shift-requests/${b.getAttribute('data-ack-req')}`);
          if (!r.ok) { window.shawarmaToast(r.error || t(lang, 'common.failed')); return; }
          await refreshAndRender();
        });
      });
    }

    refreshAndRender();
  </script>
</Layout>
