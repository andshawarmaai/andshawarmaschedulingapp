---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import LangToggle from '../components/LangToggle.astro';
import { getLang, t } from '../lib/i18n.js';
// middleware.js already redirects to "/" if a valid session cookie exists,
// so if we're rendering at all, the visitor is genuinely signed out. The
// language cookie works even signed out (see i18n.js) — someone who reads
// Spanish needs the login screen itself in Spanish before they can sign in.
const lang = getLang(Astro);
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="theme-color" content="#dc2626" />
  <title>{t(lang, 'login.title')} — &amp;Shawarma</title>
  <link rel="icon" type="image/jpeg" href="/logo.jpg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet" />
</head>
<body>
  <div class="login-wrap">
    <div class="login-card">
      <div style="display:flex;justify-content:flex-end;">
        <LangToggle lang={lang} />
      </div>
      <div class="login-header">
        <img src="/logo.jpg" alt="&Shawarma" />
        <h1 class="login-title">{t(lang, 'login.title')}</h1>
        <p class="login-sub">{t(lang, 'login.sub')}</p>
      </div>

      <div class="error" id="err" hidden>
        <Icon name="alert" size={16} />
        <span id="err-text"></span>
      </div>

      <form id="login-form" novalidate>
        <div class="field">
          <label for="username">{t(lang, 'login.username')}</label>
          <input type="text" id="username" name="username" class="input" autocomplete="username" required autofocus />
        </div>
        <div class="field">
          <label for="password">{t(lang, 'login.password')}</label>
          <input type="password" id="password" name="password" class="input" autocomplete="current-password" required />
          <p id="capslock-warning" class="error" hidden style="margin:0.5rem 0 0;">
            <Icon name="alert" size={14} /> <span>{t(lang, 'login.capsLock')}</span>
          </p>
        </div>
        <button type="submit" class="btn-primary btn-block" id="signin-btn">{t(lang, 'login.signIn')}</button>
      </form>

      <p style="text-align:center;margin-top:1rem;font-size:0.75rem;">
        <a href="#" id="forgot-link">{t(lang, 'login.forgot')}</a>
      </p>

      <div id="forgot-panel" hidden style="margin-top:0.75rem;padding-top:0.75rem;border-top:1px solid var(--color-border);">
        <label for="forgot-username">{t(lang, 'login.username')}</label>
        <input type="text" id="forgot-username" class="input" autocomplete="username" />
        <button type="button" class="btn-secondary btn-block" id="forgot-submit" style="margin-top:0.5rem;">{t(lang, 'login.notifyAdmin')}</button>
        <p id="forgot-status" class="card-sub" style="margin:0.5rem 0 0;text-align:center;"></p>
      </div>

      <p style="text-align:center;margin-top:1rem;font-size:0.75rem;color:var(--color-muted);">
        {t(lang, 'login.needAccess')}
      </p>
    </div>
  </div>

  <script define:vars={{ lang }}>
    window.__lang = lang;
  </script>
  <script>
    import { t } from '../lib/i18n.js';
    const lang = window.__lang;

    const form = document.getElementById('login-form');
    const errBox = document.getElementById('err');
    const errText = document.getElementById('err-text');
    const btn = document.getElementById('signin-btn');

    function showError(message) {
      errText.textContent = message;
      errBox.hidden = false;
    }
    function hideError() {
      errBox.hidden = true;
    }

    // Live Caps Lock warning while typing the password — the login is
    // genuinely case-sensitive, and this is the single most common reason
    // a correct password gets rejected.
    const passwordInput = document.getElementById('password');
    const capsWarning = document.getElementById('capslock-warning');
    function checkCapsLock(e) {
      if (typeof e.getModifierState !== 'function') return;
      capsWarning.hidden = !e.getModifierState('CapsLock');
    }
    passwordInput.addEventListener('keydown', checkCapsLock);
    passwordInput.addEventListener('keyup', checkCapsLock);
    passwordInput.addEventListener('blur', () => { capsWarning.hidden = true; });

    // "Forgot your password?" — there's no email sender configured, so this
    // files a request an admin sees on their dashboard instead of sending a
    // reset link. Always shows the same confirmation regardless of whether
    // the username exists, so this can't be used to probe valid usernames.
    const forgotLink = document.getElementById('forgot-link');
    const forgotPanel = document.getElementById('forgot-panel');
    const forgotStatus = document.getElementById('forgot-status');
    forgotLink.addEventListener('click', (e) => {
      e.preventDefault();
      forgotPanel.hidden = !forgotPanel.hidden;
      if (!forgotPanel.hidden) {
        document.getElementById('forgot-username').value = document.getElementById('username').value;
        document.getElementById('forgot-username').focus();
      }
    });
    document.getElementById('forgot-submit').addEventListener('click', async () => {
      const submitBtn = document.getElementById('forgot-submit');
      const username = document.getElementById('forgot-username').value.trim();
      if (!username) { forgotStatus.textContent = t(lang, 'login.errEnterUsername'); return; }
      submitBtn.disabled = true;
      try {
        const res = await fetch('/api/auth/request-password-reset', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username }),
        });
        const data = await res.json().catch(() => null);
        forgotStatus.textContent = (data && data.message) || 'Request submitted.';
      } catch {
        forgotStatus.textContent = t(lang, 'login.errNetworkForgot');
      } finally {
        submitBtn.disabled = false;
      }
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      hideError();

      const username = document.getElementById('username').value.trim();
      const password = document.getElementById('password').value;
      if (!username || !password) {
        showError(t(lang, 'login.errBoth'));
        return;
      }

      btn.disabled = true;
      btn.textContent = t(lang, 'login.signingIn');

      try {
        const res = await fetch('/api/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username, password }),
        });
        let data = null;
        try { data = await res.json(); } catch { /* no body */ }

        if (!res.ok) {
          showError((data && data.error) || t(lang, 'login.errFailed'));
          btn.disabled = false;
          btn.textContent = t(lang, 'login.signIn');
          document.getElementById('password').focus();
          return;
        }

        // Server set an httpOnly session cookie. A full navigation (not a
        // fetch) is what lets the browser send it back, so middleware.js can
        // verify it on the very next request and let us through.
        btn.textContent = t(lang, 'login.loading');
        window.location.href = '/';
      } catch (err) {
        showError(t(lang, 'login.errNetwork'));
        btn.disabled = false;
        btn.textContent = t(lang, 'login.signIn');
      }
    });
  </script>
</body>
</html>
