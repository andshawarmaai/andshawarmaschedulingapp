---
// Calendar of PENDING requests for managers/admins to decide on — every
// pending shift-create request and time-off request shows as a chip/bar,
// with a conflict flag computed from Shift Templates (Manage -> Shift
// Templates) when a shift's window is over-requested. Two views: Month
// (compact square tiles, the default — click a day to drill into it) and
// Day (a single day's actual timeline, Outlook/Project-style, sized to
// that business's actual template hours instead of a fixed 24h span so
// it doesn't read as one long undifferentiated scroll). Right-click a
// chip/bar to approve/deny; drag a shift one onto another day (or cell)
// to re-propose its date (still requires a separate approval).
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';
---
<AdminLayout title="&Shawarma — Schedule" active="schedule">
  <div class="card" style="margin-bottom:1rem;">
    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:0.75rem;">
      <div style="display:flex;align-items:center;gap:0.75rem;">
        <button class="btn-secondary" id="prev-btn" type="button">&larr; Prev</button>
        <h2 id="period-label" style="margin:0;">Loading...</h2>
        <button class="btn-secondary" id="next-btn" type="button">Next &rarr;</button>
      </div>
      <div class="view-toggle" id="view-toggle">
        <button type="button" data-view="month" class="active">Month</button>
        <button type="button" data-view="day">Day</button>
      </div>
    </div>
    <div style="display:flex;align-items:center;gap:1rem;font-size:0.8125rem;color:var(--color-muted);margin-top:0.5rem;flex-wrap:wrap;">
      <span><span class="legend-dot" style="background:#fff;border:1px solid var(--color-border);"></span> Pending</span>
      <span><span class="legend-dot" style="background:#fee2e2;border:1px solid #dc2626;"></span> Conflict</span>
      <span><span class="legend-dot" style="background:#e0e7ff;border:1px solid #6366f1;"></span> Time off</span>
    </div>
    <p class="card-sub" style="margin-top:0.5rem;">
      Right-click a chip/bar to approve or deny. Drag a shift request onto another day to re-propose
      its date — it stays pending either way, so nothing is approved just by moving it. In Month view,
      click a day (not a chip) to see it in detail.
    </p>
  </div>

  <div class="card" style="padding:0;overflow:hidden;">
    <div id="calendar-root"><p class="empty" style="padding:2rem;">Loading...</p></div>
  </div>

  <!-- Right-click context menu -->
  <div id="context-menu" class="context-menu" hidden>
    <button type="button" data-action="approve">Approve</button>
    <button type="button" data-action="deny">Deny</button>
  </div>

  <div class="card">
    <h2>Shift Templates</h2>
    <p class="card-sub">
      The recurring shift blocks this business runs every week (e.g. "Opener, 9am–3pm, Mon–Fri") —
      what the calendar above checks pending requests against. Give each one the days it applies to,
      a minimum staff count (a request that would drop a covered shift below this is flagged for
      review, never auto-denied) and/or a maximum (requests over this are flagged as a conflict
      above). For a one-off exception on a single date, use Slot Caps in Manage instead.
    </p>
    <button class="btn-primary" id="add-template-btn" type="button" style="margin-bottom:0.75rem;"><Icon name="plus" size={14} /> Add shift template</button>
    <div id="templates-list"><p class="empty">Loading...</p></div>
  </div>

  <!-- Add/edit shift template modal -->
  <div class="modal-backdrop" id="template-modal">
    <div class="modal">
      <div class="modal-header"><h2 id="template-modal-title">Add shift template</h2><button class="modal-close" id="template-modal-close" type="button">&times;</button></div>
      <div class="modal-body">
        <div class="field"><label>Name</label><input type="text" id="template-name" class="input" placeholder="e.g. Opener, Late night" /></div>
        <div class="field">
          <label>Days</label>
          <div id="template-days" style="display:flex;flex-wrap:wrap;gap:0.5rem;">
            {['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].map((label, i) => (
              <label style="display:flex;align-items:center;gap:0.25rem;font-weight:400;cursor:pointer;">
                <input type="checkbox" class="template-day" value={i} style="width:1rem;height:1rem;" /> {label}
              </label>
            ))}
          </div>
        </div>
        <div class="field"><label>Start time</label><input type="time" id="template-start" class="input" /></div>
        <div class="field">
          <label>End time</label>
          <input type="time" id="template-end" class="input" />
          <p class="card-sub" style="margin:0.25rem 0 0;">End before start is fine — it means the shift crosses midnight (e.g. 4:30pm–2:30am).</p>
        </div>
        <div class="field"><label>Minimum staff</label><input type="number" id="template-min-staff" class="input" min="0" step="1" placeholder="No minimum" /></div>
        <div class="field"><label>Maximum staff</label><input type="number" id="template-max-staff" class="input" min="0" step="1" placeholder="No maximum" /></div>
      </div>
      <div class="modal-footer">
        <button class="btn-danger" id="template-delete" style="margin-right:auto;" type="button" hidden>Delete template</button>
        <button class="btn-primary" id="template-save" type="button">Save</button>
      </div>
    </div>
  </div>

  <script>
    import { escapeHtml, formatTime12, getMonthCells } from '../../lib/client/format.js';
    import { computeShiftRequestConflicts } from '../../lib/client/coverage.js';

    const REM_PER_HOUR = 2.5;

    function toMinutes(hhmm) {
      const [h, m] = hhmm.split(':').map(Number);
      return h * 60 + m;
    }

    // The day-view timeline's vertical span is sized to this business's
    // actual Shift Templates (earliest start to latest wrapped end, +1hr
    // padding each side) instead of a fixed 24h band, so a business with
    // tight hours gets a short, quick-to-read day view instead of one
    // long mostly-empty scroll. Falls back to a sensible 8a-midnight
    // window before any templates exist.
    function computeWindow(templates) {
      if (!templates.length) return { startMin: 8 * 60, windowMin: 16 * 60 };
      let minStart = Infinity;
      let maxEnd = -Infinity;
      for (const t of templates) {
        const s = toMinutes(t.start_time);
        let e = toMinutes(t.end_time);
        if (e <= s) e += 24 * 60;
        minStart = Math.min(minStart, s);
        maxEnd = Math.max(maxEnd, e);
      }
      const startMin = Math.max(0, Math.floor(minStart / 60) * 60 - 60);
      const windowMin = Math.min(24 * 60, Math.ceil((maxEnd - startMin) / 60) * 60 + 60);
      return { startMin, windowMin };
    }

    function toDisplayMinutes(raw, startMin) {
      const shifted = raw - startMin;
      return shifted < 0 ? shifted + 24 * 60 : shifted;
    }
    function displayRange(startTime, endTime, startMin) {
      const s = toMinutes(startTime);
      let e = toMinutes(endTime);
      if (e <= s) e += 24 * 60;
      const displayStart = toDisplayMinutes(s, startMin);
      return [displayStart, displayStart + (e - s)];
    }

    // Classic calendar-event column packing (the same shape Outlook/Google
    // Calendar use): overlapping bars split the available width between
    // them instead of stacking on top of each other.
    function packOverlaps(items) {
      const sorted = [...items].sort((a, b) => a.start - b.start || a.end - b.end);
      const active = []; // { end, col }
      const results = [];
      let cluster = [];
      let clusterCols = 0;

      const flush = () => {
        for (const it of cluster) it.cols = clusterCols || 1;
        results.push(...cluster);
        cluster = [];
        clusterCols = 0;
      };

      for (const item of sorted) {
        for (let i = active.length - 1; i >= 0; i--) {
          if (active[i].end <= item.start) active.splice(i, 1);
        }
        if (active.length === 0) flush();
        const usedCols = new Set(active.map((a) => a.col));
        let col = 0;
        while (usedCols.has(col)) col++;
        active.push({ end: item.end, col });
        clusterCols = Math.max(clusterCols, col + 1);
        cluster.push({ ...item, col });
      }
      flush();
      return results;
    }

    let data = null;
    let view = 'month';
    let anchor = new Date(); // month view: its month matters; day view: the exact date matters
    anchor.setHours(0, 0, 0, 0);
    let editingTemplateId = null;

    function isoOf(d) { return d.toISOString().slice(0, 10); }

    async function loadState() {
      const res = await fetch('/api/state');
      data = await res.json();
    }

    function userName(id) {
      const u = (data.users || []).find((x) => x.id === id);
      return u ? u.display_name : 'Unknown';
    }

    function chipHtml(kind, id, label, flagged, note) {
      const cls = kind === 'timeoff' ? 'timeoff-chip' : 'req-chip';
      const draggable = kind === 'shift' ? 'true' : 'false';
      return `<div class="${cls}${flagged ? ' flagged' : ''}" draggable="${draggable}" data-kind="${kind}" data-id="${id}" title="${escapeHtml(note || '')}">${escapeHtml(label)}${flagged ? ' ⚠' : ''}</div>`;
    }

    function renderMonth() {
      const year = anchor.getFullYear();
      const month = anchor.getMonth() + 1;
      document.getElementById('period-label').textContent = anchor.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });

      const todayIso = isoOf(new Date());
      const pendingShiftReqs = (data.shiftRequests || []).filter((r) => r.status === 'pending' && r.action === 'create');
      const pendingTimeOff = (data.timeOffAll || []).filter((t) => t.status === 'pending');
      const conflicts = computeShiftRequestConflicts(data.shiftTemplates || [], data.shifts || [], data.shiftRequests || []);

      const cells = getMonthCells(year, month);
      const head = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].map((d) => `<div class="cal-month-head">${d}</div>`).join('');
      const body = cells.map((c) => {
        const shiftChips = pendingShiftReqs.filter((r) => r.date === c.iso).map((r) =>
          chipHtml('shift', r.id, `${userName(r.user_id)} ${formatTime12(r.start_time)}`, conflicts.has(r.id), conflicts.get(r.id))
        );
        const toChips = pendingTimeOff.filter((t) => c.iso >= t.start_date && c.iso <= t.end_date).map((t) =>
          chipHtml('timeoff', t.id, `${userName(t.user_id)} off`, !!t.staffing_warning, t.staffing_warning)
        );
        return `<div class="cal-month-cell${c.other ? ' other-month' : ''}${c.iso === todayIso ? ' today' : ''}" data-date="${c.iso}">
          <span class="cal-month-daynum">${parseInt(c.iso.slice(8, 10), 10)}</span>
          <div class="cal-month-chips">${toChips.join('')}${shiftChips.join('')}</div>
        </div>`;
      }).join('');

      document.getElementById('calendar-root').innerHTML = `<div class="cal-month-grid">${head}${body}</div>`;
      wireMonthInteractions(pendingShiftReqs);
    }

    function renderDay() {
      const iso = isoOf(anchor);
      document.getElementById('period-label').textContent = anchor.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' });

      const pendingShiftReqs = (data.shiftRequests || []).filter((r) => r.status === 'pending' && r.action === 'create');
      const pendingTimeOff = (data.timeOffAll || []).filter((t) => t.status === 'pending');
      const conflicts = computeShiftRequestConflicts(data.shiftTemplates || [], data.shifts || [], data.shiftRequests || []);
      const { startMin, windowMin } = computeWindow(data.shiftTemplates || []);

      const toEntries = pendingTimeOff.filter((t) => iso >= t.start_date && iso <= t.end_date);
      const toChips = toEntries.map((t) => chipHtml('timeoff', t.id, userName(t.user_id), !!t.staffing_warning, t.staffing_warning)).join('');

      const hourLabels = [];
      for (let m = 0; m <= windowMin; m += 60) {
        const hour24 = Math.floor((startMin + m) / 60) % 24;
        const label = hour24 === 0 ? '12a' : hour24 < 12 ? `${hour24}a` : hour24 === 12 ? '12p' : `${hour24 - 12}p`;
        const top = (m / windowMin) * 100;
        hourLabels.push(`<div class="cal-hour-label" style="top:${top}%;">${label}</div>`);
        hourLabels.push(`<div class="cal-hour-line" style="top:${top}%;"></div>`);
      }

      const reqs = pendingShiftReqs.filter((r) => r.date === iso);
      const items = reqs.map((r) => {
        const [dispStart, dispEnd] = displayRange(r.start_time, r.end_time, startMin);
        return { start: dispStart, end: Math.min(dispEnd, windowMin), req: r };
      });
      const packed = packOverlaps(items);
      const bars = packed.map(({ start, end, col, cols, req: r }) => {
        const top = Math.max(0, (start / windowMin) * 100);
        const height = Math.max(3, ((end - start) / windowMin) * 100);
        const widthPct = 100 / cols;
        const leftPct = col * widthPct;
        const conflictNote = conflicts.get(r.id);
        return `
          <div class="req-bar${conflictNote ? ' flagged' : ''}" draggable="true"
               data-kind="shift" data-id="${r.id}"
               style="top:${top}%;height:${height}%;left:calc(${leftPct}% + 0.125rem);width:calc(${widthPct}% - 0.25rem);">
            <span class="who">${escapeHtml(userName(r.user_id))}${conflictNote ? ' ⚠' : ''}</span>
            <span class="when">${formatTime12(r.start_time)}–${formatTime12(r.end_time)}</span>
            ${conflictNote ? `<span class="flag-note">${escapeHtml(conflictNote)}</span>` : ''}
          </div>
        `;
      }).join('');

      document.getElementById('calendar-root').innerHTML = `
        <div class="cal-timeoff-row" style="grid-template-columns:3.5rem 1fr;">
          <div class="cal-timeoff-label">Time off</div>
          <div class="cal-timeoff-cell" data-date="${iso}">${toChips}</div>
        </div>
        <div class="cal-day-body">
          <div class="cal-hours">${hourLabels.join('')}</div>
          <div class="cal-day-col" data-date="${iso}" style="height:${(windowMin / 60) * REM_PER_HOUR}rem;">${bars}</div>
        </div>
      `;
      wireDayInteractions(pendingShiftReqs);
    }

    function render() {
      if (view === 'month') renderMonth();
      else renderDay();
    }

    let contextTarget = null; // { kind, id }

    function closeContextMenu() {
      document.getElementById('context-menu').hidden = true;
      contextTarget = null;
    }
    function openContextMenu(x, y, kind, id) {
      contextTarget = { kind, id };
      const menu = document.getElementById('context-menu');
      menu.style.left = `${x}px`;
      menu.style.top = `${y}px`;
      menu.hidden = false;
    }

    function wireContextMenus(root) {
      root.querySelectorAll('[data-kind]').forEach((el) => {
        el.addEventListener('contextmenu', (e) => {
          e.preventDefault();
          e.stopPropagation();
          openContextMenu(e.clientX, e.clientY, el.getAttribute('data-kind'), el.getAttribute('data-id'));
        });
      });
    }

    function wireDragDrop(root, pendingShiftReqs, dropTargetSelector) {
      root.querySelectorAll('.req-chip[draggable="true"], .req-bar[draggable="true"]').forEach((el) => {
        el.addEventListener('dragstart', (e) => {
          e.stopPropagation();
          e.dataTransfer.setData('text/plain', el.getAttribute('data-id'));
          e.dataTransfer.effectAllowed = 'move';
        });
      });
      root.querySelectorAll(dropTargetSelector).forEach((target) => {
        target.addEventListener('dragover', (e) => {
          e.preventDefault();
          target.classList.add('drag-over');
        });
        target.addEventListener('dragleave', () => target.classList.remove('drag-over'));
        target.addEventListener('drop', async (e) => {
          e.preventDefault();
          target.classList.remove('drag-over');
          const reqId = e.dataTransfer.getData('text/plain');
          const targetDate = target.getAttribute('data-date');
          const req = pendingShiftReqs.find((r) => r.id === reqId);
          if (!req || req.date === targetDate) return;
          const r = await window.shawarmaApi('PATCH', `/api/shift-requests/${reqId}`, { date: targetDate });
          if (!r.ok) { window.shawarmaToast(r.error || 'Could not move request'); return; }
          window.shawarmaToast(`Moved to ${targetDate} — still pending`);
          await refreshAndRender();
        });
      });
    }

    function wireMonthInteractions(pendingShiftReqs) {
      const root = document.getElementById('calendar-root');
      wireContextMenus(root);
      wireDragDrop(root, pendingShiftReqs, '.cal-month-cell');
      root.querySelectorAll('.cal-month-cell').forEach((cell) => {
        cell.addEventListener('click', (e) => {
          if (e.target.closest('[data-kind]')) return; // chip clicks don't drill in
          anchor = new Date(`${cell.getAttribute('data-date')}T00:00:00`);
          view = 'day';
          document.querySelectorAll('#view-toggle button').forEach((b) => b.classList.toggle('active', b.dataset.view === 'day'));
          render();
        });
      });
    }

    function wireDayInteractions(pendingShiftReqs) {
      const root = document.getElementById('calendar-root');
      wireContextMenus(root);
      wireDragDrop(root, pendingShiftReqs, '.cal-day-col');
    }

    document.getElementById('context-menu').addEventListener('click', async (e) => {
      const action = e.target.getAttribute('data-action');
      if (!action || !contextTarget) return;
      const { kind, id } = contextTarget;
      closeContextMenu();

      if (action === 'deny') {
        const reason = prompt('Why are you denying this request? (shown to the staff member)');
        if (reason === null) return;
        const url = kind === 'timeoff' ? `/api/timeoff/${id}` : `/api/shift-requests/${id}`;
        const r = await window.shawarmaApi('PATCH', url, { status: 'denied', denial_reason: reason || 'No reason given' });
        window.shawarmaToast(r.ok ? 'Denied' : (r.error || 'Failed'));
        await refreshAndRender();
        return;
      }

      const url = kind === 'timeoff' ? `/api/timeoff/${id}` : `/api/shift-requests/${id}`;
      const r = await window.shawarmaApi('PATCH', url, { status: 'approved' });
      window.shawarmaToast(r.ok ? 'Approved' : (r.error || 'Failed'));
      await refreshAndRender();
    });
    document.addEventListener('click', (e) => {
      if (!e.target.closest('#context-menu')) closeContextMenu();
    });

    document.querySelectorAll('#view-toggle button').forEach((b) => {
      b.addEventListener('click', () => {
        view = b.dataset.view;
        document.querySelectorAll('#view-toggle button').forEach((x) => x.classList.toggle('active', x === b));
        render();
      });
    });
    document.getElementById('prev-btn').addEventListener('click', () => {
      if (view === 'month') anchor.setMonth(anchor.getMonth() - 1);
      else anchor.setDate(anchor.getDate() - 1);
      render();
    });
    document.getElementById('next-btn').addEventListener('click', () => {
      if (view === 'month') anchor.setMonth(anchor.getMonth() + 1);
      else anchor.setDate(anchor.getDate() + 1);
      render();
    });

    // ----- Shift templates (recurring coverage blocks the calendar checks against) -----

    const DAY_LABELS = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];

    function renderTemplates() {
      const el = document.getElementById('templates-list');
      const templates = data.shiftTemplates || [];
      if (templates.length === 0) {
        el.innerHTML = '<p class="empty">No shift templates yet.</p>';
        return;
      }
      el.innerHTML = templates.map((t) => {
        const days = t.days_of_week.split(',').map((d) => DAY_LABELS[Number(d)]).join(', ');
        const staff = [
          t.min_staff != null ? `min ${t.min_staff}` : null,
          t.max_staff != null ? `max ${t.max_staff}` : null,
        ].filter(Boolean).join(' · ') || 'no min/max set';
        return `
        <div class="list-item">
          <div>
            <div class="who">${escapeHtml(t.name)}</div>
            <div class="meta">${days} · ${formatTime12(t.start_time)}–${formatTime12(t.end_time)} · ${staff}</div>
          </div>
          <button class="btn-secondary" data-edit-template="${t.id}">Edit</button>
        </div>
      `;
      }).join('');
      el.querySelectorAll('[data-edit-template]').forEach((b) => {
        b.addEventListener('click', () => openTemplateModal(b.getAttribute('data-edit-template')));
      });
    }

    function openTemplateModal(templateId) {
      editingTemplateId = templateId || null;
      const template = templateId ? (data.shiftTemplates || []).find((t) => t.id === templateId) : null;
      document.getElementById('template-modal-title').textContent = template ? `Edit: ${template.name}` : 'Add shift template';
      document.getElementById('template-name').value = template ? template.name : '';
      const checkedDays = template ? template.days_of_week.split(',') : [];
      document.querySelectorAll('.template-day').forEach((cb) => {
        cb.checked = checkedDays.includes(cb.value);
      });
      document.getElementById('template-start').value = template ? template.start_time : '';
      document.getElementById('template-end').value = template ? template.end_time : '';
      document.getElementById('template-min-staff').value = template && template.min_staff != null ? template.min_staff : '';
      document.getElementById('template-max-staff').value = template && template.max_staff != null ? template.max_staff : '';
      document.getElementById('template-delete').hidden = !template;
      document.getElementById('template-modal').classList.add('show');
    }

    document.getElementById('add-template-btn').addEventListener('click', () => openTemplateModal(null));
    document.getElementById('template-modal-close').addEventListener('click', () => {
      document.getElementById('template-modal').classList.remove('show');
      editingTemplateId = null;
    });
    document.getElementById('template-save').addEventListener('click', async () => {
      const days_of_week = [...document.querySelectorAll('.template-day:checked')].map((cb) => cb.value);
      const payload = {
        name: document.getElementById('template-name').value.trim(),
        days_of_week,
        start_time: document.getElementById('template-start').value,
        end_time: document.getElementById('template-end').value,
        min_staff: document.getElementById('template-min-staff').value.trim(),
        max_staff: document.getElementById('template-max-staff').value.trim(),
      };
      if (!payload.name) { window.shawarmaToast('Name is required'); return; }
      if (days_of_week.length === 0) { window.shawarmaToast('Pick at least one day'); return; }
      if (!payload.start_time || !payload.end_time) { window.shawarmaToast('Start and end time are required'); return; }
      const url = editingTemplateId ? `/api/admin/shift-templates/${editingTemplateId}` : '/api/admin/shift-templates';
      const r = await window.shawarmaApi(editingTemplateId ? 'PATCH' : 'POST', url, payload);
      if (!r.ok) { window.shawarmaToast(r.error || 'Could not save shift template'); return; }
      document.getElementById('template-modal').classList.remove('show');
      window.shawarmaToast('Shift template saved');
      editingTemplateId = null;
      await refreshAndRender();
    });
    document.getElementById('template-delete').addEventListener('click', async () => {
      const template = (data.shiftTemplates || []).find((t) => t.id === editingTemplateId);
      if (!template || !confirm(`Delete "${template.name}"?`)) return;
      const r = await window.shawarmaApi('DELETE', `/api/admin/shift-templates/${editingTemplateId}`);
      if (!r.ok) { window.shawarmaToast(r.error || 'Delete failed'); return; }
      document.getElementById('template-modal').classList.remove('show');
      window.shawarmaToast('Shift template deleted');
      editingTemplateId = null;
      await refreshAndRender();
    });

    async function refreshAndRender() {
      await loadState();
      render();
      renderTemplates();
    }

    refreshAndRender();
  </script>
</AdminLayout>
