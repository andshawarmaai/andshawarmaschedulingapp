---
// The full schedule, editable only here: pending shift-create requests,
// pending AND approved time-off, and already-approved/actual shifts
// (data.shifts) all show as chips/bars, with a conflict flag computed
// from Shift Templates (Manage -> Shift Templates) when a window is
// over-scheduled — whether that's from pending requests, approved shifts,
// or both together. Three views: Month (compact square tiles, the
// default — click a day to drill into it), Week, and Day (a real
// timeline, Outlook/Project-style, sized to that business's actual
// template hours instead of a fixed 24h span so it doesn't read as one
// long undifferentiated scroll). This is the ONLY place anyone
// approves/denies a request, reschedules a shift, or removes an
// already-approved time-off block — staff never get approve/deny
// controls, they only submit availability (see schedule.astro), and the
// plain staff schedule page is deliberately read-only for time off (an
// admin who wants to undo an approved one has to come here, not edit it
// from wherever they happen to be looking — one place, not two). Right-
// click a pending item to approve/deny, or an approved shift/time-off to
// remove it; drag a shift or pending request (not time off — it spans a
// date range, not a single day) onto another day to move it
// (admin/manager-only since this whole route is gated that way by
// middleware.js).
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';
---
<AdminLayout title="&Shawarma — Schedule" active="schedule">
  <div class="card no-print" style="margin-bottom:1rem;">
    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:0.75rem;">
      <div style="display:flex;align-items:center;gap:0.75rem;">
        <button class="btn-secondary" id="prev-btn" type="button">&larr; Prev</button>
        <h2 id="period-label" style="margin:0;">Loading...</h2>
        <button class="btn-secondary" id="next-btn" type="button">Next &rarr;</button>
      </div>
      <div class="view-toggle" id="view-toggle">
        <button type="button" data-view="month" class="active">Month</button>
        <button type="button" data-view="week">Week</button>
        <button type="button" data-view="day">Day</button>
      </div>
    </div>
    <div style="display:flex;align-items:center;gap:1rem;font-size:0.8125rem;color:var(--color-muted);margin-top:0.5rem;flex-wrap:wrap;">
      <span><span class="legend-dot" style="background:#fff;border:1px solid var(--color-border);"></span> Pending</span>
      <span><span class="legend-dot" style="background:#dcfce7;border:1px solid #16a34a;"></span> Scheduled</span>
      <span><span class="legend-dot" style="background:#fee2e2;border:1px solid #dc2626;"></span> Conflict</span>
      <span><span class="legend-dot" style="background:#e0e7ff;border:1px solid #6366f1;"></span> Time off (pending)</span>
      <span><span class="legend-dot" style="background:#6366f1;border:1px solid #4338ca;"></span> Time off (approved)</span>
    </div>
    <div style="display:flex;align-items:center;gap:0.5rem;margin-top:0.75rem;flex-wrap:wrap;">
      <button class="btn-secondary" id="help-btn" type="button">❓ How to use this</button>
      <button class="btn-secondary" id="export-btn" type="button">⬇️ Export to spreadsheet</button>
      <button class="btn-secondary" id="cal-print-btn" type="button">🖨️ Print / Save as PDF</button>
    </div>
  </div>

  <!-- Collapsible help — a popup instead of a permanent wall of text on the
       page. Same info as before, just in a list and out of the way until
       asked for. -->
  <div class="modal-backdrop" id="help-modal">
    <div class="modal">
      <div class="modal-header"><h2>How to use this calendar</h2><button class="modal-close" id="help-close" type="button">&times;</button></div>
      <div class="modal-body">
        <ul class="help-list">
          <li><strong>Click</strong> a scheduled (green) shift to edit its time, assigned staff, or notes — or use its Delete button there to remove it.</li>
          <li><strong>Drag</strong> a scheduled shift or a pending request for a quick date-only move (not time off — it spans a date range, not one day). A dragged pending request stays pending; nothing is approved just by moving it.</li>
          <li><strong>Right-click</strong> a pending request or time off to approve or deny it.</li>
          <li><strong>Right-click</strong> a scheduled shift or approved (solid indigo) time off to remove it instantly, no dialog.</li>
          <li>In <strong>Month</strong> view, click a day (not a chip) to see it in Day view.</li>
          <li>Hover a day in Month, or a day header in Week, for a <strong>"+"</strong> to add a brand-new shift. Day view has an always-visible "+ Add shift" button instead.</li>
          <li>This is the <strong>only</strong> place approved time off can be removed — the Time Off page only ever shows pending items to review.</li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Print/Save-as-PDF only: see .print-only in global.css. -->
  <div class="print-only" id="cal-print-header">
    <h1 style="margin-bottom:0.25rem;">Schedule</h1>
    <p id="cal-print-generated-at" style="margin:0 0 1rem;color:#555;font-size:0.8125rem;"></p>
  </div>

  <div class="card cal-scroll" style="padding:0;">
    <div id="calendar-root"><p class="empty" style="padding:2rem;">Loading...</p></div>
  </div>

  <!-- Right-click context menu -->
  <div id="context-menu" class="context-menu" hidden>
    <button type="button" data-action="approve">Approve</button>
    <button type="button" data-action="deny">Deny</button>
    <button type="button" data-action="delete">Remove from schedule</button>
  </div>

  <!-- Add OR edit a shift directly — opened either via the "+" that appears
       hovering a Month cell / Week day header / Day's toolbar (add, no
       shiftId), or by clicking an already-scheduled (green) chip/bar
       (edit, shiftId set — see openShiftModal). Dragging still handles a
       quick date-only move; this is for changing the time, the assigned
       staff, or notes on an existing shift, or adding a brand new one
       without waiting on someone's submitted availability. -->
  <div class="modal-backdrop" id="add-shift-modal">
    <div class="modal">
      <div class="modal-header"><h2 id="as-title">Add shift</h2><button class="modal-close" id="add-shift-close" type="button">&times;</button></div>
      <div class="modal-body">
        <div class="field"><label>Staff</label><select id="as-user" class="input"></select></div>
        <div class="field"><label>Date</label><input type="date" id="as-date" class="input" /></div>
        <div class="field"><label>Start time</label><input type="time" id="as-start" class="input" value="11:00" /></div>
        <div class="field"><label>End time</label><input type="time" id="as-end" class="input" value="19:00" /></div>
        <div class="field"><label>Notes</label><input type="text" id="as-notes" class="input" placeholder="Optional" /></div>
      </div>
      <div class="modal-footer">
        <button class="btn-danger" id="as-delete" style="margin-right:auto;" type="button" hidden>Delete</button>
        <button class="btn-primary" id="as-save" type="button">Save</button>
      </div>
    </div>
  </div>

  <div class="card">
    <h2>Shift Templates</h2>
    <p class="card-sub">
      The recurring shift blocks this business runs every week (e.g. "Opener, 9am–3pm, Mon–Fri") —
      what the calendar above checks pending requests against. Give each one the days it applies to,
      a minimum staff count (a request that would drop a covered shift below this is flagged for
      review, never auto-denied) and/or a maximum (requests over this are flagged as a conflict
      above). For a one-off exception on a single date, use Slot Caps in Manage instead.
    </p>
    <button class="btn-primary" id="add-template-btn" type="button" style="margin-bottom:0.75rem;"><Icon name="plus" size={14} /> Add shift template</button>
    <div id="templates-list"><p class="empty">Loading...</p></div>
  </div>

  <!-- Add/edit shift template modal -->
  <div class="modal-backdrop" id="template-modal">
    <div class="modal">
      <div class="modal-header"><h2 id="template-modal-title">Add shift template</h2><button class="modal-close" id="template-modal-close" type="button">&times;</button></div>
      <div class="modal-body">
        <div class="field"><label>Name</label><input type="text" id="template-name" class="input" placeholder="e.g. Opener, Late night" /></div>
        <div class="field">
          <label>Days</label>
          <div id="template-days" style="display:flex;flex-wrap:wrap;gap:0.5rem;">
            {['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].map((label, i) => (
              <label style="display:flex;align-items:center;gap:0.25rem;font-weight:400;cursor:pointer;">
                <input type="checkbox" class="template-day" value={i} style="width:1rem;height:1rem;" /> {label}
              </label>
            ))}
          </div>
        </div>
        <div class="field"><label>Start time</label><input type="time" id="template-start" class="input" /></div>
        <div class="field">
          <label>End time</label>
          <input type="time" id="template-end" class="input" />
          <p class="card-sub" style="margin:0.25rem 0 0;">End before start is fine — it means the shift crosses midnight (e.g. 4:30pm–2:30am).</p>
        </div>
        <div class="field"><label>Minimum staff</label><input type="number" id="template-min-staff" class="input" min="0" step="1" placeholder="No minimum" /></div>
        <div class="field"><label>Maximum staff</label><input type="number" id="template-max-staff" class="input" min="0" step="1" placeholder="No maximum" /></div>
      </div>
      <div class="modal-footer">
        <button class="btn-danger" id="template-delete" style="margin-right:auto;" type="button" hidden>Delete template</button>
        <button class="btn-primary" id="template-save" type="button">Save</button>
      </div>
    </div>
  </div>

  <script>
    import { escapeHtml, formatTime12, getMonthCells } from '../../lib/client/format.js';
    import { computeShiftRequestConflicts } from '../../lib/client/coverage.js';

    const REM_PER_HOUR = 2.5;

    function toMinutes(hhmm) {
      const [h, m] = hhmm.split(':').map(Number);
      return h * 60 + m;
    }

    // The day-view timeline's vertical span is sized to this business's
    // actual Shift Templates (earliest start to latest wrapped end, +1hr
    // padding each side) instead of a fixed 24h band, so a business with
    // tight hours gets a short, quick-to-read day view instead of one
    // long mostly-empty scroll. Falls back to a sensible 8a-midnight
    // window before any templates exist.
    function computeWindow(templates) {
      if (!templates.length) return { startMin: 8 * 60, windowMin: 16 * 60 };
      let minStart = Infinity;
      let maxEnd = -Infinity;
      for (const t of templates) {
        const s = toMinutes(t.start_time);
        let e = toMinutes(t.end_time);
        if (e <= s) e += 24 * 60;
        minStart = Math.min(minStart, s);
        maxEnd = Math.max(maxEnd, e);
      }
      const startMin = Math.max(0, Math.floor(minStart / 60) * 60 - 60);
      const windowMin = Math.min(24 * 60, Math.ceil((maxEnd - startMin) / 60) * 60 + 60);
      return { startMin, windowMin };
    }

    // Staff mark "Available all day" as 00:00-23:59 (see schedule.astro's
    // editor) — shown as a plain "All day" label rather than the literal,
    // slightly odd-looking 12:00 AM-11:59 PM.
    function timeLabel(r) {
      if (r.start_time === '00:00' && r.end_time === '23:59') return 'All day';
      return `${formatTime12(r.start_time)}–${formatTime12(r.end_time)}`;
    }

    function toDisplayMinutes(raw, startMin) {
      const shifted = raw - startMin;
      return shifted < 0 ? shifted + 24 * 60 : shifted;
    }
    function displayRange(startTime, endTime, startMin) {
      const s = toMinutes(startTime);
      let e = toMinutes(endTime);
      if (e <= s) e += 24 * 60;
      const displayStart = toDisplayMinutes(s, startMin);
      return [displayStart, displayStart + (e - s)];
    }

    // Classic calendar-event column packing (the same shape Outlook/Google
    // Calendar use): overlapping bars split the available width between
    // them instead of stacking on top of each other.
    function packOverlaps(items) {
      const sorted = [...items].sort((a, b) => a.start - b.start || a.end - b.end);
      const active = []; // { end, col }
      const results = [];
      let cluster = [];
      let clusterCols = 0;

      const flush = () => {
        for (const it of cluster) it.cols = clusterCols || 1;
        results.push(...cluster);
        cluster = [];
        clusterCols = 0;
      };

      for (const item of sorted) {
        for (let i = active.length - 1; i >= 0; i--) {
          if (active[i].end <= item.start) active.splice(i, 1);
        }
        if (active.length === 0) flush();
        const usedCols = new Set(active.map((a) => a.col));
        let col = 0;
        while (usedCols.has(col)) col++;
        active.push({ end: item.end, col });
        clusterCols = Math.max(clusterCols, col + 1);
        cluster.push({ ...item, col });
      }
      flush();
      return results;
    }

    let data = null;
    let view = 'month';
    let anchor = new Date(); // month view: its month matters; day view: the exact date matters
    anchor.setHours(0, 0, 0, 0);
    let editingTemplateId = null;
    let editingShiftId = null;

    function isoOf(d) { return d.toISOString().slice(0, 10); }

    function startOfWeek(d) {
      const x = new Date(d);
      x.setDate(x.getDate() - x.getDay());
      x.setHours(0, 0, 0, 0);
      return x;
    }

    async function loadState() {
      const res = await fetch('/api/state');
      data = await res.json();
    }

    function userName(id) {
      const u = (data.users || []).find((x) => x.id === id);
      return u ? u.display_name : 'Unknown';
    }

    function chipHtml(kind, id, label, flagged, note) {
      const isTimeOff = kind === 'timeoff' || kind === 'timeoff-approved';
      const cls = isTimeOff ? 'timeoff-chip' : kind === 'shift-approved' ? 'shift-chip' : 'req-chip';
      const approvedCls = kind === 'timeoff-approved' ? ' approved' : '';
      const draggable = kind === 'shift-pending' || kind === 'shift-approved' ? 'true' : 'false';
      const hint = kind === 'shift-approved' ? 'Click to edit, drag to move' : '';
      const title = escapeHtml(note || hint || '');
      return `<div class="${cls}${approvedCls}${flagged ? ' flagged' : ''}" draggable="${draggable}" data-kind="${kind}" data-id="${id}" title="${title}">${escapeHtml(label)}${flagged ? ' ⚠' : ''}</div>`;
    }

    function barHtml(kind, id, label, when, top, height, leftPct, widthPct, flagged, note) {
      const cls = kind === 'shift-approved' ? 'shift-bar' : 'req-bar';
      const hint = kind === 'shift-approved' ? 'Click to edit, drag to move' : '';
      return `
        <div class="${cls}${flagged ? ' flagged' : ''}" draggable="true"
             data-kind="${kind}" data-id="${id}" title="${escapeHtml(note || hint || '')}"
             style="top:${top}%;height:${height}%;left:calc(${leftPct}% + 0.125rem);width:calc(${widthPct}% - 0.25rem);">
          <span class="who">${escapeHtml(label)}${flagged ? ' ⚠' : ''}</span>
          <span class="when">${escapeHtml(when)}</span>
          ${note ? `<span class="flag-note">${escapeHtml(note)}</span>` : ''}
        </div>
      `;
    }

    // Packs a single day's approved shifts + pending requests into
    // side-by-side columns and renders them as absolutely-positioned bars
    // against a timeline `windowMin` minutes tall starting at `startMin`.
    // Shared by Day and Week views so their bars behave identically.
    function dayBarsHtml(iso, shifts, pendingShiftReqs, conflicts, startMin, windowMin) {
      const items = [
        ...shifts.filter((s) => s.date === iso).map((row) => ({ kind: 'shift-approved', row })),
        ...pendingShiftReqs.filter((r) => r.date === iso).map((row) => ({ kind: 'shift-pending', row })),
      ].map(({ kind, row }) => {
        const [dispStart, dispEnd] = displayRange(row.start_time, row.end_time, startMin);
        return { start: dispStart, end: Math.min(dispEnd, windowMin), kind, row };
      });
      const packed = packOverlaps(items);
      return packed.map(({ start, end, col, cols, kind, row }) => {
        const top = Math.max(0, (start / windowMin) * 100);
        const height = Math.max(3, ((end - start) / windowMin) * 100);
        const widthPct = 100 / cols;
        const leftPct = col * widthPct;
        const conflictNote = conflicts.get(row.id);
        return barHtml(kind, row.id, userName(row.user_id), timeLabel(row), top, height, leftPct, widthPct, !!conflictNote, conflictNote);
      }).join('');
    }

    function renderMonth() {
      const year = anchor.getFullYear();
      const month = anchor.getMonth() + 1;
      document.getElementById('period-label').textContent = anchor.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });

      const todayIso = isoOf(new Date());
      const pendingShiftReqs = (data.shiftRequests || []).filter((r) => r.status === 'pending' && r.action === 'create');
      const pendingTimeOff = (data.timeOffAll || []).filter((t) => t.status === 'pending');
      const approvedTimeOff = (data.timeOffAll || []).filter((t) => t.status === 'approved');
      const shifts = data.shifts || [];
      const conflicts = computeShiftRequestConflicts(data.shiftTemplates || [], shifts, data.shiftRequests || []);

      const cells = getMonthCells(year, month);
      const head = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].map((d) => `<div class="cal-month-head">${d}</div>`).join('');
      const body = cells.map((c) => {
        const scheduledChips = shifts.filter((s) => s.date === c.iso).map((s) =>
          chipHtml('shift-approved', s.id, `${userName(s.user_id)} ${timeLabel(s)}`, conflicts.has(s.id), conflicts.get(s.id))
        );
        const pendingChips = pendingShiftReqs.filter((r) => r.date === c.iso).map((r) =>
          chipHtml('shift-pending', r.id, `${userName(r.user_id)} ${timeLabel(r)}`, conflicts.has(r.id), conflicts.get(r.id))
        );
        const toChips = pendingTimeOff.filter((t) => c.iso >= t.start_date && c.iso <= t.end_date).map((t) =>
          chipHtml('timeoff', t.id, `${userName(t.user_id)} off`, !!t.staffing_warning, t.staffing_warning)
        );
        const approvedToChips = approvedTimeOff.filter((t) => c.iso >= t.start_date && c.iso <= t.end_date).map((t) =>
          chipHtml('timeoff-approved', t.id, `${userName(t.user_id)} off`, !!t.staffing_warning, t.staffing_warning)
        );
        return `<div class="cal-month-cell${c.other ? ' other-month' : ''}${c.iso === todayIso ? ' today' : ''}" data-date="${c.iso}">
          <span class="cal-month-daynum">${parseInt(c.iso.slice(8, 10), 10)}</span>
          <button type="button" class="cal-add-btn" data-add-date="${c.iso}" title="Add shift" aria-label="Add shift">+</button>
          <div class="cal-month-chips">${approvedToChips.join('')}${toChips.join('')}${scheduledChips.join('')}${pendingChips.join('')}</div>
        </div>`;
      }).join('');

      document.getElementById('calendar-root').innerHTML = `<div class="cal-month-grid">${head}${body}</div>`;
      wireMonthInteractions();
    }

    function renderWeek() {
      const weekStart = startOfWeek(anchor);
      const days = [...Array(7)].map((_, i) => {
        const d = new Date(weekStart);
        d.setDate(d.getDate() + i);
        return d;
      });
      const todayIso = isoOf(new Date());
      const startLabel = days[0].toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
      const endLabel = days[6].toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
      document.getElementById('period-label').textContent = `${startLabel} – ${endLabel}`;

      const pendingShiftReqs = (data.shiftRequests || []).filter((r) => r.status === 'pending' && r.action === 'create');
      const pendingTimeOff = (data.timeOffAll || []).filter((t) => t.status === 'pending');
      const approvedTimeOff = (data.timeOffAll || []).filter((t) => t.status === 'approved');
      const shifts = data.shifts || [];
      const conflicts = computeShiftRequestConflicts(data.shiftTemplates || [], shifts, data.shiftRequests || []);
      const { startMin, windowMin } = computeWindow(data.shiftTemplates || []);

      const hourLabels = [];
      for (let m = 0; m <= windowMin; m += 60) {
        const hour24 = Math.floor((startMin + m) / 60) % 24;
        const label = hour24 === 0 ? '12a' : hour24 < 12 ? `${hour24}a` : hour24 === 12 ? '12p' : `${hour24 - 12}p`;
        const top = (m / windowMin) * 100;
        hourLabels.push(`<div class="cal-hour-label" style="top:${top}%;">${label}</div>`);
        hourLabels.push(`<div class="cal-hour-line" style="top:${top}%;"></div>`);
      }

      const headCells = days.map((d) => {
        const iso = isoOf(d);
        return `<div class="cal-week-headcell${iso === todayIso ? ' today' : ''}">
          ${d.toLocaleDateString('en-US', { weekday: 'short' })}<span class="num">${d.getDate()}</span>
          <button type="button" class="cal-add-btn" data-add-date="${iso}" title="Add shift" aria-label="Add shift">+</button>
        </div>`;
      }).join('');

      const toCells = days.map((d) => {
        const iso = isoOf(d);
        const approvedEntries = approvedTimeOff.filter((t) => iso >= t.start_date && iso <= t.end_date);
        const entries = pendingTimeOff.filter((t) => iso >= t.start_date && iso <= t.end_date);
        const chips = [
          ...approvedEntries.map((t) => chipHtml('timeoff-approved', t.id, userName(t.user_id), !!t.staffing_warning, t.staffing_warning)),
          ...entries.map((t) => chipHtml('timeoff', t.id, userName(t.user_id), !!t.staffing_warning, t.staffing_warning)),
        ].join('');
        return `<div class="cal-timeoff-cell" data-date="${iso}">${chips}</div>`;
      }).join('');

      const dayCols = days.map((d) => {
        const iso = isoOf(d);
        const bars = dayBarsHtml(iso, shifts, pendingShiftReqs, conflicts, startMin, windowMin);
        return `<div class="cal-day-col" data-date="${iso}" style="height:${(windowMin / 60) * REM_PER_HOUR}rem;">${bars}</div>`;
      }).join('');

      document.getElementById('calendar-root').innerHTML = `
        <div class="cal-week-head-row">
          <div class="cal-week-head-spacer"></div>
          ${headCells}
        </div>
        <div class="cal-timeoff-row" style="grid-template-columns:3.5rem repeat(7,minmax(6rem,1fr));min-width:45.5rem;">
          <div class="cal-timeoff-label">Time off</div>
          ${toCells}
        </div>
        <div class="cal-week-body">
          <div class="cal-hours">${hourLabels.join('')}</div>
          <div class="cal-week-days">${dayCols}</div>
        </div>
      `;
      wireWeekInteractions();
    }

    function renderDay() {
      const iso = isoOf(anchor);
      document.getElementById('period-label').textContent = anchor.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' });

      const pendingShiftReqs = (data.shiftRequests || []).filter((r) => r.status === 'pending' && r.action === 'create');
      const pendingTimeOff = (data.timeOffAll || []).filter((t) => t.status === 'pending');
      const approvedTimeOff = (data.timeOffAll || []).filter((t) => t.status === 'approved');
      const shifts = data.shifts || [];
      const conflicts = computeShiftRequestConflicts(data.shiftTemplates || [], shifts, data.shiftRequests || []);
      const { startMin, windowMin } = computeWindow(data.shiftTemplates || []);

      const toEntries = pendingTimeOff.filter((t) => iso >= t.start_date && iso <= t.end_date);
      const approvedToEntries = approvedTimeOff.filter((t) => iso >= t.start_date && iso <= t.end_date);
      const toChips = [
        ...approvedToEntries.map((t) => chipHtml('timeoff-approved', t.id, userName(t.user_id), !!t.staffing_warning, t.staffing_warning)),
        ...toEntries.map((t) => chipHtml('timeoff', t.id, userName(t.user_id), !!t.staffing_warning, t.staffing_warning)),
      ].join('');

      const hourLabels = [];
      for (let m = 0; m <= windowMin; m += 60) {
        const hour24 = Math.floor((startMin + m) / 60) % 24;
        const label = hour24 === 0 ? '12a' : hour24 < 12 ? `${hour24}a` : hour24 === 12 ? '12p' : `${hour24 - 12}p`;
        const top = (m / windowMin) * 100;
        hourLabels.push(`<div class="cal-hour-label" style="top:${top}%;">${label}</div>`);
        hourLabels.push(`<div class="cal-hour-line" style="top:${top}%;"></div>`);
      }

      const bars = dayBarsHtml(iso, shifts, pendingShiftReqs, conflicts, startMin, windowMin);

      document.getElementById('calendar-root').innerHTML = `
        <div class="cal-day-toolbar">
          <button type="button" class="btn-primary cal-add-btn-inline" data-add-date="${iso}">+ Add shift</button>
        </div>
        <div class="cal-timeoff-row" style="grid-template-columns:3.5rem 1fr;">
          <div class="cal-timeoff-label">Time off</div>
          <div class="cal-timeoff-cell" data-date="${iso}">${toChips}</div>
        </div>
        <div class="cal-day-body">
          <div class="cal-hours">${hourLabels.join('')}</div>
          <div class="cal-day-col" data-date="${iso}" style="height:${(windowMin / 60) * REM_PER_HOUR}rem;">${bars}</div>
        </div>
      `;
      wireDayInteractions();
    }

    function render() {
      if (view === 'month') renderMonth();
      else if (view === 'week') renderWeek();
      else renderDay();
    }

    let contextTarget = null; // { kind, id }

    function closeContextMenu() {
      document.getElementById('context-menu').hidden = true;
      contextTarget = null;
    }
    function openContextMenu(x, y, kind, id) {
      contextTarget = { kind, id };
      const menu = document.getElementById('context-menu');
      const isApproved = kind === 'shift-approved' || kind === 'timeoff-approved';
      menu.querySelector('[data-action="approve"]').hidden = isApproved;
      menu.querySelector('[data-action="deny"]').hidden = isApproved;
      menu.querySelector('[data-action="delete"]').hidden = !isApproved;
      menu.style.left = `${x}px`;
      menu.style.top = `${y}px`;
      menu.hidden = false;
    }

    function wireContextMenus(root) {
      root.querySelectorAll('[data-kind]').forEach((el) => {
        el.addEventListener('contextmenu', (e) => {
          e.preventDefault();
          e.stopPropagation();
          openContextMenu(e.clientX, e.clientY, el.getAttribute('data-kind'), el.getAttribute('data-id'));
        });
      });
    }

    function wireDragDrop(root, dropTargetSelector) {
      root.querySelectorAll('.req-chip[draggable="true"], .req-bar[draggable="true"], .shift-chip[draggable="true"], .shift-bar[draggable="true"]').forEach((el) => {
        el.addEventListener('dragstart', (e) => {
          e.stopPropagation();
          e.dataTransfer.setData('text/plain', el.getAttribute('data-id'));
          e.dataTransfer.setData('application/x-kind', el.getAttribute('data-kind'));
          e.dataTransfer.effectAllowed = 'move';
        });
      });
      root.querySelectorAll(dropTargetSelector).forEach((target) => {
        target.addEventListener('dragover', (e) => {
          e.preventDefault();
          target.classList.add('drag-over');
        });
        target.addEventListener('dragleave', () => target.classList.remove('drag-over'));
        target.addEventListener('drop', async (e) => {
          e.preventDefault();
          target.classList.remove('drag-over');
          const id = e.dataTransfer.getData('text/plain');
          const kind = e.dataTransfer.getData('application/x-kind');
          const targetDate = target.getAttribute('data-date');

          if (kind === 'shift-approved') {
            const shift = (data.shifts || []).find((s) => s.id === id);
            if (!shift || shift.date === targetDate) return;
            const r = await window.shawarmaApi('PATCH', `/api/shifts/${id}`, { date: targetDate });
            if (!r.ok) { window.shawarmaToast(r.error || 'Could not move shift'); return; }
            window.shawarmaToast(`Moved to ${targetDate}`);
            await refreshAndRender();
            return;
          }

          const req = (data.shiftRequests || []).find((r) => r.id === id);
          if (!req || req.date === targetDate) return;
          const r = await window.shawarmaApi('PATCH', `/api/shift-requests/${id}`, { date: targetDate });
          if (!r.ok) { window.shawarmaToast(r.error || 'Could not move request'); return; }
          window.shawarmaToast(`Moved to ${targetDate} — still pending`);
          await refreshAndRender();
        });
      });
    }

    // Shared by all three views — every "+" (hover-revealed on a Month
    // cell or Week day header, always-visible in Day view's toolbar)
    // opens the same Add Shift modal, prefilled with whatever date it
    // was attached to.
    function wireAddButtons(root) {
      root.querySelectorAll('[data-add-date]').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          openAddShiftModal(btn.getAttribute('data-add-date'));
        });
      });
    }

    // Clicking an already-scheduled (green) chip/bar opens it for editing
    // (time, assigned staff, notes) — dragging still handles a quick
    // date-only move, and a completed drag never also fires this click
    // (native HTML5 drag suppresses the click on its source element), so
    // the two don't fight each other.
    function wireShiftEditClicks(root) {
      root.querySelectorAll('[data-kind="shift-approved"]').forEach((el) => {
        el.addEventListener('click', (e) => {
          e.stopPropagation();
          openEditShiftModal(el.getAttribute('data-id'));
        });
      });
    }

    function wireMonthInteractions() {
      const root = document.getElementById('calendar-root');
      wireContextMenus(root);
      wireAddButtons(root);
      wireShiftEditClicks(root);
      wireDragDrop(root, '.cal-month-cell');
      root.querySelectorAll('.cal-month-cell').forEach((cell) => {
        cell.addEventListener('click', (e) => {
          if (e.target.closest('[data-kind]') || e.target.closest('.cal-add-btn')) return; // chip/add clicks don't drill in
          anchor = new Date(`${cell.getAttribute('data-date')}T00:00:00`);
          view = 'day';
          document.querySelectorAll('#view-toggle button').forEach((b) => b.classList.toggle('active', b.dataset.view === 'day'));
          render();
        });
      });
    }

    function wireWeekInteractions() {
      const root = document.getElementById('calendar-root');
      wireContextMenus(root);
      wireAddButtons(root);
      wireShiftEditClicks(root);
      wireDragDrop(root, '.cal-week-days .cal-day-col');
    }

    function wireDayInteractions() {
      const root = document.getElementById('calendar-root');
      wireContextMenus(root);
      wireAddButtons(root);
      wireShiftEditClicks(root);
      wireDragDrop(root, '.cal-day-col');
    }

    document.getElementById('context-menu').addEventListener('click', async (e) => {
      const action = e.target.getAttribute('data-action');
      if (!action || !contextTarget) return;
      const { kind, id } = contextTarget;
      closeContextMenu();

      if (action === 'delete') {
        const isTimeOff = kind === 'timeoff-approved';
        if (!confirm(isTimeOff ? 'Remove this time off from the schedule?' : 'Remove this shift from the schedule?')) return;
        const url = isTimeOff ? `/api/timeoff/${id}` : `/api/shifts/${id}`;
        const r = await window.shawarmaApi('DELETE', url);
        window.shawarmaToast(r.ok ? 'Removed from schedule' : (r.error || 'Failed'));
        await refreshAndRender();
        return;
      }

      if (action === 'deny') {
        const reason = prompt('Why are you denying this request? (shown to the staff member)');
        if (reason === null) return;
        const url = kind === 'timeoff' ? `/api/timeoff/${id}` : `/api/shift-requests/${id}`;
        const r = await window.shawarmaApi('PATCH', url, { status: 'denied', denial_reason: reason || 'No reason given' });
        window.shawarmaToast(r.ok ? 'Denied' : (r.error || 'Failed'));
        await refreshAndRender();
        return;
      }

      const url = kind === 'timeoff' ? `/api/timeoff/${id}` : `/api/shift-requests/${id}`;
      const r = await window.shawarmaApi('PATCH', url, { status: 'approved' });
      window.shawarmaToast(r.ok ? 'Approved' : (r.error || 'Failed'));
      await refreshAndRender();
    });
    document.addEventListener('click', (e) => {
      if (!e.target.closest('#context-menu')) closeContextMenu();
    });

    document.querySelectorAll('#view-toggle button').forEach((b) => {
      b.addEventListener('click', () => {
        view = b.dataset.view;
        document.querySelectorAll('#view-toggle button').forEach((x) => x.classList.toggle('active', x === b));
        render();
      });
    });
    document.getElementById('prev-btn').addEventListener('click', () => {
      if (view === 'month') anchor.setMonth(anchor.getMonth() - 1);
      else if (view === 'week') anchor.setDate(anchor.getDate() - 7);
      else anchor.setDate(anchor.getDate() - 1);
      render();
    });
    document.getElementById('next-btn').addEventListener('click', () => {
      if (view === 'month') anchor.setMonth(anchor.getMonth() + 1);
      else if (view === 'week') anchor.setDate(anchor.getDate() + 7);
      else anchor.setDate(anchor.getDate() + 1);
      render();
    });

    // ----- Shift templates (recurring coverage blocks the calendar checks against) -----

    const DAY_LABELS = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];

    function renderTemplates() {
      const el = document.getElementById('templates-list');
      const templates = data.shiftTemplates || [];
      if (templates.length === 0) {
        el.innerHTML = '<p class="empty">No shift templates yet.</p>';
        return;
      }
      el.innerHTML = templates.map((t) => {
        const days = t.days_of_week.split(',').map((d) => DAY_LABELS[Number(d)]).join(', ');
        const staff = [
          t.min_staff != null ? `min ${t.min_staff}` : null,
          t.max_staff != null ? `max ${t.max_staff}` : null,
        ].filter(Boolean).join(' · ') || 'no min/max set';
        return `
        <div class="list-item">
          <div>
            <div class="who">${escapeHtml(t.name)}</div>
            <div class="meta">${days} · ${formatTime12(t.start_time)}–${formatTime12(t.end_time)} · ${staff}</div>
          </div>
          <button class="btn-secondary" data-edit-template="${t.id}">Edit</button>
        </div>
      `;
      }).join('');
      el.querySelectorAll('[data-edit-template]').forEach((b) => {
        b.addEventListener('click', () => openTemplateModal(b.getAttribute('data-edit-template')));
      });
    }

    function openTemplateModal(templateId) {
      editingTemplateId = templateId || null;
      const template = templateId ? (data.shiftTemplates || []).find((t) => t.id === templateId) : null;
      document.getElementById('template-modal-title').textContent = template ? `Edit: ${template.name}` : 'Add shift template';
      document.getElementById('template-name').value = template ? template.name : '';
      const checkedDays = template ? template.days_of_week.split(',') : [];
      document.querySelectorAll('.template-day').forEach((cb) => {
        cb.checked = checkedDays.includes(cb.value);
      });
      document.getElementById('template-start').value = template ? template.start_time : '';
      document.getElementById('template-end').value = template ? template.end_time : '';
      document.getElementById('template-min-staff').value = template && template.min_staff != null ? template.min_staff : '';
      document.getElementById('template-max-staff').value = template && template.max_staff != null ? template.max_staff : '';
      document.getElementById('template-delete').hidden = !template;
      document.getElementById('template-modal').classList.add('show');
    }

    document.getElementById('add-template-btn').addEventListener('click', () => openTemplateModal(null));
    document.getElementById('template-modal-close').addEventListener('click', () => {
      document.getElementById('template-modal').classList.remove('show');
      editingTemplateId = null;
    });
    document.getElementById('template-save').addEventListener('click', async () => {
      const days_of_week = [...document.querySelectorAll('.template-day:checked')].map((cb) => cb.value);
      const payload = {
        name: document.getElementById('template-name').value.trim(),
        days_of_week,
        start_time: document.getElementById('template-start').value,
        end_time: document.getElementById('template-end').value,
        min_staff: document.getElementById('template-min-staff').value.trim(),
        max_staff: document.getElementById('template-max-staff').value.trim(),
      };
      if (!payload.name) { window.shawarmaToast('Name is required'); return; }
      if (days_of_week.length === 0) { window.shawarmaToast('Pick at least one day'); return; }
      if (!payload.start_time || !payload.end_time) { window.shawarmaToast('Start and end time are required'); return; }
      const url = editingTemplateId ? `/api/admin/shift-templates/${editingTemplateId}` : '/api/admin/shift-templates';
      const r = await window.shawarmaApi(editingTemplateId ? 'PATCH' : 'POST', url, payload);
      if (!r.ok) { window.shawarmaToast(r.error || 'Could not save shift template'); return; }
      document.getElementById('template-modal').classList.remove('show');
      window.shawarmaToast('Shift template saved');
      editingTemplateId = null;
      await refreshAndRender();
    });
    document.getElementById('template-delete').addEventListener('click', async () => {
      const template = (data.shiftTemplates || []).find((t) => t.id === editingTemplateId);
      if (!template || !confirm(`Delete "${template.name}"?`)) return;
      const r = await window.shawarmaApi('DELETE', `/api/admin/shift-templates/${editingTemplateId}`);
      if (!r.ok) { window.shawarmaToast(r.error || 'Delete failed'); return; }
      document.getElementById('template-modal').classList.remove('show');
      window.shawarmaToast('Shift template deleted');
      editingTemplateId = null;
      await refreshAndRender();
    });

    // ----- Add OR edit a shift (the "+" on a Month/Week cell, Day's toolbar
    // button, or clicking an already-scheduled chip/bar) -----

    function openAddShiftModal(iso) {
      editingShiftId = null;
      document.getElementById('as-title').textContent = 'Add shift';
      document.getElementById('as-delete').hidden = true;
      const userSelect = document.getElementById('as-user');
      userSelect.innerHTML = (data.users || []).filter((u) => !u.disabled).map((u) =>
        `<option value="${u.id}">${escapeHtml(u.display_name)}</option>`
      ).join('');
      document.getElementById('as-date').value = iso;
      document.getElementById('as-start').value = '11:00';
      document.getElementById('as-end').value = '19:00';
      document.getElementById('as-notes').value = '';
      document.getElementById('add-shift-modal').classList.add('show');
    }

    function openEditShiftModal(shiftId) {
      const shift = (data.shifts || []).find((s) => s.id === shiftId);
      if (!shift) return;
      editingShiftId = shiftId;
      document.getElementById('as-title').textContent = 'Edit shift';
      document.getElementById('as-delete').hidden = false;
      const userSelect = document.getElementById('as-user');
      userSelect.innerHTML = (data.users || []).filter((u) => !u.disabled).map((u) =>
        `<option value="${u.id}" ${u.id === shift.user_id ? 'selected' : ''}>${escapeHtml(u.display_name)}</option>`
      ).join('');
      document.getElementById('as-date').value = shift.date;
      document.getElementById('as-start').value = shift.start_time;
      document.getElementById('as-end').value = shift.end_time;
      document.getElementById('as-notes').value = shift.notes || '';
      document.getElementById('add-shift-modal').classList.add('show');
    }

    document.getElementById('add-shift-close').addEventListener('click', () => {
      document.getElementById('add-shift-modal').classList.remove('show');
      editingShiftId = null;
    });
    document.getElementById('add-shift-modal').addEventListener('click', (e) => {
      if (e.target.id === 'add-shift-modal') { e.target.classList.remove('show'); editingShiftId = null; }
    });
    document.getElementById('as-save').addEventListener('click', async () => {
      const payload = {
        user_id: document.getElementById('as-user').value,
        date: document.getElementById('as-date').value,
        start_time: document.getElementById('as-start').value,
        end_time: document.getElementById('as-end').value,
        notes: document.getElementById('as-notes').value.trim() || null,
      };
      if (!payload.date || !payload.start_time || !payload.end_time) {
        window.shawarmaToast('Date, start time, and end time are required');
        return;
      }
      const r = editingShiftId
        ? await window.shawarmaApi('PATCH', `/api/shifts/${editingShiftId}`, payload)
        : await window.shawarmaApi('POST', '/api/shifts', payload);
      if (!r.ok) { window.shawarmaToast(r.error || (editingShiftId ? 'Could not update shift' : 'Could not add shift')); return; }
      document.getElementById('add-shift-modal').classList.remove('show');
      window.shawarmaToast(editingShiftId ? 'Shift updated' : 'Shift added');
      editingShiftId = null;
      await refreshAndRender();
    });
    document.getElementById('as-delete').addEventListener('click', async () => {
      if (!editingShiftId) return;
      if (!confirm('Remove this shift from the schedule?')) return;
      const r = await window.shawarmaApi('DELETE', `/api/shifts/${editingShiftId}`);
      if (!r.ok) { window.shawarmaToast(r.error || 'Failed'); return; }
      document.getElementById('add-shift-modal').classList.remove('show');
      window.shawarmaToast('Removed from schedule');
      editingShiftId = null;
      await refreshAndRender();
    });

    // ----- Help popup -----
    document.getElementById('help-btn').addEventListener('click', () => {
      document.getElementById('help-modal').classList.add('show');
    });
    document.getElementById('help-close').addEventListener('click', () => {
      document.getElementById('help-modal').classList.remove('show');
    });
    document.getElementById('help-modal').addEventListener('click', (e) => {
      if (e.target.id === 'help-modal') e.target.classList.remove('show');
    });

    // ----- Print / Save as PDF (native browser print — see .print-only in global.css) -----
    document.getElementById('cal-print-btn').addEventListener('click', () => {
      document.getElementById('cal-print-generated-at').textContent =
        `${document.getElementById('period-label').textContent} — generated ${new Date().toLocaleDateString('en-US', { dateStyle: 'medium' })}`;
      window.print();
    });

    // ----- Export to spreadsheet (CSV) — a backup of the durable schedule
    // data (shifts, day caps, shift templates), in exactly the row shape
    // /api/public/shift-imports and /api/admin/shift-imports accept, so
    // the same file can be re-imported later if this ever needs restoring.
    // Deliberately excludes pending requests/time-off and swap posts —
    // those are in-flight workflow state, not durable schedule structure,
    // and there's no import row type that recreates a *pending* item
    // anyway (type=shift always creates a live, approved shift). -----
    function csvField(v) {
      const s = String(v ?? '');
      return /[",\n]/.test(s) ? '"' + s.replace(/"/g, '""') + '"' : s;
    }
    function csvRow(fields) {
      return fields.map(csvField).join(',');
    }
    function buildExportCsv() {
      const users = data.users || [];
      const usernameFor = (id) => { const u = users.find((x) => x.id === id); return u ? u.username : ''; };
      const rows = [csvRow(['type', 'username', 'name', 'date', 'start_time', 'end_time', 'days_of_week', 'min_staff', 'max_staff', 'window_start', 'window_end', 'max_shifts', 'notes'])];
      for (const s of (data.shifts || [])) {
        rows.push(csvRow(['shift', usernameFor(s.user_id), '', s.date, s.start_time, s.end_time, '', '', '', '', '', '', s.notes || '']));
      }
      for (const c of (data.dayCaps || [])) {
        rows.push(csvRow(['cap', '', '', c.date, '', '', '', '', '', c.window_start, c.window_end, c.max_shifts, c.note || '']));
      }
      for (const tpl of (data.shiftTemplates || [])) {
        rows.push(csvRow(['template', '', tpl.name, '', tpl.start_time, tpl.end_time, tpl.days_of_week.split(',').join(' '), tpl.min_staff ?? '', tpl.max_staff ?? '', '', '', '', '']));
      }
      return rows.join('\n') + '\n';
    }
    document.getElementById('export-btn').addEventListener('click', () => {
      const csv = buildExportCsv();
      const stamp = new Date().toISOString().slice(0, 10);
      const blob = new Blob([csv], { type: 'text/csv;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `shawarma-schedule-export-${stamp}.csv`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
      window.shawarmaToast('Exported — this file can be re-imported later from Manage → Bulk Schedule Import');
    });

    async function refreshAndRender() {
      await loadState();
      render();
      renderTemplates();
    }

    refreshAndRender();
  </script>
</AdminLayout>
