---
// Week-view calendar of PENDING requests for managers/admins to decide on
// — every pending shift-create request and time-off request shows as a
// bar positioned by its actual time, with a conflict flag computed from
// Shift Templates (Manage -> Shift Templates) when a shift's window is
// over-requested. Right-click a bar to approve/deny; drag a shift bar to
// a different day to re-propose its date (still requires a separate
// approval — dragging never approves anything by itself).
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="&Shawarma — Schedule" active="schedule">
  <div class="card" style="margin-bottom:1rem;">
    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:0.75rem;">
      <div style="display:flex;align-items:center;gap:0.75rem;">
        <button class="btn-secondary" id="prev-week" type="button">&larr; Prev</button>
        <h2 id="week-label" style="margin:0;">Loading...</h2>
        <button class="btn-secondary" id="next-week" type="button">Next &rarr;</button>
      </div>
      <div style="display:flex;align-items:center;gap:1rem;font-size:0.8125rem;color:var(--color-muted);">
        <span><span class="legend-dot" style="background:#fff;border:1px solid var(--color-border);"></span> Pending</span>
        <span><span class="legend-dot" style="background:#fef3c7;border:1px solid #f59e0b;"></span> Conflict</span>
        <span><span class="legend-dot" style="background:#e0e7ff;border:1px solid #6366f1;"></span> Time off</span>
      </div>
    </div>
    <p class="card-sub" style="margin-top:0.5rem;">
      Right-click a bar to approve or deny. Drag a shift bar onto another day to re-propose its date —
      it stays pending either way, so nothing is approved just by moving it.
    </p>
  </div>

  <div class="card" style="padding:0;overflow:hidden;">
    <div id="calendar-root"><p class="empty" style="padding:2rem;">Loading...</p></div>
  </div>

  <!-- Right-click context menu -->
  <div id="context-menu" class="context-menu" hidden>
    <button type="button" data-action="approve">Approve</button>
    <button type="button" data-action="deny">Deny</button>
  </div>

  <script>
    import { escapeHtml, formatTime12 } from '../../lib/client/format.js';
    import { computeShiftRequestConflicts } from '../../lib/client/coverage.js';

    // Display window: 6:00 AM to 6:00 AM the next day (24h), so an
    // overnight shift (e.g. 4:30pm-2:30am) renders as one continuous bar
    // instead of being split at midnight. See coverage.js for the same
    // wraparound convention used server-side.
    const DAY_START_MIN = 6 * 60;
    const WINDOW_MIN = 24 * 60;

    function toMinutes(hhmm) {
      const [h, m] = hhmm.split(':').map(Number);
      return h * 60 + m;
    }
    function toDisplayMinutes(raw) {
      const shifted = raw - DAY_START_MIN;
      return shifted < 0 ? shifted + 24 * 60 : shifted;
    }
    // Returns [displayStart, displayEnd] (end may exceed WINDOW_MIN by a
    // little for a shift starting just before 6am — clamped on render).
    function displayRange(startTime, endTime) {
      const s = toMinutes(startTime);
      let e = toMinutes(endTime);
      if (e <= s) e += 24 * 60;
      const displayStart = toDisplayMinutes(s);
      return [displayStart, displayStart + (e - s)];
    }

    // Classic calendar-event column packing (the same shape Outlook/Google
    // Calendar use): overlapping bars split the day column's width between
    // them instead of stacking on top of each other. Items in the same
    // touching-overlap cluster all share one column count, even if a
    // later item in the cluster doesn't overlap an earlier one directly —
    // that's the standard, simple version of this algorithm, not a
    // perfect minimum-width packing.
    function packOverlaps(items) {
      const sorted = [...items].sort((a, b) => a.start - b.start || a.end - b.end);
      const active = []; // { end, col }
      const results = [];
      let cluster = [];
      let clusterCols = 0;

      const flush = () => {
        for (const it of cluster) it.cols = clusterCols || 1;
        results.push(...cluster);
        cluster = [];
        clusterCols = 0;
      };

      for (const item of sorted) {
        for (let i = active.length - 1; i >= 0; i--) {
          if (active[i].end <= item.start) active.splice(i, 1);
        }
        if (active.length === 0) flush();
        const usedCols = new Set(active.map((a) => a.col));
        let col = 0;
        while (usedCols.has(col)) col++;
        active.push({ end: item.end, col });
        clusterCols = Math.max(clusterCols, col + 1);
        cluster.push({ ...item, col });
      }
      flush();
      return results;
    }

    let data = null;
    let weekStart = null; // Date object, a Sunday

    function startOfWeek(d) {
      const x = new Date(d);
      x.setDate(x.getDate() - x.getDay());
      x.setHours(0, 0, 0, 0);
      return x;
    }
    function isoOf(d) { return d.toISOString().slice(0, 10); }

    async function loadState() {
      const res = await fetch('/api/state');
      data = await res.json();
    }

    function userName(id) {
      const u = (data.users || []).find((x) => x.id === id);
      return u ? u.display_name : 'Unknown';
    }

    function render() {
      const days = [];
      for (let i = 0; i < 7; i++) {
        const d = new Date(weekStart);
        d.setDate(d.getDate() + i);
        days.push(d);
      }
      const todayIso = new Date().toISOString().slice(0, 10);
      document.getElementById('week-label').textContent =
        `${days[0].toLocaleDateString('en-US', { month: 'short', day: 'numeric' })} – ${days[6].toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}`;

      const pendingShiftReqs = (data.shiftRequests || []).filter((r) => r.status === 'pending' && r.action === 'create');
      const pendingTimeOff = (data.timeOffAll || []).filter((t) => t.status === 'pending');
      const conflicts = computeShiftRequestConflicts(data.shiftTemplates || [], data.shifts || [], data.shiftRequests || []);

      const root = document.getElementById('calendar-root');

      const headCells = days.map((d) => {
        const iso = isoOf(d);
        const label = d.toLocaleDateString('en-US', { weekday: 'short' });
        const num = d.getDate();
        return `<div class="cal-head-cell${iso === todayIso ? ' today' : ''}">${label}<span class="num">${num}</span></div>`;
      }).join('');

      const timeoffCells = days.map((d) => {
        const iso = isoOf(d);
        const entries = pendingTimeOff.filter((t) => iso >= t.start_date && iso <= t.end_date);
        const chips = entries.map((t) => `
          <div class="timeoff-chip${t.staffing_warning ? ' flagged' : ''}" draggable="false"
               data-kind="timeoff" data-id="${t.id}"
               title="${escapeHtml(t.staffing_warning || '')}">
            ${escapeHtml(userName(t.user_id))}${t.staffing_warning ? ' ⚠' : ''}
          </div>
        `).join('');
        return `<div class="cal-timeoff-cell" data-date="${iso}">${chips}</div>`;
      }).join('');

      // Hour gutter + gridlines, 6a..6a next day.
      const hourLabels = [];
      for (let h = 0; h <= 24; h += 3) {
        const displayMin = h * 60;
        const hour24 = (DAY_START_MIN / 60 + h) % 24;
        const label = hour24 === 0 ? '12a' : hour24 < 12 ? `${hour24}a` : hour24 === 12 ? '12p' : `${hour24 - 12}p`;
        hourLabels.push(`<div class="cal-hour-label" style="top:${(displayMin / WINDOW_MIN) * 100}%;">${label}</div>`);
        hourLabels.push(`<div class="cal-hour-line" style="top:${(displayMin / WINDOW_MIN) * 100}%;"></div>`);
      }

      const dayCols = days.map((d) => {
        const iso = isoOf(d);
        const reqs = pendingShiftReqs.filter((r) => r.date === iso);
        const items = reqs.map((r) => {
          const [dispStart, dispEnd] = displayRange(r.start_time, r.end_time);
          return { start: dispStart, end: Math.min(dispEnd, WINDOW_MIN), req: r };
        });
        const packed = packOverlaps(items);
        const bars = packed.map(({ start, end, col, cols, req: r }) => {
          const top = Math.max(0, (start / WINDOW_MIN) * 100);
          const height = Math.max(3, ((end - start) / WINDOW_MIN) * 100);
          const widthPct = 100 / cols;
          const leftPct = col * widthPct;
          const conflictNote = conflicts.get(r.id);
          return `
            <div class="req-bar${conflictNote ? ' flagged' : ''}" draggable="true"
                 data-kind="shift" data-id="${r.id}"
                 style="top:${top}%;height:${height}%;left:calc(${leftPct}% + 0.125rem);width:calc(${widthPct}% - 0.25rem);">
              <span class="who">${escapeHtml(userName(r.user_id))}${conflictNote ? ' ⚠' : ''}</span>
              <span class="when">${formatTime12(r.start_time)}–${formatTime12(r.end_time)}</span>
              ${conflictNote ? `<span class="flag-note">${escapeHtml(conflictNote)}</span>` : ''}
            </div>
          `;
        }).join('');
        return `<div class="cal-day-col" data-date="${iso}">${bars}</div>`;
      }).join('');

      root.innerHTML = `
        <div class="cal-grid cal-head">
          <div></div>
          ${headCells}
        </div>
        <div class="cal-timeoff-row">
          <div class="cal-timeoff-label">Time off</div>
          ${timeoffCells}
        </div>
        <div class="cal-body">
          <div class="cal-hours">${hourLabels.join('')}</div>
          ${dayCols}
        </div>
      `;

      wireInteractions(pendingShiftReqs, pendingTimeOff);
    }

    let contextTarget = null; // { kind, id }

    function closeContextMenu() {
      document.getElementById('context-menu').hidden = true;
      contextTarget = null;
    }

    function openContextMenu(x, y, kind, id) {
      contextTarget = { kind, id };
      const menu = document.getElementById('context-menu');
      menu.style.left = `${x}px`;
      menu.style.top = `${y}px`;
      menu.hidden = false;
    }

    function wireInteractions(pendingShiftReqs, pendingTimeOff) {
      const root = document.getElementById('calendar-root');

      root.querySelectorAll('[data-kind]').forEach((el) => {
        el.addEventListener('contextmenu', (e) => {
          e.preventDefault();
          openContextMenu(e.clientX, e.clientY, el.getAttribute('data-kind'), el.getAttribute('data-id'));
        });
      });

      root.querySelectorAll('.req-bar[draggable="true"]').forEach((el) => {
        el.addEventListener('dragstart', (e) => {
          e.dataTransfer.setData('text/plain', el.getAttribute('data-id'));
          e.dataTransfer.effectAllowed = 'move';
        });
      });

      root.querySelectorAll('.cal-day-col').forEach((col) => {
        col.addEventListener('dragover', (e) => {
          e.preventDefault();
          col.classList.add('drag-over');
        });
        col.addEventListener('dragleave', () => col.classList.remove('drag-over'));
        col.addEventListener('drop', async (e) => {
          e.preventDefault();
          col.classList.remove('drag-over');
          const reqId = e.dataTransfer.getData('text/plain');
          const targetDate = col.getAttribute('data-date');
          const req = pendingShiftReqs.find((r) => r.id === reqId);
          if (!req || req.date === targetDate) return;
          const r = await window.shawarmaApi('PATCH', `/api/shift-requests/${reqId}`, { date: targetDate });
          if (!r.ok) { window.shawarmaToast(r.error || 'Could not move request'); return; }
          window.shawarmaToast(`Moved to ${targetDate} — still pending`);
          await refreshAndRender();
        });
      });
    }

    document.getElementById('context-menu').addEventListener('click', async (e) => {
      const action = e.target.getAttribute('data-action');
      if (!action || !contextTarget) return;
      const { kind, id } = contextTarget;
      closeContextMenu();

      if (action === 'deny') {
        const reason = prompt('Why are you denying this request? (shown to the staff member)');
        if (reason === null) return;
        const url = kind === 'timeoff' ? `/api/timeoff/${id}` : `/api/shift-requests/${id}`;
        const r = await window.shawarmaApi('PATCH', url, { status: 'denied', denial_reason: reason || 'No reason given' });
        window.shawarmaToast(r.ok ? 'Denied' : (r.error || 'Failed'));
        await refreshAndRender();
        return;
      }

      const url = kind === 'timeoff' ? `/api/timeoff/${id}` : `/api/shift-requests/${id}`;
      const r = await window.shawarmaApi('PATCH', url, { status: 'approved' });
      window.shawarmaToast(r.ok ? 'Approved' : (r.error || 'Failed'));
      await refreshAndRender();
    });
    document.addEventListener('click', (e) => {
      if (!e.target.closest('#context-menu')) closeContextMenu();
    });

    document.getElementById('prev-week').addEventListener('click', () => {
      weekStart.setDate(weekStart.getDate() - 7);
      render();
    });
    document.getElementById('next-week').addEventListener('click', () => {
      weekStart.setDate(weekStart.getDate() + 7);
      render();
    });

    async function refreshAndRender() {
      await loadState();
      render();
    }

    weekStart = startOfWeek(new Date());
    refreshAndRender();
  </script>
</AdminLayout>
