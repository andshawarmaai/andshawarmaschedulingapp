# Neon Postgres connection string. Leave unset for local dev and the app
# runs against a local JSON file instead (db/.local-data.json) — see
# src/lib/db/index.js.
DATABASE_URL=

# Secret used to sign session cookies. Required in production (the app
# throws on boot without it). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
