# Neon Postgres connection string. Leave unset for local dev and the app
# runs against a local JSON file instead (db/.local-data.json) — see
# src/lib/db/index.js.
DATABASE_URL=

# Secret used to sign session cookies. Required in production (the app
# throws on boot without it). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional: lets admins talk to their Telegram bot in plain English instead
# of /shift, /cap, /swap commands (see src/lib/llm/index.js). Leave both
# unset and the bot still works, command-only. Pick ONE provider:
#   LLM_PROVIDER=anthropic   + ANTHROPIC_API_KEY=sk-ant-...
#   LLM_PROVIDER=openai      + OPENAI_API_KEY=sk-...
# LLM_MODEL optionally overrides that provider's default model.
LLM_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=
